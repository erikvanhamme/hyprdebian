#!/bin/sh
# ssh to the HyprDebian test system, which gets a new host key with every installation. Logs in
# with the key of the user, or else with the password in test.json next to this script. A tool of
# the test vm, see .claude/skills/hyprdebian-test-vm.
here="$(dirname "$(readlink -f "$0")")"
SSH_ASKPASS="${here}/askpass-test" SSH_ASKPASS_REQUIRE=force exec ssh \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR test "$@"
