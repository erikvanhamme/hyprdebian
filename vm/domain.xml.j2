<!-- The libvirt domain of a HyprDebian vm, rendered by provision-vm.py. UEFI with secure boot
     enabled and no keys enrolled, so the firmware starts in setup mode; libvirt picks the firmware
     and makes the nvram, the uuid and the MAC address. It boots from the zvol, and from the live
     ISO while the zvol is still empty. The virtio gpu has 3D acceleration (virgl on
     virtio-vga-gl; libvirt keeps a virtio device it once picked, so it is named here), which
     programs that draw with the GPU, such as hyprpaper, need. qemu renders it with egl-headless
     on the GPU that shows the console, as frames handed from one GPU to another come out
     scrambled, and hands spice plain frames: spice with OpenGL stalls the virtio gpu until the
     client has drawn each frame. It has no serial console, as a console on a serial port keeps
     the boot splash from showing. -->
<domain type='kvm'>
  <name>{{ name }}</name>
  <memory unit='GiB'>{{ memory }}</memory>
  <vcpu placement='static'>{{ cpus }}</vcpu>
  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
    <firmware>
      <feature enabled='yes' name='secure-boot'/>
      <feature enabled='no' name='enrolled-keys'/>
    </firmware>
    <loader secure='yes'/>
    <bootmenu enable='yes'/>
  </os>
  <features>
    <acpi/>
    <apic/>
    <vmport state='off'/>
    <smm state='on'/>
  </features>
  <cpu mode='host-passthrough' check='none' migratable='on'/>
  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type='block' device='disk'>
      <driver name='qemu' type='raw' cache='none' io='native' discard='unmap'/>
      <source dev='{{ disk }}'/>
      <target dev='vda' bus='virtio'/>
      <serial>vmdk-{{ name }}</serial>
      <boot order='1'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='{{ iso }}'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
      <boot order='2'/>
    </disk>
    <controller type='usb' model='qemu-xhci' ports='15'/>
    <interface type='bridge'>
      <source bridge='{{ bridge }}'/>
      <model type='virtio'/>
    </interface>
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>
    <channel type='spicevmc'>
      <target type='virtio' name='com.redhat.spice.0'/>
    </channel>
    <input type='tablet' bus='usb'/>
    <graphics type='spice' autoport='yes'>
      <listen type='address'/>
      <image compression='off'/>
    </graphics>
    <graphics type='egl-headless'>
      <gl rendernode='{{ rendernode }}'/>
    </graphics>
    <video>
      <model type='virtio' heads='1' primary='yes' device='virtio-vga-gl'>
        <acceleration accel3d='yes'/>
      </model>
    </video>
    <watchdog model='itco' action='reset'/>
    <memballoon model='virtio'/>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
  </devices>
</domain>
