[Unit]
Description=Neuter Machine ID on Shutdown
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target umount.target
Requires=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/sh -c 'rm -f /etc/machine-id /var/lib/dbus/machine-id;'

[Install]
WantedBy=sysinit.target
