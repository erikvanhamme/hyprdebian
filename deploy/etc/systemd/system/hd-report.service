[Unit]
Description=Send a Status Report to the HyprDebian Dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hd-report
User=root
Group=root
Nice=10
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
