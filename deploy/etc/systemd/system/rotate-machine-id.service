[Unit]
Description=Rotate Machine ID on Shutdown

[Service]
Type=oneshot
RemainAfterExit=yes
# Nothing to do at boot; the unit stays "active" so ExecStop runs on shutdown,
# while the root filesystem is still mounted read-write.
ExecStart=/bin/true
ExecStop=/bin/sh -c '/usr/bin/dbus-uuidgen > /etc/machine-id'
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
