#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 ]]; then
    echo "Usage: $0 <vm_name> <backup_dir> <backup_owner>"
    echo "Example: $0 myvm /path/to/backup myuser"
    exit 1
fi

VM_NAME="$1"
BACKUP_DIR="$2/${VM_NAME}"
BACKUP_OWNER="$3"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
SNAP_NAME="backup-${TIMESTAMP}"
SEQ_FILE="${BACKUP_DIR}/${VM_NAME}.sequence"

# State for the cleanup when the backup does not finish.
FROZEN=0
FINISHED=0
CREATED_SNAPS=()
OUT_FILES=()

thaw_guest() {
    virsh qemu-agent-command "${VM_NAME}" '{"execute":"guest-fsfreeze-thaw"}' || true
}

# Never leaves the guest frozen. When the backup did not finish, the snapshots and stream files of
# this run are removed again, so the next run continues from the last backup that did finish.
cleanup() {
    if [[ ${FROZEN} -eq 1 ]]; then
        echo "Thawing guest filesystem..."
        thaw_guest
    fi

    if [[ ${FINISHED} -eq 0 ]]; then
        for snap in "${CREATED_SNAPS[@]}"; do
            zfs destroy "${snap}" || true
        done

        rm -f "${OUT_FILES[@]}"
    fi
}

trap cleanup EXIT
trap 'exit 1' INT TERM HUP

# Returns whether the backup folder holds streams of the dataset from before this run.
has_earlier_streams() {
    local clean_ds_name="$1"
    local file num

    for file in "${BACKUP_DIR}/${clean_ds_name}".[0-9][0-9][0-9][0-9].zst; do
        if [[ ! -e "${file}" ]]; then
            continue
        fi

        num="${file%.zst}"
        num="${num##*.}"

        if (( 10#${num} < NEXT_IDX )); then
            return 0
        fi
    done

    return 1
}

mkdir -p "${BACKUP_DIR}"

# 1. Dump XML configuration (Always replaced)
XML_PATH="${BACKUP_DIR}/${VM_NAME}.xml"
virsh dumpxml --migratable "${VM_NAME}" > "${XML_PATH}"

# 2. Extract NVRAM path if UEFI VM (Always replaced)
NVRAM_PATH=$(virsh dumpxml "${VM_NAME}" | xmllint --xpath "string(//os/nvram/text())" - 2>/dev/null || true)
if [[ -n "${NVRAM_PATH}" && -f "${NVRAM_PATH}" ]]; then
    cp "${NVRAM_PATH}" "${BACKUP_DIR}/${VM_NAME}_VARS.fd"
fi

# 3. Parse all block-type disk paths from XML. CD-ROM and floppy drives hold no VM data.
mapfile -t ZVOL_PATHS < <(xmllint --xpath "//devices/disk[@type='block' and (not(@device) or @device='disk')]/source/@dev" "${XML_PATH}" 2>/dev/null | grep -oP 'dev="\K[^"]+' || true)

if [[ ${#ZVOL_PATHS[@]} -eq 0 ]]; then
    echo "No block devices found for ${VM_NAME}."
    exit 1
fi

# Convert /dev/zvol/pool/dataset paths into ZFS dataset names. Other disks cannot be snapshotted,
# so they are refused before the guest is frozen.
ZFS_DATASETS=()
for dev in "${ZVOL_PATHS[@]}"; do
    if [[ "${dev}" != /dev/zvol/* ]]; then
        echo "Error: disk ${dev} of ${VM_NAME} is not a ZFS volume and cannot be backed up." >&2
        exit 1
    fi

    ZFS_DATASETS+=("${dev#/dev/zvol/}")
done

# Read the next sequence number and the snapshot the last backup ended at. Sequence files from
# before that snapshot was recorded only hold the number.
NEXT_IDX=0
BASE_SNAP=""
if [[ -f "${SEQ_FILE}" ]]; then
    read -r NEXT_IDX BASE_SNAP < "${SEQ_FILE}" || true
fi

SEQ_NUM=$(printf "%04d" "${NEXT_IDX}")

echo "Starting backup sequence #${SEQ_NUM} for ${VM_NAME}..."

# 4. Quiesce filesystem (Guest Agent)
echo "Freezing guest filesystem..."
FROZEN=1
virsh qemu-agent-command "${VM_NAME}" '{"execute":"guest-fsfreeze-freeze"}' --timeout 5 || echo "Warning: fsfreeze failed, taking crash-consistent snapshot."

# 5. Atomic snapshot creation for all discovered ZVOLs. ZFS only does that within one pool, so
# the snapshots are taken with one call per pool.
echo "Creating ZFS snapshot: ${SNAP_NAME}..."
declare -A POOL_SNAPS
for ds in "${ZFS_DATASETS[@]}"; do
    POOL_SNAPS["${ds%%/*}"]+="${ds}@${SNAP_NAME}"$'\n'
done

for pool in "${!POOL_SNAPS[@]}"; do
    mapfile -t snaps <<< "${POOL_SNAPS[${pool}]%$'\n'}"
    zfs snapshot "${snaps[@]}"
    CREATED_SNAPS+=("${snaps[@]}")
done

# 6. Thaw guest immediately
echo "Thawing guest filesystem..."
thaw_guest
FROZEN=0

# 7. Stream each ZVOL snapshot (Full vs Incremental)
for ds in "${ZFS_DATASETS[@]}"; do
    clean_ds_name=$(echo "${ds}" | tr '/' '_')
    OUT_FILE="${BACKUP_DIR}/${clean_ds_name}.${SEQ_NUM}.zst"
    OUT_FILES+=("${OUT_FILE}")

    # A dataset without earlier streams starts with a full backup, e.g. a disk added to the VM.
    if ! has_earlier_streams "${clean_ds_name}"; then
        echo "Performing FULL backup (${SEQ_NUM}) for ${ds}@${SNAP_NAME} -> ${OUT_FILE}"
        zfs send "${ds}@${SNAP_NAME}" | zstd -T0 > "${OUT_FILE}"
        continue
    fi

    # Older sequence files do not record the base, then it is the newest earlier backup snapshot.
    PREV_SNAP="${BASE_SNAP}"
    if [[ -z "${PREV_SNAP}" ]]; then
        PREV_SNAP=$(zfs list -H -t snapshot -o name -s creation "${ds}" | grep "@backup-" | grep -v "@${SNAP_NAME}" | tail -n 1 | cut -d'@' -f2 || true)
    fi

    if [[ -z "${PREV_SNAP}" ]] || ! zfs list -H -o name "${ds}@${PREV_SNAP}" >/dev/null 2>&1; then
        echo "Error: the base snapshot of ${ds} is gone, so the backups in ${BACKUP_DIR} cannot be continued." >&2
        echo "Move that folder away to start a new backup with a full stream." >&2
        exit 1
    fi

    echo "Performing INCREMENTAL backup (${SEQ_NUM}) from @${PREV_SNAP} to @${SNAP_NAME} -> ${OUT_FILE}"
    zfs send -i "@${PREV_SNAP}" "${ds}@${SNAP_NAME}" | zstd -T0 > "${OUT_FILE}"
done

# 8. Record the next sequence number and the new base snapshot in one step, so they always match.
TMP_SEQ=$(mktemp "${SEQ_FILE}.XXXXXX")
echo "$((NEXT_IDX + 1)) ${SNAP_NAME}" > "${TMP_SEQ}"
mv "${TMP_SEQ}" "${SEQ_FILE}"
FINISHED=1

# 9. The current snapshot is the new base; the older backup snapshots are not needed anymore.
for ds in "${ZFS_DATASETS[@]}"; do
    mapfile -t OLD_SNAPS < <(zfs list -H -t snapshot -o name "${ds}" | grep -F "@backup-" | grep -vxF "${ds}@${SNAP_NAME}" || true)

    for snap in "${OLD_SNAPS[@]}"; do
        zfs destroy "${snap}" || true
    done
done

# 10. Change ownership of all backed up files including state file
chown -R "${BACKUP_OWNER}" "${BACKUP_DIR}"

echo "Backup #${SEQ_NUM} complete for ${VM_NAME}."
