try:
    # Global versions.
    tool_version = 10
    db_version_expected = 8
    db = None

    # Initialize colorama for better console output.
    colorama.init(autoreset=True)

    # Display startup banner.
    printc(f"Backuptool [tool V{tool_version}, database V{db_version_expected}]", Fore.CYAN)
    printc("  Copyright 2018-2026 Erik Van Hamme (erik.vanhamme@gmail.com)", Fore.CYAN)

    # Load JSON describing the commands.
    config = json.loads(commands_json)

    # Set up the main parser.
    usage_text = generate_usage_text(config)
    parser = argparse.ArgumentParser(description="Backup Management CLI", usage=usage_text)
    subparsers = parser.add_subparsers(dest="command", required=True)

    # Build each command from the JSON.
    for cmd in config['commands']:
        subparser = subparsers.add_parser(cmd['name'], help=cmd['desc'])

        for arg in cmd['args']:
            arg_name = arg['name']
            arg_desc = arg['desc']
            arg_type = eval(arg['type'])  # Typically safe if only str/int/float
            arg_n = arg['n']
            # subparser.add_argument(arg_name, help=arg_desc, type=arg_type, nargs=arg_n)
            if arg_n == 1:
                subparser.add_argument(arg_name, help=arg_desc, type=arg_type)
            else:
                subparser.add_argument(arg_name, help=arg_desc, type=arg_type, nargs=arg_n)

    # Parse command line.
    args = parser.parse_args()
    cmd = args.command

    # Create database connection.
    db_path = os.path.expanduser('~/.local/share/hyprdebian/hd-backup.db')
    os.makedirs(os.path.dirname(db_path), exist_ok=True)
    db = sqlite3.connect(db_path)

    # Check if there is a version table in the db.
    version = get_first_value(db, '''
        SELECT COUNT(*) 
        FROM sqlite_master 
        WHERE type="table" 
            AND name="version"
    ''')

    if version == 0:
        # No version table. Blank DB. Initialize it.
        create_db(db, db_version_expected)
        printc('New database created.', Fore.YELLOW)
    else:
        # Check db version
        db_version = get_first_value(db, '''
            SELECT version 
            FROM version
        ''')

        if db_version != db_version_expected:
            printc('Incompatible database version', Fore.RED)
            sys.exit(1)

    # Try to find the global method to be called, corresponding to the command supplied on the command line.
    try:
        func = globals()[cmd.replace('-', '_')]
    except KeyError:
        printc(f"BUG: Command '{cmd.replace('-', '_')}' is not implemented.", Fore.RED)
        sys.exit(1)

    # Extract arguments to pass to the function.
    cmd_config = next(c for c in config['commands'] if c['name'] == cmd)
    arg_values = [getattr(args, arg['name']) for arg in cmd_config['args']]

    # Call the function with db and extracted arguments.
    func(db, *arg_values)

    # A command that reported an error, but went on with the rest of its work, still fails.
    if had_errors:
        sys.exit(1)

except sqlite3.Error as e:
    printc(f"SQL exception: {str(e)}", Fore.RED)
    sys.exit(1)
finally:
    if db is not None:
        db.close()
