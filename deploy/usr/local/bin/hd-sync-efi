#!/usr/bin/env bash
set -euo pipefail

# Configuration
PRIMARY_ESP="/boot/efi"
SECONDARY_ESP="/boot/efi2"

# Ensure script is run as root
if [[ $EUID -ne 0 ]]; then
   echo "[ERROR] This script must be run as root." >&2
   exit 1
fi

# Verify primary ESP is mounted
if ! mountpoint -q "$PRIMARY_ESP"; then
    echo "[ERROR] Primary ESP ($PRIMARY_ESP) is not mounted! Aborting sync." >&2
    exit 1
fi

# Verify secondary ESP is mounted
if ! mountpoint -q "$SECONDARY_ESP"; then
    echo "[ERROR] Secondary ESP ($SECONDARY_ESP) is not mounted! Aborting sync." >&2
    exit 1
fi

# Perform file synchronization
echo "[INFO] Synchronizing $PRIMARY_ESP -> $SECONDARY_ESP..."
rsync -rtv --delete --checksum --no-whole-file "$PRIMARY_ESP/" "$SECONDARY_ESP/"

# Flush filesystem buffers to disk
sync

echo "[SUCCESS] EFI partitions synchronized successfully."
