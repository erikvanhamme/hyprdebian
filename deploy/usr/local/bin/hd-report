#!/usr/bin/python3

# Sends the state of this system to the hyprdebian dashboard. hd-report.timer runs it as root.
# The system only makes outgoing connections: it POSTs a JSON report to the URL in
# /etc/hyprdebian/report.conf, with the token of this system.
#
#   hd-report           collects and sends a report
#   hd-report --print   only prints the report, without sending it

import glob
import gzip
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

REPORT_CONFIG = "/etc/hyprdebian/report.conf"
INSTALLER_CONFIG = "/etc/hyprdebian/installer.config"
APT_HISTORY = "/var/log/apt/history.log"
APT_LISTS = "/var/lib/apt/lists"
ROOT_DATASET = "rpool/hyprdebian"
TIMER_DIR = "/etc/systemd/system"

# The layout of the report. The dashboard refuses reports with a newer format than it knows.
FORMAT = 1

# apt commands that upgrade the system, as they show up on the Commandline of the apt history.
UPGRADE_COMMAND = re.compile(r"\b(upgrade|full-upgrade|dist-upgrade)\b")


def run(*args, check=True):
    """Runs a command and returns its output, or None when it cannot run, or fails with check."""
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None

    if check and result.returncode != 0:
        return None

    return result.stdout


def read_file(path):
    """Returns the content of a file, or None when it cannot be read."""
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def parse_config(text):
    """Parses KEY=value lines, with the value quoted like bash quotes it (printf %q)."""
    config = {}

    for line in (text or "").splitlines():
        match = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
        if not match:
            continue

        try:
            words = shlex.split(match.group(2))
        except ValueError:
            continue

        config[match.group(1)] = words[0] if words else ""

    return config


def parse_meminfo(text):
    """Returns the memory and swap in use and in total, in bytes."""
    values = {}

    for line in (text or "").splitlines():
        match = re.match(r"^(\w+):\s+(\d+) kB", line)
        if match:
            values[match.group(1)] = int(match.group(2)) * 1024

    memory = {
        "total": values.get("MemTotal", 0),
        "used": values.get("MemTotal", 0) - values.get("MemAvailable", 0),
    }
    swap = {
        "total": values.get("SwapTotal", 0),
        "used": values.get("SwapTotal", 0) - values.get("SwapFree", 0),
    }

    return memory, swap


def parse_pools(listing, status):
    """Combines `zpool list -Hp` with the scan lines of `zpool status`."""
    scans = {}
    pool = None

    for line in (status or "").splitlines():
        line = line.strip()

        if line.startswith("pool:"):
            pool = line[5:].strip()
        elif line.startswith("scan:") and pool:
            scans[pool] = line[5:].strip()

    pools = []

    for line in (listing or "").splitlines():
        fields = line.split("\t")
        if len(fields) != 5:
            continue

        name, health, size, alloc, capacity = fields
        pools.append({
            "name": name,
            "health": health,
            "size": int(size),
            "alloc": int(alloc),
            "capacity": int(capacity.rstrip("%")),
            "scan": scans.get(name, ""),
        })

    return pools


def collect_arrays(sys_block="/sys/block", dev_md="/dev/md"):
    """Returns the mdadm arrays, like the swap array on systems with redundant drives."""
    names = {}
    for link in glob.glob(os.path.join(dev_md, "*")):
        names[os.path.basename(os.path.realpath(link))] = os.path.basename(link)

    arrays = []

    for md in sorted(glob.glob(os.path.join(sys_block, "md*"))):
        if not os.path.isdir(os.path.join(md, "md")):
            continue

        device = os.path.basename(md)
        degraded = (read_file(os.path.join(md, "md", "degraded")) or "0").strip()
        state = (read_file(os.path.join(md, "md", "array_state")) or "unknown").strip()

        arrays.append({
            "name": names.get(device, device),
            "state": state,
            "degraded": int(degraded) if degraded.isdigit() else 0,
        })

    return arrays


def parse_failed_units(text):
    """Returns the names of the units in `systemctl list-units --failed --plain --no-legend`."""
    return [line.split()[0] for line in (text or "").splitlines() if line.strip()]


def parse_history(text, upgrades_only):
    """Returns the time of the last apt run in an apt history log, or the last upgrade."""
    last = None
    command = ""

    for line in (text or "").splitlines():
        if line.startswith("Commandline:"):
            command = line[12:]
        elif line.startswith("End-Date:"):
            if upgrades_only and not UPGRADE_COMMAND.search(command):
                continue

            try:
                last = int(time.mktime(time.strptime(" ".join(line[9:].split()), "%Y-%m-%d %H:%M:%S")))
            except ValueError:
                pass

    return last


def rotation(name):
    """Returns the number of a rotated log, like 2 for history.log.2.gz."""
    match = re.search(r"\.(\d+)\.gz$", name)

    return int(match.group(1)) if match else 0


def read_history(path):
    """Returns the apt history logs, the newest first: the log itself, then the rotated ones."""
    logs = [read_file(path)]

    for name in sorted(glob.glob(path + ".*.gz"), key=rotation):
        try:
            with gzip.open(name, "rt") as f:
                logs.append(f.read())
        except OSError:
            pass

    return logs


def last_in_history(logs, upgrades_only):
    for text in logs:
        last = parse_history(text, upgrades_only)
        if last is not None:
            return last

    return None


def count_upgradable():
    """Counts the packages `apt full-upgrade` would upgrade, from the package lists apt has now.
    The lists are not updated: that is left to apt update and hd-up."""
    output = run("apt-get", "-s", "-o", "Debug::NoLocking=1", "full-upgrade")
    if output is None:
        return None

    return sum(1 for line in output.splitlines() if line.startswith("Inst "))


def lists_time(path=APT_LISTS):
    """Returns when apt last updated its package lists."""
    newest = None

    for name in glob.glob(os.path.join(path, "*_InRelease")) + glob.glob(os.path.join(path, "*_Release")):
        mtime = int(os.path.getmtime(name))
        if newest is None or mtime > newest:
            newest = mtime

    return newest


def version_key(version):
    return [int(part) if part.isdigit() else part for part in re.split(r"[.+~-]", version)]


def newest_kernel(boot="/boot"):
    """Returns the newest installed kernel, so the dashboard can tell a reboot is due."""
    versions = [os.path.basename(name)[len("vmlinuz-"):] for name in glob.glob(os.path.join(boot, "vmlinuz-*"))]

    if not versions:
        return None

    return max(versions, key=version_key)


def parse_snapshots(text):
    """Returns the newest snapshot taken by hd-up or upgrade.sh, from `zfs list -Hp -o name,creation`."""
    newest = None

    for line in (text or "").splitlines():
        fields = line.split("\t")
        if len(fields) != 2:
            continue

        name, creation = fields
        snapshot = name.split("@", 1)[-1]
        if not snapshot.startswith(("hd-up-", "upgrade-")):
            continue

        if newest is None or int(creation) > newest["time"]:
            newest = {"name": snapshot, "time": int(creation)}

    return newest


def parse_properties(text):
    """Parses the KEY=value lines of `systemctl show`."""
    properties = {}

    for line in (text or "").splitlines():
        key, _, value = line.partition("=")
        properties[key] = value

    return properties


def unix_time(value):
    """Converts a timestamp of `systemctl show --timestamp=unix` (@1792114200) to a number."""
    if value and value.startswith("@"):
        return int(value[1:])

    return None


def collect_timers(timer_dir=TIMER_DIR):
    """Returns the timers hyprdebian deploys in /etc/systemd/system, with the result of the last run
    of their service."""
    timers = []

    for path in sorted(glob.glob(os.path.join(timer_dir, "*.timer"))):
        timer = os.path.basename(path)
        properties = parse_properties(run(
            "systemctl", "show", "--timestamp=unix", timer,
            "-p", "UnitFileState,Triggers,LastTriggerUSec,NextElapseUSecRealtime"))

        if properties.get("UnitFileState") != "enabled":
            continue

        service = properties.get("Triggers", "").split(" ")[0]
        result = parse_properties(run("systemctl", "show", "--timestamp=unix", service,
                                      "-p", "Result,ExecMainStatus,ActiveState"))

        timers.append({
            "unit": timer,
            "service": service,
            "last": unix_time(properties.get("LastTriggerUSec")),
            "next": unix_time(properties.get("NextElapseUSecRealtime")),
            "result": result.get("Result", ""),
            "state": result.get("ActiveState", ""),
        })

    return timers


def collect():
    """Collects the report."""
    installer = parse_config(read_file(INSTALLER_CONFIG))
    memory, swap = parse_meminfo(read_file("/proc/meminfo"))
    uptime = float((read_file("/proc/uptime") or "0").split()[0])
    history = read_history(APT_HISTORY)

    zpool_list = run("zpool", "list", "-Hp", "-o", "name,health,size,alloc,capacity")
    zpool_status = run("zpool", "status")
    snapshots = run("zfs", "list", "-Hp", "-t", "snapshot", "-o", "name,creation", "-d", "1", ROOT_DATASET)
    # is-system-running fails when the state is not running, but still prints the state.
    system_state = run("systemctl", "is-system-running", check=False) or ""

    return {
        "format": FORMAT,
        "host": socket.gethostname(),
        "fqdn": installer.get("Q_FQDN", ""),
        "sent_at": int(time.time()),
        "hyprdebian": {
            "version": installer.get("INSTALLED_VERSION", ""),
            "type": installer.get("Q_TYPE", ""),
            "suite": installer.get("Q_SUITE", ""),
        },
        "os": {
            "debian": (read_file("/etc/debian_version") or "").strip(),
            "kernel": os.uname().release,
            "kernel_newest": newest_kernel(),
            "boot_time": int(time.time() - uptime),
        },
        "load": [float(value) for value in (read_file("/proc/loadavg") or "0 0 0").split()[:3]],
        "cpus": os.cpu_count(),
        "memory": memory,
        "swap": swap,
        "pools": parse_pools(zpool_list, zpool_status),
        "arrays": collect_arrays(),
        "units": {
            "state": system_state.strip(),
            "failed": parse_failed_units(run("systemctl", "list-units", "--failed", "--plain", "--no-legend")),
        },
        "updates": {
            "upgradable": count_upgradable(),
            "lists_time": lists_time(),
            "last_apt": last_in_history(history, upgrades_only=False),
            "last_upgrade": last_in_history(history, upgrades_only=True),
            "reboot_required": os.path.exists("/run/reboot-required"),
        },
        "snapshot": parse_snapshots(snapshots),
        "timers": collect_timers(),
    }


def send(report, url, token):
    """POSTs the report to the dashboard."""
    request = urllib.request.Request(
        url.rstrip("/") + "/report",
        data=json.dumps(report).encode(),
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + token},
        method="POST")

    with urllib.request.urlopen(request, timeout=30) as response:
        response.read()


def main(argv):
    report = collect()

    if "--print" in argv:
        print(json.dumps(report, indent=2))
        return 0

    config = parse_config(read_file(REPORT_CONFIG))
    url = config.get("REPORT_URL", "")
    token = config.get("REPORT_TOKEN", "")

    if not url or not token:
        print(f"ERROR: {REPORT_CONFIG} needs REPORT_URL and REPORT_TOKEN.", file=sys.stderr)
        return 1

    try:
        send(report, url, token)
    except urllib.error.HTTPError as error:
        print(f"ERROR: The dashboard at {url} refused the report: {error.code} {error.reason}", file=sys.stderr)
        return 1
    except (urllib.error.URLError, OSError) as error:
        print(f"ERROR: Unable to reach the dashboard at {url}: {error}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
