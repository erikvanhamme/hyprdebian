def esc(value):
    return html.escape("" if value is None else str(value))


def size(value):
    value = number(value)
    if value is None:
        return "?"

    for unit in ["B", "KiB", "MiB", "GiB", "TiB"]:
        if value < 1024 or unit == "TiB":
            return f"{value:.0f} {unit}" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1024


def when(timestamp, now):
    """A time as how long ago, with the date in the tooltip."""
    timestamp = number(timestamp)
    if timestamp is None:
        return '<span class="dim">never</span>'

    stamp = datetime.datetime.fromtimestamp(timestamp).strftime("%Y-%m-%d %H:%M")
    if timestamp > now:
        return f'<span title="{stamp}">in {age(timestamp - now)}</span>'

    return f'<span title="{stamp}">{age(now - timestamp)} ago</span>'


def bar(percent):
    percent = number(percent)
    if percent is None:
        return ""

    level = "bad" if percent >= POOL_BAD else "warn" if percent >= POOL_WARN else ""
    return f'<span class="bar {level}"><span style="width:{min(100, max(0, percent)):.0f}%"></span></span>'


def polyline(points, start, end, top, width, height):
    """Maps (time, value) points to the coordinates of an SVG polyline."""
    span = max(1, end - start)
    top = top or 1
    return " ".join(f"{(t - start) / span * width:.1f},{height - min(v, top) / top * height:.1f}"
                    for t, v in points if v is not None)


def sparkline(rows, column, now, top=None):
    points = [(row["time"], row[column]) for row in rows]
    values = [v for _, v in points if v is not None]
    if len(values) < 2:
        return ""

    top = top or max(1, max(values))
    return (f'<svg class="spark" width="80" height="18" viewBox="0 0 80 18">'
            f'<polyline points="{polyline(points, now - 86400, now, top, 80, 18)}"/></svg>')


def chart(rows, column, now, days, top, label):
    points = [(row["time"], row[column]) for row in rows]
    values = [v for _, v in points if v is not None]
    top = top or max([1] + values)
    grid = "".join(f'<line x1="{x}" y1="0" x2="{x}" y2="100"/>' for x in range(0, 1000, max(1, round(1000 / days))))

    return (f'<h2>{esc(label)} <span class="dim">· {days} days, top {top:g}</span></h2>'
            f'<svg class="chart" viewBox="0 0 1000 100" preserveAspectRatio="none">{grid}'
            f'<polyline points="{polyline(points, now - days * 86400, now, top, 1000, 100)}"/></svg>')


def page(title, body, refresh=True):
    meta = '<meta http-equiv="refresh" content="60">' if refresh else ""
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
            f'<meta name="viewport" content="width=device-width, initial-scale=1">{meta}'
            f'<title>{esc(title)}</title><style>{STYLE}</style></head><body>{body}</body></html>')


def host_rows(host, history, now):
    """The rows of the table of a host, on the overview and on its own page."""
    report = host["report"]
    hd = report.get("hyprdebian") or {}
    system = report.get("os") or {}
    memory = report.get("memory") or {}
    updates = report.get("updates") or {}
    units = report.get("units") or {}
    load = report.get("load") or []

    rows = [
        ("Seen", when(host["last_seen"], now) + f' <span class="dim">from {esc(host["address"])}</span>'),
        ("Version", f'{esc(hd.get("version") or "?")} <span class="dim">· {esc(hd.get("suite"))} · Debian {esc(system.get("debian"))}</span>'),
        ("Kernel", esc(system.get("kernel"))),
        ("Up", when(system.get("boot_time"), now).replace(" ago", "")),
        ("Secure Boot", f'<span class="{"ok" if system.get("secure_boot") == "on" else "bad"}">'
                        f'{esc(system.get("secure_boot") or "?")}</span>'),
        ("Load", f'{sparkline(history, "load", now)} ' + esc(" ".join(f"{v:.2f}" for v in load if number(v) is not None)) +
                 f' <span class="dim">· {esc(report.get("cpus"))} CPUs</span>'),
    ]

    if number(memory.get("total")):
        percent = 100 * (memory.get("used") or 0) / memory["total"]
        rows.append(("Memory", f'{bar(percent)}{size(memory.get("used"))} of {size(memory.get("total"))}'))

    for pool in report.get("pools") or []:
        health = pool.get("health")
        rows.append(("Pool", f'{bar(pool.get("capacity"))}{esc(pool.get("name"))} '
                             f'<span class="{"ok" if health == "ONLINE" else "bad"}">{esc(health)}</span> '
                             f'<span class="dim">{esc(pool.get("capacity"))}% of {size(pool.get("size"))}</span>'))

    for array in report.get("arrays") or []:
        state = "degraded" if array.get("degraded") else array.get("state")
        rows.append(("Array", f'{esc(array.get("name"))} <span class="{"bad" if array.get("degraded") else "ok"}">{esc(state)}</span>'))

    failed = units.get("failed") or []
    if failed:
        rows.append(("Units", f'<span class="bad">{len(failed)} failed:</span> {esc(", ".join(map(str, failed)))}'))
    else:
        rows.append(("Units", f'<span class="ok">{esc(units.get("state") or "?")}</span>'))

    upgradable = updates.get("upgradable")
    rows.append(("Upgraded", when(updates.get("last_upgrade"), now) +
                 (f' <span class="dim">· {esc(upgradable)} upgradable, lists {when(updates.get("lists_time"), now)}</span>'
                  if upgradable is not None else "")))

    snapshot = report.get("snapshot")
    if isinstance(snapshot, dict):
        rows.append(("Snapshot", f'{esc(snapshot.get("name"))} <span class="dim">{when(snapshot.get("time"), now)}</span>'))

    for timer in report.get("timers") or []:
        result = timer.get("result") or "?"
        rows.append((esc(str(timer.get("unit", "")).removesuffix(".timer")),
                     f'<span class="{"ok" if result == "success" else "bad"}">{esc(result)}</span> '
                     f'<span class="dim">last {when(timer.get("last"), now)}, next {when(timer.get("next"), now)}</span>'))

    return "".join(f"<tr><td>{label}</td><td>{value}</td></tr>" for label, value in rows)


def issue_list(issues):
    if not issues:
        return '<ul class="issues"><li class="ok">All good</li></ul>'

    return '<ul class="issues">' + "".join(f'<li class="{level}">{esc(message)}</li>' for level, message in issues) + "</ul>"


def overview_page(db, now, stale_minutes, offline_days):
    hosts = load_hosts(db, now, stale_minutes, offline_days)
    counts = {level: sum(1 for host in hosts if host["level"] == level) for level in LEVELS}

    cards = []
    for host in hosts:
        fqdn = host["report"].get("fqdn")
        history = load_history(db, host["name"], now - 86400)
        cards.append(
            f'<div class="card level-{host["level"]}"><div class="title">'
            f'<h2><a href="/host/{urllib.parse.quote(host["name"])}">{esc(host["name"])}</a></h2>'
            f'<span class="dim">{esc(fqdn)}</span></div>'
            f'{issue_list(host["issues"])}<table>{host_rows(host, history, now)}</table></div>')

    summary = " · ".join(f'<span class="{level}">{counts[level]} {label}</span>'
                         for level, label in [("bad", "failing"), ("warn", "warnings"), ("ok", "good")]
                         if counts[level] or level == "ok")

    body = (f'<header><h1>HyprDebian</h1><span>{len(hosts)} hosts · {summary}</span>'
            f'<span class="dim">{datetime.datetime.fromtimestamp(now).strftime("%Y-%m-%d %H:%M")}</span></header>')

    if not hosts:
        body += '<p class="dim">No reports yet. Systems report every 15 minutes.</p>'

    return page("HyprDebian Dashboard", body + f'<div class="grid">{"".join(cards)}</div>')


def host_page(db, name, now, stale_minutes, offline_days, history_days):
    hosts = [host for host in load_hosts(db, now, stale_minutes, offline_days) if host["name"] == name]
    if not hosts:
        return None

    host = hosts[0]
    history = load_history(db, name, now - history_days * 86400)
    day = [row for row in history if row["time"] >= now - 86400]

    body = (f'<header><h1><a href="/" style="text-decoration:none">HyprDebian</a></h1>'
            f'<h2>{esc(name)}</h2><span class="dim">{esc(host["report"].get("fqdn"))} · '
            f'reporting since {when(host["first_seen"], now)}</span></header>'
            f'<div class="card level-{host["level"]}">{issue_list(host["issues"])}<table>{host_rows(host, day, now)}</table></div>'
            f'<section>{chart(history, "load", now, history_days, None, "Load per CPU")}</section>'
            f'<section>{chart(history, "memory", now, history_days, 100, "Memory %")}</section>'
            f'<section>{chart(history, "pool", now, history_days, 100, "Fullest pool %")}</section>'
            f'<section><h2>Last report</h2><pre>{esc(json.dumps(host["report"], indent=2))}</pre></section>')

    return page(f"{name} · HyprDebian Dashboard", body)


# --- Server ------------------------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    server_version = "hd-dashboard"
    config = None
    database_path = DATABASE

    def respond(self, status, content_type, body):
        data = body.encode()
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def text(self, status, message):
        self.respond(status, "text/plain; charset=utf-8", message + "\n")

    def database(self):
        return connect(self.database_path)

    def do_POST(self):
        if self.path != "/report":
            return self.text(404, "not found")

        try:
            length = int(self.headers.get("Content-Length", ""))
        except ValueError:
            return self.text(411, "Content-Length needed")

        if length < 0 or length > MAX_REPORT_SIZE:
            return self.text(413, "report too large")

        body = self.rfile.read(length)
        db = self.database()
        try:
            host = accept_report(db, body, self.headers.get("Authorization"), self.client_address[0],
                                 int(time.time()), self.config["history_days"])
        except Refused as refused:
            self.log_message("refused report from %s: %s", self.client_address[0], refused)
            return self.text(refused.status, str(refused))
        finally:
            db.close()

        self.text(200, f"report of {host} stored")

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        now = int(time.time())
        stale = self.config["stale_minutes"]
        offline = self.config["offline_days"]

        db = self.database()
        try:
            if path == "/":
                return self.respond(200, "text/html; charset=utf-8", overview_page(db, now, stale, offline))

            if path == "/api/hosts":
                hosts = load_hosts(db, now, stale, offline)
                return self.respond(200, "application/json", json.dumps(hosts, indent=2))

            if path.startswith("/host/"):
                name = urllib.parse.unquote(path[6:])
                body = host_page(db, name, now, stale, offline, self.config["history_days"])
                if body is not None:
                    return self.respond(200, "text/html; charset=utf-8", body)
        finally:
            db.close()

        self.text(404, "not found")

    def log_message(self, format, *args):
        # Reports arrive every 15 minutes from every host. Only refusals and errors are worth a line
        # in the journal.
        if args and isinstance(args[0], str) and args[0].startswith(("POST /report", "GET ")):
            return

        sys.stderr.write("%s - %s\n" % (self.address_string(), format % args))


def serve(config, database):
    connect(database).close()

    Handler.config = config
    Handler.database_path = database
    server = ThreadingHTTPServer((config["listen"], config["port"]), Handler)
    print(f"hd-dashboard listening on {config['listen']}:{config['port']}, database {database}", flush=True)
    server.serve_forever()


def list_hosts(config, database):
    db = connect_existing(database)
    now = int(time.time())
    for host in load_hosts(db, now, config["stale_minutes"], config["offline_days"]):
        version = (host["report"].get("hyprdebian") or {}).get("version") or "?"
        print(f'{host["name"]:<24} {host["level"]:<5} {version:<8} {host["address"]:<16} seen {age(now - host["last_seen"])} ago')
    return 0


def forget(database, name):
    db = connect_existing(database)
    with db:
        removed = db.execute("DELETE FROM hosts WHERE name = ?", (name,)).rowcount
        db.execute("DELETE FROM history WHERE host = ?", (name,))

    if not removed:
        print(f"Error: Unknown host {name}.", file=sys.stderr)
        return 1

    print(f"Forgot {name}. Its next report registers its token again.")
    return 0


def main():
    parser = argparse.ArgumentParser(description="The hyprdebian dashboard, which shows the status "
                                     "reports of the hyprdebian systems.")
    parser.add_argument("--config", default=CONFIG_FILE,
                        help=f"the hyprdebian configuration, default {CONFIG_FILE}")
    parser.add_argument("--database", default=DATABASE, help=f"the database, default {DATABASE}")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("serve", help="run the dashboard, as hd-dashboard.service does")
    commands.add_parser("hosts", help="list the known hosts and when they last reported")
    forget_parser = commands.add_parser("forget", help="forget a host and its token")
    forget_parser.add_argument("host", help="the host name")
    args = parser.parse_args()

    try:
        config = load_config(args.config)
    except ConfigError as error:
        print(f"Error: {error}.", file=sys.stderr)
        return 1

    if args.command == "serve":
        serve(config, args.database)
        return 0

    if not os.path.exists(args.database):
        # /var/lib/private, where systemd keeps the state of the service, is only open to root.
        print(f"Error: Cannot find the database {args.database}. Run this as root; "
              "hd-dashboard.service makes the database on its first start.", file=sys.stderr)
        return 1

    if args.command == "hosts":
        return list_hosts(config, args.database)

    return forget(args.database, args.host)


if __name__ == "__main__":
    sys.exit(main())
