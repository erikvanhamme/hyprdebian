# The format of the jobs and their signatures, from hd-base, or from the repository when the
# dashboard runs from there.
sys.dont_write_bytecode = True
try:
    from hyprdebian import job
except ImportError:
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "hd-base", "lib"))
    from hyprdebian import job

CONFIG_FILE = "/etc/hyprdebian/config.json"
CONFIG_KEY = "hd-dashboard"
DEFAULTS_FILE = "/usr/share/hd-dashboard/defaults.json"
# The version of HyprDebian on the system of the dashboard, installed by hd-base. Hosts with an
# older version are outdated.
VERSION_FILE = "/etc/hyprdebian/version.json"
# The state directory of hd-dashboard.service.
DATABASE = "/var/lib/hd-dashboard/dashboard.db"

# The newest layout of a report this dashboard knows. Reports with a newer format are refused.
# Format 2, from hd-agent, adds the jobs; format 1 is that of hd-report.
FORMAT = 2

MAX_REPORT_SIZE = 256 * 1024
# The largest integer SQLite stores; a sequence number or time above it is refused.
MAX_INTEGER = 2 ** 63 - 1
HOST_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,62}$")
TOKEN = re.compile(r"^[A-Za-z0-9]{16,128}$")

# A system that was not upgraded for this long gets a warning.
UPGRADE_DAYS = 14

# Pools fuller than these get a warning and an error.
POOL_WARN = 80
POOL_BAD = 90

# What the states of Secure Boot in a report other than on mean, see hd-secboot --status.
SECURE_BOOT = {
    "off": "Secure Boot is off",
    "setup": "Secure Boot is off, firmware in setup mode",
    "unsupported": "Secure Boot is not supported by the firmware",
    "legacy": "Secure Boot is off, booted without UEFI",
}

# The parts that hd-harden hardens, see hd-harden --json, and the colors of their states. A part
# that is on shows its name alone, the others their state as well.
HARDENING_PARTS = ("ssh", "sysctl", "modules", "zfs", "ufw")
HARDENING = {"on": "ok", "changed": "warn", "off": "warn", "unknown": "dim"}

# The levels of the issues, from good to bad.
LEVELS = ["ok", "info", "warn", "bad"]

# The states of a job. The dashboard sets waiting, and expired for a waiting job whose expiry
# passed; the agent reports the others. The ended ones are kept for history_days.
REPORTED_STATES = ["scheduled", "ok", "failed", "expired", "cancelled"]
ENDED_STATES = ["ok", "failed", "expired", "cancelled"]
# The results that a report cannot change any more. An expired job can: the dashboard marks a
# waiting job expired on its own, while the agent may have fetched it before.
FINAL_STATES = ["ok", "failed", "cancelled"]
# The colors of the states of a job on the page of a host.
JOB_STATES = {"waiting": "info", "scheduled": "info", "ok": "ok", "failed": "bad", "expired": "warn",
              "cancelled": "dim"}

SCHEMA = """
CREATE TABLE IF NOT EXISTS hosts (
    name TEXT PRIMARY KEY,
    token TEXT NOT NULL,
    first_seen INTEGER NOT NULL,
    last_seen INTEGER NOT NULL,
    address TEXT NOT NULL,
    report TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS history (
    host TEXT NOT NULL,
    time INTEGER NOT NULL,
    load REAL,
    memory REAL,
    pool REAL
);
CREATE INDEX IF NOT EXISTS history_host_time ON history (host, time);
CREATE TABLE IF NOT EXISTS jobs (
    sequence INTEGER PRIMARY KEY,
    host TEXT NOT NULL,
    command TEXT NOT NULL,
    expires INTEGER NOT NULL,
    signed TEXT NOT NULL,
    state TEXT NOT NULL,
    started INTEGER,
    ended INTEGER,
    stored INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS jobs_host ON jobs (host);
-- The highest sequence number seen, in the jobs stored and in the reports. It stays when jobs are
-- removed, so it only goes up.
CREATE TABLE IF NOT EXISTS sequence (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    highest INTEGER NOT NULL
);
"""


class ConfigError(Exception):
    pass


def defaults_file():
    """The defaults of the package, or those next to this program when it runs from the
    repository."""
    if os.path.exists(DEFAULTS_FILE):
        return DEFAULTS_FILE
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), "defaults.json")


def parse_config(config, defaults):
    """Returns the settings: the key hd-dashboard of the configuration over the defaults. Raises
    ConfigError on a value of the wrong type."""
    settings = dict(defaults)

    if isinstance(config, dict) and config.get(CONFIG_KEY) is not None:
        if not isinstance(config[CONFIG_KEY], dict):
            raise ConfigError(f"the key {CONFIG_KEY} is not a JSON object")
        settings.update(config[CONFIG_KEY])

    if not isinstance(settings.get("listen"), str) or not settings["listen"]:
        raise ConfigError("listen is not an address")

    for key, low, high in [("port", 1, 65535), ("stale_minutes", 1, None), ("offline_days", 1, None),
                           ("history_days", 1, None)]:
        value = settings.get(key)
        if isinstance(value, bool) or not isinstance(value, int) or value < low or (high and value > high):
            raise ConfigError(f"{key} is not a whole number from {low}" + (f" to {high}" if high else " up"))

    # The parts of hd-harden that are not judged per host, such as {"beast": ["sysctl"]}.
    exceptions = settings.get("hardening_exceptions")
    if not isinstance(exceptions, dict):
        raise ConfigError("hardening_exceptions is not a JSON object")
    for host, parts in exceptions.items():
        if not HOST_NAME.match(host):
            raise ConfigError(f"hardening_exceptions has {host}, which is not a host name")
        if not isinstance(parts, list) or not all(part in HARDENING_PARTS for part in parts):
            raise ConfigError(f"hardening_exceptions of {host} is not a list of {', '.join(HARDENING_PARTS)}")

    # The public keys of the managers, which the jobs must be signed with.
    try:
        job.allowed_signers(settings.get("manager_keys"))
    except job.JobError as error:
        raise ConfigError(str(error))

    return settings


def load_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as error:
        raise ConfigError(f"cannot read {path}: {error}")


def load_config(path):
    defaults = load_json(defaults_file())
    if not isinstance(defaults, dict):
        raise ConfigError(f"no defaults in {defaults_file()}")

    return parse_config(load_json(path), defaults)


def hyprdebian_version(path=VERSION_FILE):
    """The version of HyprDebian on this system, <major>.<minor>, or None when it is unknown."""
    try:
        version = load_json(path)
        return f"{int(version['major'])}.{int(version['minor'])}"
    except (ConfigError, KeyError, TypeError, ValueError):
        return None


def connect(path):
    db = sqlite3.connect(path, timeout=10)
    db.row_factory = sqlite3.Row
    db.executescript(SCHEMA)
    return db


def connect_existing(path):
    """Opens the database without making it, so a command run as root before the first start of
    the service does not leave a database the service may not write."""
    db = sqlite3.connect(f"file:{urllib.parse.quote(path)}?mode=rw", uri=True, timeout=10)
    db.row_factory = sqlite3.Row
    db.executescript(SCHEMA)
    return db


def hash_token(token):
    return hashlib.sha256(token.encode()).hexdigest()


# --- Receiving reports ---------------------------------------------------------------------------

class Refused(Exception):
    """A report or a job that is not accepted, with the HTTP status to answer."""

    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


def number(value):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None

    return value


def metrics(report):
    """Returns the values of a report that are kept in the history: the load per CPU, and the
    memory and the fullest pool in percent."""
    load = None
    values = report.get("load")
    cpus = number(report.get("cpus")) or 1
    if isinstance(values, list) and values and number(values[0]) is not None:
        load = values[0] / cpus

    memory = None
    mem = report.get("memory")
    if isinstance(mem, dict) and number(mem.get("total")) and number(mem.get("used")) is not None:
        memory = 100 * mem["used"] / mem["total"]

    pool = None
    for entry in report.get("pools") or []:
        if isinstance(entry, dict) and number(entry.get("capacity")) is not None:
            pool = max(pool or 0, entry["capacity"])

    return load, memory, pool


def check_reported_jobs(jobs):
    """Checks the jobs of a report of format 2: each with its sequence number and state, and for
    an ended job its start and end time. Raises Refused when they are malformed."""
    if not isinstance(jobs, list):
        raise Refused(400, "the report has no list of jobs")

    for entry in jobs:
        if (not isinstance(entry, dict) or not job.is_integer(entry.get("sequence"))
                or not 1 <= entry["sequence"] <= MAX_INTEGER or entry.get("state") not in REPORTED_STATES):
            raise Refused(400, "a job of the report has no sequence number or state")
        for key in ("started", "ended"):
            if entry.get(key) is not None and (not job.is_integer(entry[key]) or abs(entry[key]) > MAX_INTEGER):
                raise Refused(400, f"{key} of job {entry['sequence']} of the report is not a time")


def record_sequence(db, sequence):
    db.execute("INSERT INTO sequence (id, highest) VALUES (1, ?) "
               "ON CONFLICT (id) DO UPDATE SET highest = max(highest, excluded.highest)", (sequence,))


def highest_sequence(db):
    """The highest sequence number seen, in the jobs and in the reports, or 0."""
    return db.execute("SELECT max(coalesce((SELECT highest FROM sequence), 0), "
                      "coalesce((SELECT max(sequence) FROM jobs), 0))").fetchone()[0]


def update_jobs(db, host, reported, now):
    """Takes the states of the jobs of a host from its report. A job of another host, an unknown
    one and one that has ended ok, failed or cancelled already are left alone; an ended job
    without an end time ends now. Every sequence number in the report counts as seen, so a new
    dashboard learns the highest from the agents."""
    for entry in reported:
        row = db.execute("SELECT state FROM jobs WHERE sequence = ? AND host = ?", (entry["sequence"], host)).fetchone()
        if row is None or row["state"] in FINAL_STATES:
            continue

        if entry["state"] == "scheduled":
            db.execute("UPDATE jobs SET state = 'scheduled' WHERE sequence = ?", (entry["sequence"],))
        else:
            ended = entry.get("ended")
            if ended is None:
                ended = now
            db.execute("UPDATE jobs SET state = ?, started = ?, ended = ? WHERE sequence = ?",
                       (entry["state"], entry.get("started"), ended, entry["sequence"]))

    if reported:
        record_sequence(db, max(entry["sequence"] for entry in reported))


def tidy_jobs(db, now, history_days):
    """Marks the waiting jobs whose expiry has passed as expired, as no agent will report them,
    and removes the jobs that ended more than history_days ago. Run it in a transaction."""
    db.execute("UPDATE jobs SET state = 'expired', ended = expires WHERE state = 'waiting' AND expires < ?", (now,))
    db.execute(f"DELETE FROM jobs WHERE state IN ({', '.join('?' * len(ENDED_STATES))}) AND ended < ?",
               ENDED_STATES + [now - history_days * 86400])


def reply_to(db, host):
    """The reply to a report: jobs, the waiting jobs of the host as they were signed, in order of
    sequence, and open, the sequence numbers of its jobs that have not ended."""
    rows = db.execute("SELECT sequence, signed, state FROM jobs WHERE host = ? AND state IN ('waiting', 'scheduled') "
                      "ORDER BY sequence", (host,)).fetchall()
    return {"jobs": [json.loads(row["signed"]) for row in rows if row["state"] == "waiting"],
            "open": [row["sequence"] for row in rows]}


def accept_report(db, body, authorization, address, now, history_days):
    """Checks a report and stores it, with the states of its jobs. Returns the reply, see
    reply_to. Raises Refused when it is refused."""
    match = re.match(r"^Bearer (\S+)$", authorization or "")
    if not match or not TOKEN.match(match.group(1)):
        raise Refused(401, "missing or malformed token")
    token = hash_token(match.group(1))

    try:
        report = json.loads(body)
    except (ValueError, UnicodeDecodeError):
        raise Refused(400, "the report is not JSON")

    if not isinstance(report, dict):
        raise Refused(400, "the report is not a JSON object")

    host = report.get("host")
    if not isinstance(host, str) or not HOST_NAME.match(host):
        raise Refused(400, "missing or malformed host name")

    if not isinstance(report.get("format"), int) or report["format"] > FORMAT:
        raise Refused(400, "unknown report format")

    # The reports of hd-report, format 1, have no jobs.
    reported = []
    if report["format"] >= 2:
        reported = report.get("jobs")
        check_reported_jobs(reported)

    with db:
        row = db.execute("SELECT token FROM hosts WHERE name = ?", (host,)).fetchone()

        if row is None:
            db.execute("INSERT INTO hosts (name, token, first_seen, last_seen, address, report) "
                       "VALUES (?, ?, ?, ?, ?, ?)", (host, token, now, now, address, body.decode()))
        elif row["token"] != token:
            raise Refused(403, f"{host} reports with a different token, see hd-dashboard forget")
        else:
            db.execute("UPDATE hosts SET last_seen = ?, address = ?, report = ? WHERE name = ?",
                       (now, address, body.decode(), host))

        db.execute("INSERT INTO history (host, time, load, memory, pool) VALUES (?, ?, ?, ?, ?)",
                   (host, now) + metrics(report))
        db.execute("DELETE FROM history WHERE time < ?", (now - history_days * 86400,))

        update_jobs(db, host, reported, now)
        tidy_jobs(db, now, history_days)
        return reply_to(db, host)


def accept_jobs(db, body, manager_keys, now):
    """Checks the signed jobs a manager sends, a JSON array, and stores them as waiting: all of
    them or none. Returns their sequence numbers. Raises Refused with 400 when they are
    malformed, 403 when the signature of one does not verify against manager_keys, 422 when one
    is for a host the dashboard has no token for, and 409 when the sequence number of one is
    taken: not above the highest seen."""
    try:
        signed_jobs = json.loads(body)
    except (ValueError, UnicodeDecodeError):
        raise Refused(400, "the jobs are not JSON")

    if not isinstance(signed_jobs, list) or not signed_jobs:
        raise Refused(400, "the jobs are not a JSON array of signed jobs")

    jobs = []
    for signed in signed_jobs:
        try:
            jobs.append((job.verify(signed, manager_keys), signed))
        except job.SignatureError as error:
            raise Refused(403, str(error))
        except job.JobError as error:
            raise Refused(400, str(error))

    for value, _ in jobs:
        if max(value["sequence"], value["expires"], -value["not_before"]) > MAX_INTEGER:
            raise Refused(400, f"job {value['sequence']} has a number too large to store")

    jobs.sort(key=lambda pair: pair[0]["sequence"])
    with db:
        highest = highest_sequence(db)
        for value, signed in jobs:
            if db.execute("SELECT 1 FROM hosts WHERE name = ?", (value["host"],)).fetchone() is None:
                raise Refused(422, f"the dashboard has no token for {value['host']}")
            if value["sequence"] <= highest:
                raise Refused(409, f"the sequence number {value['sequence']} is taken, the highest seen is {highest}")

            db.execute("INSERT INTO jobs (sequence, host, command, expires, signed, state, stored) "
                       "VALUES (?, ?, ?, ?, ?, 'waiting', ?)",
                       (value["sequence"], value["host"], value["command"], value["expires"], json.dumps(signed), now))
            highest = value["sequence"]

        record_sequence(db, highest)

    return [value["sequence"] for value, _ in jobs]


def load_jobs(db, host=None):
    """Returns the jobs, of one host or of all, in order of sequence."""
    query = "SELECT sequence, host, command, signed, state, started, ended, stored FROM jobs"
    rows = db.execute(query + (" WHERE host = ?" if host else "") + " ORDER BY sequence", (host,) if host else ())

    jobs = []
    for row in rows:
        signed = json.loads(row["signed"])
        jobs.append({
            "sequence": row["sequence"],
            "host": row["host"],
            "command": row["command"],
            "not_before": signed["job"]["not_before"],
            "expires": signed["job"]["expires"],
            "state": row["state"],
            "started": row["started"],
            "ended": row["ended"],
            "stored": row["stored"],
            "signed": signed,
        })

    return jobs


# --- Judging the state of a host ----------------------------------------------------------------

def version_key(version):
    return [int(part) if part.isdigit() else 0 for part in re.findall(r"\d+", version or "")]


def age(seconds):
    """Says how long ago something was, like 5 min or 3 days."""
    seconds = max(0, int(seconds))

    if seconds < 90:
        return f"{seconds} s"
    if seconds < 90 * 60:
        return f"{round(seconds / 60)} min"
    if seconds < 36 * 3600:
        return f"{round(seconds / 3600)} h"

    return f"{round(seconds / 86400)} days"


def assess(report, last_seen, now, stale_minutes, offline_days, dashboard_version, hardening_exceptions=()):
    """Returns the issues of a host, as (level, message) pairs. A host that did not report for
    stale_minutes is offline, which is only a note: a laptop may be off for days. After
    offline_days it is an error. A host with a HyprDebian version older than dashboard_version,
    the version of the dashboard, is outdated. The parts of hd-harden in hardening_exceptions
    are not judged."""
    issues = []

    def add(level, message):
        issues.append((level, message))

    if now - last_seen > offline_days * 86400:
        add("bad", f"No report for {age(now - last_seen)}")
    elif now - last_seen > stale_minutes * 60:
        add("info", f"Offline, no report for {age(now - last_seen)}")

    units = report.get("units") or {}
    failed = units.get("failed") or []
    if failed:
        add("bad", f"{len(failed)} failed: " + ", ".join(str(unit) for unit in failed))
    elif units.get("state") not in ("running", None):
        add("warn", f"System is {units.get('state')}")

    for pool in report.get("pools") or []:
        if pool.get("health") != "ONLINE":
            add("bad", f"Pool {pool.get('name')} is {pool.get('health')}")

        capacity = number(pool.get("capacity")) or 0
        if capacity >= POOL_BAD:
            add("bad", f"Pool {pool.get('name')} is {capacity}% full")
        elif capacity >= POOL_WARN:
            add("warn", f"Pool {pool.get('name')} is {capacity}% full")

        # The last completed scrub. Repaired bytes are a warning: the pool healed itself, but a
        # drive may be failing. Errors are data the scrub could not repair.
        scrub = pool.get("scrub")
        if isinstance(scrub, dict):
            if number(scrub.get("errors")):
                add("bad", f"Scrub of {pool.get('name')} found {scrub['errors']} errors")
            if number(scrub.get("repaired")):
                add("warn", f"Scrub of {pool.get('name')} repaired {size(scrub['repaired'])}")

    for array in report.get("arrays") or []:
        if array.get("degraded"):
            add("bad", f"Array {array.get('name')} is degraded")

    for timer in report.get("timers") or []:
        if timer.get("result") not in ("success", "", None):
            add("bad", f"{timer.get('service')} failed: {timer.get('result')}")

    system = report.get("os") or {}
    secure_boot = system.get("secure_boot")
    if secure_boot is None:
        add("bad", "Secure Boot not reported")
    elif secure_boot != "on":
        add("bad", SECURE_BOOT.get(secure_boot, f"Secure Boot is {secure_boot}"))

    updates = report.get("updates") or {}
    if updates.get("reboot_required") or (system.get("kernel_newest") and system.get("kernel_newest") != system.get("kernel")):
        add("warn", "Reboot pending")

    last_upgrade = number(updates.get("last_upgrade"))
    if last_upgrade is None:
        add("warn", "Never upgraded")
    elif now - last_upgrade > UPGRADE_DAYS * 86400:
        add("warn", f"Last upgrade {age(now - last_upgrade)} ago")

    upgradable = number(updates.get("upgradable"))
    if upgradable:
        add("info", f"{upgradable} upgradable packages")

    hardening = report.get("hardening")
    if not isinstance(hardening, dict) or not hardening:
        add("warn", "Hardening not reported")
    else:
        judged = {part: state for part, state in hardening.items() if part not in hardening_exceptions}
        for state, level, message in [("off", "warn", "Not hardened"), ("changed", "warn", "Hardening changed"),
                                      ("unknown", "info", "Hardening unknown")]:
            parts = [part for part, value in judged.items() if value == state]
            if parts:
                add(level, f"{message}: {', '.join(parts)}")

    version = (report.get("hyprdebian") or {}).get("version")
    if dashboard_version and version_key(version) < version_key(dashboard_version):
        add("warn", f"HyprDebian {version or 'unknown'}, dashboard is {dashboard_version}")

    return issues


def assess_jobs(jobs):
    """Returns the issues of the jobs of a host, in order of sequence: a failed job is an error, an
    expired one a warning, each until a newer job with the same command ends ok. Cancelled jobs
    are not judged."""
    issues = []

    for value in jobs:
        if value["state"] not in ("failed", "expired"):
            continue
        if any(newer["command"] == value["command"] and newer["sequence"] > value["sequence"] and newer["state"] == "ok"
               for newer in jobs):
            continue

        level = "bad" if value["state"] == "failed" else "warn"
        issues.append((level, f"{value['command'].capitalize()} job {value['sequence']} {value['state']}"))

    return issues


def level_of(issues):
    """The level of a host: its worst issue. Notes, like upgradable packages, leave a host good."""
    worst = "ok"

    for level, _ in issues:
        if level != "info" and LEVELS.index(level) > LEVELS.index(worst):
            worst = level

    return worst


def load_hosts(db, now, stale_minutes, offline_days, hardening_exceptions=None):
    """Returns the hosts with their report, the format of the report, their jobs and issues, the
    worst first. hardening_exceptions has the parts of hd-harden that are not judged per host."""
    hosts = []
    # Read for every page, so an upgrade of the dashboard's system shows without a restart.
    dashboard_version = hyprdebian_version()

    for row in db.execute("SELECT name, first_seen, last_seen, address, report FROM hosts"):
        try:
            report = json.loads(row["report"])
        except ValueError:
            report = {}

        hosts.append({
            "name": row["name"],
            "first_seen": row["first_seen"],
            "last_seen": row["last_seen"],
            "address": row["address"],
            # 1 from hd-report, 2 from hd-agent, so hd-manager can leave out the systems that cannot
            # run jobs.
            "format": report.get("format") if isinstance(report, dict) else None,
            "report": report,
        })

    jobs = {}
    for value in load_jobs(db):
        jobs.setdefault(value["host"], []).append(value)

    for host in hosts:
        host["jobs"] = jobs.get(host["name"], [])
        host["hardening_exceptions"] = (hardening_exceptions or {}).get(host["name"], [])
        host["issues"] = (assess(host["report"], host["last_seen"], now, stale_minutes, offline_days, dashboard_version,
                                 host["hardening_exceptions"]) + assess_jobs(host["jobs"]))
        host["level"] = level_of(host["issues"])

    hosts.sort(key=lambda host: (-LEVELS.index(host["level"]), host["name"]))
    return hosts


def load_history(db, host, since):
    return db.execute("SELECT time, load, memory, pool FROM history WHERE host = ? AND time >= ? ORDER BY time",
                      (host, since)).fetchall()


