#!/usr/bin/python3

# The hyprdebian dashboard. Every hyprdebian system POSTs a status report to it every 15 minutes,
# and it shows the latest report of every system on one page, with a short history.
#
#   hd-dashboard serve           runs the dashboard, see hd-dashboard.service
#   hd-dashboard hosts           lists the known hosts and when they last reported
#   hd-dashboard forget <host>   forgets a host and its token, so it can report with a new token
#
# A host is known by its host name. The first report of a host name registers its token, and
# later reports must bring the same token. A reinstalled system has a new token: forget the host
# first. The settings are the key hd-dashboard in /etc/hyprdebian/config.json; a setting that is
# not there has its value from /usr/share/hd-dashboard/defaults.json.

import argparse
import datetime
import hashlib
import html
import json
import os
import re
import sqlite3
import sys
import time
import urllib.parse

from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONFIG_FILE = "/etc/hyprdebian/config.json"
CONFIG_KEY = "hd-dashboard"
DEFAULTS_FILE = "/usr/share/hd-dashboard/defaults.json"
# The version of HyprDebian on the system of the dashboard, installed by hd-base. Hosts with an
# older version are outdated.
VERSION_FILE = "/etc/hyprdebian/version.json"
# The state directory of hd-dashboard.service.
DATABASE = "/var/lib/hd-dashboard/dashboard.db"

# The newest layout of a report this dashboard knows. Reports with a newer format are refused.
FORMAT = 1

MAX_REPORT_SIZE = 256 * 1024
HOST_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,62}$")
TOKEN = re.compile(r"^[A-Za-z0-9]{16,128}$")

# A system that was not upgraded for this long gets a warning.
UPGRADE_DAYS = 14

# Pools fuller than these get a warning and an error.
POOL_WARN = 80
POOL_BAD = 90

# What the states of Secure Boot in a report other than on mean, see hd-secboot --status.
SECURE_BOOT = {
    "off": "Secure Boot is off",
    "setup": "Secure Boot is off, firmware in setup mode",
    "unsupported": "Secure Boot is not supported by the firmware",
    "legacy": "Secure Boot is off, booted without UEFI",
}

# The levels of the issues, from good to bad.
LEVELS = ["ok", "info", "warn", "bad"]

SCHEMA = """
CREATE TABLE IF NOT EXISTS hosts (
    name TEXT PRIMARY KEY,
    token TEXT NOT NULL,
    first_seen INTEGER NOT NULL,
    last_seen INTEGER NOT NULL,
    address TEXT NOT NULL,
    report TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS history (
    host TEXT NOT NULL,
    time INTEGER NOT NULL,
    load REAL,
    memory REAL,
    pool REAL
);
CREATE INDEX IF NOT EXISTS history_host_time ON history (host, time);
"""


class ConfigError(Exception):
    pass


def defaults_file():
    """The defaults of the package, or those next to this program when it runs from the
    repository."""
    if os.path.exists(DEFAULTS_FILE):
        return DEFAULTS_FILE
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), "defaults.json")


def parse_config(config, defaults):
    """Returns the settings: the key hd-dashboard of the configuration over the defaults. Raises
    ConfigError on a value of the wrong type."""
    settings = dict(defaults)

    if isinstance(config, dict) and config.get(CONFIG_KEY) is not None:
        if not isinstance(config[CONFIG_KEY], dict):
            raise ConfigError(f"the key {CONFIG_KEY} is not a JSON object")
        settings.update(config[CONFIG_KEY])

    if not isinstance(settings.get("listen"), str) or not settings["listen"]:
        raise ConfigError("listen is not an address")

    for key, low, high in [("port", 1, 65535), ("stale_minutes", 1, None), ("offline_days", 1, None),
                           ("history_days", 1, None)]:
        value = settings.get(key)
        if isinstance(value, bool) or not isinstance(value, int) or value < low or (high and value > high):
            raise ConfigError(f"{key} is not a whole number from {low}" + (f" to {high}" if high else " up"))

    return settings


def load_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as error:
        raise ConfigError(f"cannot read {path}: {error}")


def load_config(path):
    defaults = load_json(defaults_file())
    if not isinstance(defaults, dict):
        raise ConfigError(f"no defaults in {defaults_file()}")

    return parse_config(load_json(path), defaults)


def hyprdebian_version(path=VERSION_FILE):
    """The version of HyprDebian on this system, <major>.<minor>, or None when it is unknown."""
    try:
        version = load_json(path)
        return f"{int(version['major'])}.{int(version['minor'])}"
    except (ConfigError, KeyError, TypeError, ValueError):
        return None


def connect(path):
    db = sqlite3.connect(path, timeout=10)
    db.row_factory = sqlite3.Row
    db.executescript(SCHEMA)
    return db


def connect_existing(path):
    """Opens the database without making it, so a command run as root before the first start of
    the service does not leave a database the service may not write."""
    db = sqlite3.connect(f"file:{urllib.parse.quote(path)}?mode=rw", uri=True, timeout=10)
    db.row_factory = sqlite3.Row
    db.executescript(SCHEMA)
    return db


def hash_token(token):
    return hashlib.sha256(token.encode()).hexdigest()


# --- Receiving reports ---------------------------------------------------------------------------

class Refused(Exception):
    """A report that is not accepted, with the HTTP status to answer."""

    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


def number(value):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None

    return value


def metrics(report):
    """Returns the values of a report that are kept in the history: the load per CPU, and the
    memory and the fullest pool in percent."""
    load = None
    values = report.get("load")
    cpus = number(report.get("cpus")) or 1
    if isinstance(values, list) and values and number(values[0]) is not None:
        load = values[0] / cpus

    memory = None
    mem = report.get("memory")
    if isinstance(mem, dict) and number(mem.get("total")) and number(mem.get("used")) is not None:
        memory = 100 * mem["used"] / mem["total"]

    pool = None
    for entry in report.get("pools") or []:
        if isinstance(entry, dict) and number(entry.get("capacity")) is not None:
            pool = max(pool or 0, entry["capacity"])

    return load, memory, pool


def accept_report(db, body, authorization, address, now, history_days):
    """Checks a report and stores it. Returns the host name. Raises Refused when it is refused."""
    match = re.match(r"^Bearer (\S+)$", authorization or "")
    if not match or not TOKEN.match(match.group(1)):
        raise Refused(401, "missing or malformed token")
    token = hash_token(match.group(1))

    try:
        report = json.loads(body)
    except (ValueError, UnicodeDecodeError):
        raise Refused(400, "the report is not JSON")

    if not isinstance(report, dict):
        raise Refused(400, "the report is not a JSON object")

    host = report.get("host")
    if not isinstance(host, str) or not HOST_NAME.match(host):
        raise Refused(400, "missing or malformed host name")

    if not isinstance(report.get("format"), int) or report["format"] > FORMAT:
        raise Refused(400, "unknown report format")

    with db:
        row = db.execute("SELECT token FROM hosts WHERE name = ?", (host,)).fetchone()

        if row is None:
            db.execute("INSERT INTO hosts (name, token, first_seen, last_seen, address, report) "
                       "VALUES (?, ?, ?, ?, ?, ?)", (host, token, now, now, address, body.decode()))
        elif row["token"] != token:
            raise Refused(403, f"{host} reports with a different token, see hd-dashboard forget")
        else:
            db.execute("UPDATE hosts SET last_seen = ?, address = ?, report = ? WHERE name = ?",
                       (now, address, body.decode(), host))

        db.execute("INSERT INTO history (host, time, load, memory, pool) VALUES (?, ?, ?, ?, ?)",
                   (host, now) + metrics(report))
        db.execute("DELETE FROM history WHERE time < ?", (now - history_days * 86400,))

    return host


# --- Judging the state of a host ----------------------------------------------------------------

def version_key(version):
    return [int(part) if part.isdigit() else 0 for part in re.findall(r"\d+", version or "")]


def age(seconds):
    """Says how long ago something was, like 5 min or 3 days."""
    seconds = max(0, int(seconds))

    if seconds < 90:
        return f"{seconds} s"
    if seconds < 90 * 60:
        return f"{round(seconds / 60)} min"
    if seconds < 36 * 3600:
        return f"{round(seconds / 3600)} h"

    return f"{round(seconds / 86400)} days"


def assess(report, last_seen, now, stale_minutes, offline_days, dashboard_version):
    """Returns the issues of a host, as (level, message) pairs. A host that did not report for
    stale_minutes is offline, which is only a note: a laptop may be off for days. After
    offline_days it is an error. A host with a HyprDebian version older than dashboard_version,
    the version of the dashboard, is outdated."""
    issues = []

    def add(level, message):
        issues.append((level, message))

    if now - last_seen > offline_days * 86400:
        add("bad", f"No report for {age(now - last_seen)}")
    elif now - last_seen > stale_minutes * 60:
        add("info", f"Offline, no report for {age(now - last_seen)}")

    units = report.get("units") or {}
    failed = units.get("failed") or []
    if failed:
        add("bad", f"{len(failed)} failed: " + ", ".join(str(unit) for unit in failed))
    elif units.get("state") not in ("running", None):
        add("warn", f"System is {units.get('state')}")

    for pool in report.get("pools") or []:
        if pool.get("health") != "ONLINE":
            add("bad", f"Pool {pool.get('name')} is {pool.get('health')}")

        capacity = number(pool.get("capacity")) or 0
        if capacity >= POOL_BAD:
            add("bad", f"Pool {pool.get('name')} is {capacity}% full")
        elif capacity >= POOL_WARN:
            add("warn", f"Pool {pool.get('name')} is {capacity}% full")

        # The last completed scrub. Repaired bytes are a warning: the pool healed itself, but a
        # drive may be failing. Errors are data the scrub could not repair.
        scrub = pool.get("scrub")
        if isinstance(scrub, dict):
            if number(scrub.get("errors")):
                add("bad", f"Scrub of {pool.get('name')} found {scrub['errors']} errors")
            if number(scrub.get("repaired")):
                add("warn", f"Scrub of {pool.get('name')} repaired {size(scrub['repaired'])}")

    for array in report.get("arrays") or []:
        if array.get("degraded"):
            add("bad", f"Array {array.get('name')} is degraded")

    for timer in report.get("timers") or []:
        if timer.get("result") not in ("success", "", None):
            add("bad", f"{timer.get('service')} failed: {timer.get('result')}")

    system = report.get("os") or {}
    secure_boot = system.get("secure_boot")
    if secure_boot is None:
        add("bad", "Secure Boot not reported")
    elif secure_boot != "on":
        add("bad", SECURE_BOOT.get(secure_boot, f"Secure Boot is {secure_boot}"))

    updates = report.get("updates") or {}
    if updates.get("reboot_required") or (system.get("kernel_newest") and system.get("kernel_newest") != system.get("kernel")):
        add("warn", "Reboot pending")

    last_upgrade = number(updates.get("last_upgrade"))
    if last_upgrade is None:
        add("warn", "Never upgraded")
    elif now - last_upgrade > UPGRADE_DAYS * 86400:
        add("warn", f"Last upgrade {age(now - last_upgrade)} ago")

    upgradable = number(updates.get("upgradable"))
    if upgradable:
        add("info", f"{upgradable} upgradable packages")

    version = (report.get("hyprdebian") or {}).get("version")
    if dashboard_version and version_key(version) < version_key(dashboard_version):
        add("warn", f"HyprDebian {version or 'unknown'}, dashboard is {dashboard_version}")

    return issues


def level_of(issues):
    """The level of a host: its worst issue. Notes, like upgradable packages, leave a host good."""
    worst = "ok"

    for level, _ in issues:
        if level != "info" and LEVELS.index(level) > LEVELS.index(worst):
            worst = level

    return worst


def load_hosts(db, now, stale_minutes, offline_days):
    """Returns the hosts with their report, history and issues, the worst first."""
    hosts = []
    # Read for every page, so an upgrade of the dashboard's system shows without a restart.
    dashboard_version = hyprdebian_version()

    for row in db.execute("SELECT name, first_seen, last_seen, address, report FROM hosts"):
        try:
            report = json.loads(row["report"])
        except ValueError:
            report = {}

        hosts.append({
            "name": row["name"],
            "first_seen": row["first_seen"],
            "last_seen": row["last_seen"],
            "address": row["address"],
            "report": report,
        })

    for host in hosts:
        host["issues"] = assess(host["report"], host["last_seen"], now, stale_minutes, offline_days, dashboard_version)
        host["level"] = level_of(host["issues"])

    hosts.sort(key=lambda host: (-LEVELS.index(host["level"]), host["name"]))
    return hosts


def load_history(db, host, since):
    return db.execute("SELECT time, load, memory, pool FROM history WHERE host = ? AND time >= ? ORDER BY time",
                      (host, since)).fetchall()


