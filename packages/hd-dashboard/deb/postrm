#!/usr/bin/env bash
# postrm of hd-dashboard: a removal masks hd-dashboard.service, whose unit file is gone, so that it
# keeps its enabled state for a reinstall. A purge also forgets that state, and removes the
# settings in /etc/hyprdebian/config.json and the database.
set -euo pipefail

CONFIG_KEY="hd-dashboard"
UNIT="hd-dashboard.service"

case "${1:-}" in
    remove | purge) ;;
    *) exit 0 ;;
esac

if [[ -d /run/systemd/system ]]; then
    systemctl --system daemon-reload || true
fi

if [[ "$1" == "remove" ]]; then
    deb-systemd-helper mask "${UNIT}" > /dev/null || true
    exit 0
fi

deb-systemd-helper purge "${UNIT}" > /dev/null || true
deb-systemd-helper unmask "${UNIT}" > /dev/null || true

# hd-base may already be removed, see hd-config(7).
if [[ -x /usr/sbin/hd-config-remove ]]; then
    hd-config-remove "${CONFIG_KEY}"
fi

# systemd keeps the state of a service with DynamicUser in /var/lib/private.
rm -rf /var/lib/private/hd-dashboard /var/lib/hd-dashboard
