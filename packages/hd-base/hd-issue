#!/usr/bin/python3
"""Writes the login banner in /etc/issue, which the console shows above the login prompt.

The package hd-base installs this as /usr/sbin/hd-issue. Its postinst runs it on every installation
and upgrade.

    hd-issue   write /etc/issue

The banner is "HyprDebian <version> · <suite> · <tty>": the version of HyprDebian from
/etc/hyprdebian/version.json, the suite of the HyprDebian packages from their apt source, and the
console. A system that is not linked to a HyprDebian repository, as after an installation, has no
such source; then the suite is the first one of the Debian source. agetty replaces \\e{...} with
a color, \\e with the escape character and \\l with the name of the console. A value that cannot
be found shows as unknown. Run it as root, after a change of the suite.

The banner starts with CURSOR_ON, which shows the cursor of the console: the kernel command line of
hd-bootloader hides it with vt.global_cursor_default=0 for the boot splash, and every reset of the
console, as getty does before agetty runs, hides it again. agetty prints the banner after that
reset, so the login prompt and the shell after it have the cursor.
"""

import argparse
import json
import os
import re
import sys

ISSUE = "/etc/issue"
VERSION = "/etc/hyprdebian/version.json"
SOURCES = "/etc/apt/sources.list.d/hyprdebian.sources"
DEBIAN_SOURCES = "/etc/apt/sources.list.d/debian.sources"
UNKNOWN = "unknown"
# Shows the cursor of the console, as agetty prints it: \e is the escape character.
CURSOR_ON = "\\e[?25h"


def version():
    """The version of HyprDebian, <major>.<minor>, which hd-base installs."""
    try:
        with open(VERSION, encoding="utf-8") as f:
            v = json.load(f)
        return f"{int(v['major'])}.{int(v['minor'])}"
    except (OSError, ValueError, KeyError, TypeError):
        return UNKNOWN


def first_suite(path):
    """The first suite of an apt source in the deb822 format, or None."""
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                match = re.match(r"Suites:\s*(\S+)", line)
                if match:
                    return match.group(1)
    except OSError:
        pass
    return None


def suite():
    """The suite of the HyprDebian packages, or else the first suite of Debian."""
    for path in (SOURCES, DEBIAN_SOURCES):
        value = first_suite(path)
        if value:
            return value
    return UNKNOWN


def main():
    argparse.ArgumentParser(
        description=f"Write the login banner in {ISSUE}: the version of HyprDebian and "
        "the suite.").parse_args()
    if os.geteuid() != 0:
        print("Error: This script must be run as root.", file=sys.stderr)
        sys.exit(1)

    banner = (f"{CURSOR_ON}\\e{{brown}}HyprDebian\\e{{reset}} {version()} · {suite()} · \\l\n\n")

    tmp = ISSUE + ".hd-issue"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(banner)
    os.chmod(tmp, 0o644)
    os.replace(tmp, ISSUE)


if __name__ == "__main__":
    main()
