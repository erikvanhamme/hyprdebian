#!/usr/bin/python3
"""Powers off the system, on a desktop and without one.

The package hd-base installs this as /usr/bin/hd-poweroff.

    hd-poweroff   power off

In a Hyprland session with hd-desktop, its hd-shutdown closes the applications first, asks what
to do about those that do not close, and then runs systemctl poweroff. Otherwise, as on the
console, over ssh or on a system without a desktop, systemctl poweroff runs right away. Whether
the user may do that is up to polkit, as for systemctl itself.
"""

import argparse
import os
import sys

ACTION = "poweroff"
# The command of hd-desktop that closes the applications of a Hyprland session first.
SHUTDOWN = "/usr/libexec/hd-desktop/hd-shutdown"


def on_desktop():
    """True in a Hyprland session that has hd-shutdown."""
    return bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")) and os.access(SHUTDOWN, os.X_OK)


def main():
    argparse.ArgumentParser(
        description=f"{ACTION.capitalize()} the system: with hd-shutdown in a Hyprland session, "
        f"otherwise with systemctl {ACTION}.").parse_args()

    if on_desktop():
        command = [SHUTDOWN, ACTION]
    else:
        command = ["systemctl", ACTION]

    try:
        os.execvp(command[0], command)
    except OSError as e:
        print(f"Error: Cannot run {command[0]}: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
