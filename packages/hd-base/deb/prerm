#!/bin/sh
# prerm of hd-base: stops the timers that scrub and trim the ZFS pools, and a scrub or trim that is
# being started, when the package is removed.
set -e

if [ "$1" != "remove" ]; then
    exit 0
fi

if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop hd-zfs-scrub.timer hd-zfs-trim.timer hd-zfs-scrub.service \
        hd-zfs-trim.service > /dev/null || true
fi
