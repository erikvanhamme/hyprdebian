#!/bin/sh
# postrm of hd-base: a removal puts back 10-uname and /etc/issue of base-files, which the postinst
# diverted, and masks the timers of hd-base, whose unit files are gone, so that they keep their
# enabled state for a reinstall. A purge also unmasks the units that the postinst masked, and
# forgets the state of the timers. Written for sh, as python3 may be gone by then.
set -e

UNAME=/etc/update-motd.d/10-uname
ISSUE=/etc/issue
TIMERS="hd-zfs-scrub.timer hd-zfs-trim.timer hd-up.timer"

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload || true
    fi
fi

if [ "$1" = "remove" ] || [ "$1" = "abort-install" ] || [ "$1" = "disappear" ]; then
    if [ "$(dpkg-divert --listpackage "$UNAME")" = "hd-base" ]; then
        dpkg-divert --package hd-base --remove --rename --divert "$UNAME.base-files" "$UNAME"
    fi
    # The banner of hd-issue is in the way of the one of base-files.
    if [ "$(dpkg-divert --listpackage "$ISSUE")" = "hd-base" ]; then
        rm -f "$ISSUE"
        dpkg-divert --package hd-base --remove --rename --divert "$ISSUE.debian" "$ISSUE"
    fi
fi

if [ "$1" = "remove" ] && [ -x /usr/bin/deb-systemd-helper ]; then
    for unit in $TIMERS; do
        deb-systemd-helper mask "$unit" > /dev/null || true
    done
fi

if [ "$1" != "purge" ]; then
    exit 0
fi

if [ -x /usr/bin/deb-systemd-helper ]; then
    for unit in systemd-firstboot.service rpcbind.socket rpcbind.service; do
        deb-systemd-helper unmask "$unit" > /dev/null || true
    done
    for unit in $TIMERS; do
        deb-systemd-helper purge "$unit" > /dev/null || true
        deb-systemd-helper unmask "$unit" > /dev/null || true
    done
fi
