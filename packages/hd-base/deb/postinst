#!/usr/bin/python3
"""postinst of hd-base: masks the units that HyprDebian does not use, points /etc/resolv.conf at
the name servers of systemd-resolved, leaves the message after a login to 00-hyprdebian, writes
the login banner in /etc/issue, generates the Secure Boot keys, removes the files that dpkg leaves
out on HyprDebian from the packages installed before, and enables the timers that scrub and trim
the ZFS pools and upgrade the system every week.

The units are masked on the first installation only, or on an upgrade from a version before
MASKED_SINCE, which did not mask them, so a unit that the admin unmasked stays unmasked on later
upgrades. deb-systemd-helper remembers that it masked them, so the postrm of a purge
can unmask them again. Versions before UNMASKED_SINCE also masked the units in UNMASKED; an
upgrade from such a version unmasks them.

The resolved config of hd-base turns off the stub resolver on 127.0.0.53, which the link that
systemd-resolved makes points at. The link is replaced with one to the file with the name servers
themselves. An /etc/resolv.conf that is not that link is left alone. Only a running
systemd-resolved writes the file with the name servers, so in a chroot, as in the installer, it
is missing and the new link points nowhere. The file is then made with the name servers that
the old link had, as the postinst of systemd-resolved does for the stub file, so names keep
resolving until systemd-resolved starts and writes the file itself.

The message after a login is /etc/motd followed by the output of the scripts in
/etc/update-motd.d. 00-hyprdebian of hd-base shows the banner and the state of the system, so
/etc/motd is emptied, on the first installation like the masks, and 10-uname of base-files, which
prints the kernel again, is diverted to a name with a dot, which run-parts skips. base-files only
writes /etc/motd when it is missing. The postrm of a removal puts 10-uname back.

Versions before FIRMWARE_SINCE depended on all of the firmware of Debian, which is now marked as
installed automatically and left for apt autoremove. An upgrade from such a version says to run
hd-firmware --install first, which marks the firmware the hardware needs as installed by hand.
The postinst runs inside apt, which holds the lock, so it cannot do that itself.

Versions before DROPPED_SINCE also depended on the packages in DROPPED, which are now marked as
installed automatically and left for apt autoremove. An upgrade from such a version names them and
says to mark the ones that are still used as installed by hand first, such as nfs-common on a
system that mounts NFS shares.

Versions before SOURCES_SINCE named the apt source of hd-link-repo hyprdebian.local.sources. An
upgrade from such a version renames it to hyprdebian.sources, unless that one already exists, so
hd-link-repo, hd-issue and hd-report find it.

/etc/issue of base-files is diverted to /etc/issue.debian, and hd-issue writes the HyprDebian
banner in its place, on every installation and upgrade, so it shows the version that is installed.
The postrm of a removal removes it and puts the one of base-files back.

/etc/dpkg/dpkg.cfg.d/hyprdebian-excludes has the files that dpkg leaves out of every package: the
documentation, the translations, the man pages in other languages and the info pages. dpkg only
applies it to the packages it installs after hd-base, so on the first installation, or an upgrade
from a version before EXCLUDES_SINCE, which did not have it, the postinst removes those files from
the packages that are installed, with the rules of that file: the last rule that matches a path
decides, as for dpkg. Directories that are left empty go too.

hd-zfs-scrub.timer, hd-zfs-trim.timer and hd-up.timer get the steps that debhelper adds for a timer: they are
enabled on the first installation, by their preset, and keep the enabled state that the admin gave
them over upgrades. The unmask undoes the mask of a removal, see the postrm.

The Secure Boot keys in /etc/hyprdebian/secboot are generated when they are not there yet.
Existing keys are never replaced, so an upgrade or a reinstall keeps keys that may already be
enrolled in the firmware. The keys are the platform key (PK), the key exchange key (KEK) and the
signature database key (db), all with the same owner GUID (GUID.txt). Each has its private key
(.key), its certificate as PEM (.crt) for sbsign and as DER (.cer) for the key menus of firmware
setups, an EFI signature list (.esl) and a signed update (.auth) for efi-updatevar or KeyTool: PK
signs its own and that of KEK, KEK signs that of db. EFI files are signed with the db key. RSA 2048
is the key size that the UEFI spec requires every firmware to support.
"""

import fnmatch
import os
import shutil
import socket
import subprocess
import sys
import uuid

# The units that HyprDebian masks: the first boot setup, and rpcbind, which nfs-common pulls in
# when it is installed, but which NFS version 4 does not need.
MASKED = [
    "systemd-firstboot.service",
    "rpcbind.socket",
    "rpcbind.service",
]

# The first version of hd-base that masks the units.
MASKED_SINCE = "0.2"

# The units that versions before UNMASKED_SINCE masked as well: systemd-preset-all.service, which
# systemd does not have, and the commit of the machine ID, with which systemd keeps
# /etc/machine-id.
UNMASKED = [
    "systemd-preset-all.service",
    "systemd-machine-id-commit.service",
]
UNMASKED_SINCE = "1.1"

MOTD = "/etc/motd"
UNAME = "/etc/update-motd.d/10-uname"
UNAME_DIVERTED = UNAME + ".base-files"
ISSUE = "/etc/issue"
ISSUE_DIVERTED = "/etc/issue.debian"

# The apt source of hd-link-repo, and its name before SOURCES_SINCE.
SOURCES = "/etc/apt/sources.list.d/hyprdebian.sources"
SOURCES_OLD = "/etc/apt/sources.list.d/hyprdebian.local.sources"
SOURCES_SINCE = "1.11"

# The first version of hd-base that leaves the firmware to hd-firmware.
FIRMWARE_SINCE = "1.23"

# The packages that versions before DROPPED_SINCE depended on, and no longer.
DROPPED = ["build-essential", "git", "git-delta", "nfs-common", "net-tools", "pciutils",
           "usbutils", "acpi", "ack"]
DROPPED_SINCE = "1.26"

# The files that dpkg leaves out, and the first version of hd-base that has them.
EXCLUDES = "/etc/dpkg/dpkg.cfg.d/hyprdebian-excludes"
EXCLUDES_SINCE = "1.26"
DPKG_INFO = "/var/lib/dpkg/info"

# The timers of hd-base.
TIMERS = ["hd-zfs-scrub.timer", "hd-zfs-trim.timer", "hd-up.timer"]

RESOLV_CONF = "/etc/resolv.conf"
STUB_LINKS = ["../run/systemd/resolve/stub-resolv.conf", "/run/systemd/resolve/stub-resolv.conf"]
SERVERS_LINK = "../run/systemd/resolve/resolv.conf"
SERVERS_FILE = "/run/systemd/resolve/resolv.conf"

KEY_DIR = "/etc/hyprdebian/secboot"
KEY_TMP_DIR = KEY_DIR + ".tmp"
KEY_NAMES = ["PK", "KEK", "db"]
# Each key is signed by the one named here: PK by itself, KEK by PK, db by KEK.
KEY_SIGNER = {"PK": "PK", "KEK": "PK", "db": "KEK"}
KEY_DAYS = 3650


def mask_units():
    for unit in MASKED:
        subprocess.run(["deb-systemd-helper", "mask", unit], check=True)
        print(f"Masked {unit}.")


def unmask_units():
    for unit in UNMASKED:
        subprocess.run(["deb-systemd-helper", "unmask", unit], check=True)
        print(f"Unmasked {unit}.")


def divert(path, diverted):
    """Diverts a file of another package to another name, unless hd-base already did."""
    owner = subprocess.run(["dpkg-divert", "--listpackage", path], capture_output=True,
                           text=True, check=True).stdout.strip()
    if owner == "hd-base":
        return
    subprocess.run(["dpkg-divert", "--package", "hd-base", "--add", "--rename", "--divert",
                    diverted, path], check=True)


def empty_motd():
    with open(MOTD, "w", encoding="utf-8"):
        pass
    print(f"Emptied {MOTD}.")


def older_than(version, than):
    """True if the package version is older than the other one."""
    return subprocess.run(["dpkg", "--compare-versions", version, "lt", than]).returncode == 0


def rename_sources():
    if not os.path.exists(SOURCES_OLD):
        return
    if os.path.exists(SOURCES):
        return
    os.rename(SOURCES_OLD, SOURCES)
    print(f"Renamed {SOURCES_OLD} to {SOURCES}.")


def link_resolv_conf():
    if not os.path.islink(RESOLV_CONF):
        return
    if os.readlink(RESOLV_CONF) not in STUB_LINKS:
        return
    if not os.path.exists(SERVERS_FILE) and os.path.exists(RESOLV_CONF):
        os.makedirs(os.path.dirname(SERVERS_FILE), exist_ok=True)
        shutil.copyfile(RESOLV_CONF, SERVERS_FILE)
        print(f"Copied the name servers of {RESOLV_CONF} to {SERVERS_FILE}.")
    tmp = RESOLV_CONF + ".hd-base"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(SERVERS_LINK, tmp)
    os.replace(tmp, RESOLV_CONF)
    print(f"Pointed {RESOLV_CONF} at {SERVERS_LINK}.")


def run(*command):
    subprocess.run(command, check=True)


def hostname():
    try:
        with open("/etc/hostname", encoding="utf-8") as f:
            name = f.read().strip()
    except OSError:
        name = ""
    if name == "":
        name = socket.gethostname()
    return name


def generate_keys_in(tmp):
    guid = str(uuid.uuid4())
    with open(os.path.join(tmp, "GUID.txt"), "w", encoding="utf-8") as f:
        f.write(guid + "\n")

    host = hostname()
    for name in KEY_NAMES:
        path = os.path.join(tmp, name)
        run("openssl", "req", "-new", "-x509", "-newkey", "rsa:2048", "-nodes", "-sha256",
            "-days", str(KEY_DAYS), "-subj", f"/CN=HyprDebian {host} Secure Boot {name}/",
            "-keyout", f"{path}.key", "-out", f"{path}.crt")
        run("openssl", "x509", "-in", f"{path}.crt", "-outform", "DER", "-out", f"{path}.cer")
        run("cert-to-efi-sig-list", "-g", guid, f"{path}.crt", f"{path}.esl")

    for name in KEY_NAMES:
        path = os.path.join(tmp, name)
        signer = os.path.join(tmp, KEY_SIGNER[name])
        run("sign-efi-sig-list", "-g", guid, "-k", f"{signer}.key", "-c", f"{signer}.crt",
            name, f"{path}.esl", f"{path}.auth")


def generate_keys():
    if os.path.exists(KEY_DIR):
        print(f"Keeping the Secure Boot keys in {KEY_DIR}.")
        return

    # The keys are made in a directory of their own that only root can enter, and moved into
    # place when they are all there, so a failure never leaves half a set of keys behind.
    print(f"Generating the Secure Boot keys in {KEY_DIR}...", flush=True)
    shutil.rmtree(KEY_TMP_DIR, ignore_errors=True)
    os.makedirs(os.path.dirname(KEY_DIR), mode=0o755, exist_ok=True)
    os.mkdir(KEY_TMP_DIR, mode=0o700)
    old_umask = os.umask(0o077)
    try:
        generate_keys_in(KEY_TMP_DIR)
    except (OSError, subprocess.CalledProcessError) as e:
        shutil.rmtree(KEY_TMP_DIR, ignore_errors=True)
        print(f"Error: Cannot generate the Secure Boot keys: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        os.umask(old_umask)
    for name in os.listdir(KEY_TMP_DIR):
        os.chmod(os.path.join(KEY_TMP_DIR, name), 0o600)
    os.rename(KEY_TMP_DIR, KEY_DIR)


def exclude_rules():
    """The rules of EXCLUDES, in order, as (excluded, pattern)."""
    rules = []
    with open(EXCLUDES, encoding="utf-8") as f:
        for line in f:
            option, sep, pattern = line.strip().partition("=")
            if sep and option in ("path-exclude", "path-include"):
                rules.append((option == "path-exclude", pattern))
    return rules


def excluded(path, rules):
    """True when dpkg leaves the path out: the last rule that matches it decides. dpkg matches
    with fnmatch, whose * also matches a /."""
    result = False
    for exclude, pattern in rules:
        if fnmatch.fnmatchcase(path, pattern):
            result = exclude
    return result


def remove_excluded():
    """Removes the files of the installed packages that dpkg would leave out now, then the
    directories of them that are left empty, deepest first."""
    rules = exclude_rules()
    paths = set()
    for name in os.listdir(DPKG_INFO):
        if name.endswith(".list"):
            with open(os.path.join(DPKG_INFO, name), encoding="utf-8",
                      errors="surrogateescape") as f:
                paths.update(line.rstrip("\n") for line in f)

    count = size = 0
    directories = []
    for path in paths:
        if not excluded(path, rules):
            continue
        if os.path.isdir(path) and not os.path.islink(path):
            directories.append(path)
        elif os.path.lexists(path):
            size += os.lstat(path).st_size
            os.remove(path)
            count += 1

    for path in sorted(directories, key=len, reverse=True):
        try:
            os.rmdir(path)
        except OSError:
            pass
    print(f"Removed {count} files ({size / 2**20:.0f} MiB) that dpkg leaves out, see {EXCLUDES}.")


def enable_timers():
    for unit in TIMERS:
        subprocess.run(["deb-systemd-helper", "unmask", unit], stdout=subprocess.DEVNULL)
        if subprocess.run(["deb-systemd-helper", "--quiet", "was-enabled", unit]).returncode == 0:
            subprocess.run(["deb-systemd-helper", "enable", unit], stdout=subprocess.DEVNULL)
        else:
            subprocess.run(["deb-systemd-helper", "update-state", unit], stdout=subprocess.DEVNULL)

    if not os.environ.get("DPKG_ROOT") and os.path.isdir("/run/systemd/system"):
        subprocess.run(["systemctl", "--system", "daemon-reload"], check=True)
        subprocess.run(["deb-systemd-invoke", "restart", *TIMERS], check=True)


def main():
    # configure is the only action that installs the package; the abort-* actions undo a
    # failed upgrade or removal.
    if len(sys.argv) < 2 or sys.argv[1] != "configure":
        return

    # The version that was configured before, empty on the first installation.
    previous = sys.argv[2] if len(sys.argv) > 2 else ""
    if previous == "" or older_than(previous, MASKED_SINCE):
        mask_units()
        empty_motd()
    if previous != "" and older_than(previous, UNMASKED_SINCE):
        unmask_units()
    if previous != "" and older_than(previous, SOURCES_SINCE):
        rename_sources()
    if previous != "" and older_than(previous, FIRMWARE_SINCE):
        print("hd-base no longer depends on all of the firmware. Run hd-firmware --install "
              "before apt autoremove, so the firmware this hardware needs stays installed.")
    if previous != "" and older_than(previous, DROPPED_SINCE):
        print(f"hd-base no longer depends on {', '.join(DROPPED)}. apt autoremove removes them; "
              "mark the ones you use as installed by hand first, such as apt-mark manual "
              "nfs-common for NFS mounts.")
    if previous == "" or older_than(previous, EXCLUDES_SINCE):
        remove_excluded()
    link_resolv_conf()
    divert(UNAME, UNAME_DIVERTED)
    divert(ISSUE, ISSUE_DIVERTED)
    subprocess.run(["/usr/sbin/hd-issue"], check=True)
    generate_keys()
    enable_timers()


if __name__ == "__main__":
    main()
