#!/usr/bin/python3
"""Checks that Secure Boot is on.

The package hd-base installs this as /usr/sbin/hd-secboot-check.

    hd-secboot-check       say whether Secure Boot is on
    hd-secboot-check -q    say nothing, only set the exit status

It reads the EFI variables SecureBoot and SetupMode in /sys/firmware/efi/efivars, which every
user can read. It exits with 0 when Secure Boot is on and with 1 when it is not.
"""

import argparse
import os
import sys

EFIVARS = "/sys/firmware/efi/efivars"
GLOBAL_GUID = "8be4df61-93ca-11d2-aa0d-00e098032b8c"

# What each state says, for the states in which Secure Boot is not on.
MESSAGES = {
    "off": "Secure Boot is off. Turn it on in the setup menu of the firmware.",
    "setup": "Secure Boot is off: the firmware is in setup mode. Enroll the keys with "
             "hd-secboot-enroll, then turn Secure Boot on in the setup menu of the firmware.",
    "unsupported": "Secure Boot is off: the firmware does not support it.",
    "legacy": "Secure Boot is off: the system was not booted with UEFI.",
}


# The value of an EFI variable, without the 4 bytes of attributes in front, or None.
def read_var(efivars, name):
    try:
        with open(os.path.join(efivars, f"{name}-{GLOBAL_GUID}"), "rb") as f:
            return f.read()[4:]
    except FileNotFoundError:
        return None


def secure_boot_state(efivars=EFIVARS):
    """The state of Secure Boot: on, off, setup (off, with the firmware in setup mode),
    unsupported (UEFI without Secure Boot) or legacy (not booted with UEFI)."""
    if not os.path.isdir(efivars):
        return "legacy"
    secure_boot = read_var(efivars, "SecureBoot")
    if secure_boot is None:
        return "unsupported"
    if secure_boot == b"\x01":
        return "on"
    if read_var(efivars, "SetupMode") == b"\x01":
        return "setup"
    return "off"


def main():
    parser = argparse.ArgumentParser(
        description="Check that Secure Boot is on. Exits with 0 when it is, 1 when it is not.")
    parser.add_argument("-q", "--quiet", action="store_true",
                        help="say nothing, only set the exit status")
    args = parser.parse_args()

    state = secure_boot_state()
    if state == "on":
        if not args.quiet:
            print("Secure Boot is on.")
        return 0

    if not args.quiet:
        print(MESSAGES[state])
    return 1


if __name__ == "__main__":
    sys.exit(main())
