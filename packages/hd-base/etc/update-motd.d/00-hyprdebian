#!/bin/bash

# Shows the HyprDebian banner and the state of the system after a login on the console or over
# ssh. pam_motd runs this as root. The package hd-base installs it.

# The source of the HyprDebian packages, whose suite is shown, and the source of Debian, whose
# first suite is shown when there is no source of the HyprDebian packages, as after an
# installation.
SOURCES=/etc/apt/sources.list.d/hyprdebian.sources
DEBIAN_SOURCES=/etc/apt/sources.list.d/debian.sources

# The version of HyprDebian, which hd-base installs.
VERSION=/etc/hyprdebian/version.json

# The colors of the window borders: orange for the logo, blue for its shadow.
ACCENT=$'\e[38;5;202m'
SHADOW=$'\e[38;5;26m'
LABEL=$'\e[2m'
GOOD=$'\e[32m'
BAD=$'\e[1;31m'
RESET=$'\e[0m'

# Prints the version of HyprDebian, <major>.<minor>, or "unknown".
hyprdebian_version() {
    local value

    value=$(python3 -c 'import json, sys
v = json.load(open(sys.argv[1]))
print("%d.%d" % (v["major"], v["minor"]))' "$VERSION" 2>/dev/null)

    if [[ -z "$value" ]]; then
        value="unknown"
    fi

    echo "$value"
}

# Prints the suite of the HyprDebian packages, the first word of Suites: in their source, or else
# that of the source of Debian, or "unknown".
suite() {
    local source value

    for source in "$SOURCES" "$DEBIAN_SOURCES"; do
        value=$(sed -n 's/^Suites:[[:space:]]*\([^[:space:]]*\).*/\1/p' "$source" 2>/dev/null \
            | head -n 1)
        if [[ -n "$value" ]]; then
            echo "$value"
            return
        fi
    done

    echo "unknown"
}

# Prints a line with a label in front of it.
# Usage: line <label> <text>
line() {
    printf '  %s%-8s%s %s\n' "$LABEL" "$1" "$RESET" "$2"
}

show_logo() {
    local logo

    logo=$(cat <<'EOF'
░██     ░██                                ░███████              ░██        ░██
░██     ░██                                ░██   ░██             ░██
░██     ░██ ░██    ░██ ░████████  ░██░████ ░██    ░██  ░███████  ░████████  ░██ ░██████   ░████████
░██████████ ░██    ░██ ░██    ░██ ░███     ░██    ░██ ░██    ░██ ░██    ░██ ░██      ░██  ░██    ░██
░██     ░██ ░██    ░██ ░██    ░██ ░██      ░██    ░██ ░█████████ ░██    ░██ ░██ ░███████  ░██    ░██
░██     ░██ ░██   ░███ ░███   ░██ ░██      ░██   ░██  ░██        ░███   ░██ ░██░██   ░██  ░██    ░██
░██     ░██  ░█████░██ ░██░█████  ░██      ░███████    ░███████  ░██░█████  ░██ ░█████░██ ░██    ░██
                   ░██ ░██
             ░███████  ░██
EOF
)

    echo
    while IFS= read -r row; do
        printf '  %s%s\n' "${ACCENT}${row//░/${SHADOW}░${ACCENT}}" "$RESET"
    done <<< "$logo"
    echo
}

show_version() {
    local debian

    debian=$(cat /etc/debian_version 2>/dev/null)

    printf '  %sHyprDebian%s %s · %s · Debian %s\n' "$ACCENT" "$RESET" \
        "$(hyprdebian_version)" "$(suite)" "${debian:-unknown}"
    printf '  %sMaintained by Erik Van Hamme <erik.vanhamme@gmail.com>%s\n\n' "$LABEL" "$RESET"
}

show_system() {
    local load1 load5 load15 rest

    read -r load1 load5 load15 rest < /proc/loadavg

    line "Kernel" "$(uname -r)"
    line "Uptime" "$(uptime -p | sed 's/^up //')"
    line "Load" "${load1} ${load5} ${load15}"
    line "Memory" "$(free -h | awk '/^Mem:/ { print $3 " / " $2 }')"
}

# One line per ZFS pool, with its health and how full it is.
show_pools() {
    local name health capacity size color
    local label="Pools"

    if ! command -v zpool >/dev/null; then
        return 0
    fi

    while IFS=$'\t' read -r name health capacity size; do
        if [[ "$health" == "ONLINE" ]]; then
            color="$GOOD"
        else
            color="$BAD"
        fi

        line "$label" "${name} ${color}${health}${RESET} ${capacity} of ${size}"
        label=""
    done < <(zpool list -H -o name,health,capacity,size 2>/dev/null)
}

# One line per mdadm array, like the swap array on systems with redundant drives.
show_arrays() {
    local md name link degraded state
    local label="RAID"

    for md in /sys/block/md*; do
        if [[ ! -d "$md/md" ]]; then
            continue
        fi

        # Prefer the name of the array, like swap, over md127.
        name=$(basename "$md")
        for link in /dev/md/*; do
            if [[ "$(readlink -f "$link")" == "/dev/${name}" ]]; then
                name=$(basename "$link")
            fi
        done

        # The number of missing drives.
        degraded=$(cat "$md/md/degraded" 2>/dev/null)

        if [[ "${degraded:-0}" == "0" ]]; then
            state="${GOOD}$(cat "$md/md/array_state" 2>/dev/null)${RESET}"
        else
            state="${BAD}degraded${RESET}"
        fi

        line "$label" "${name} ${state}"
        label=""
    done
}

show_units() {
    local failed=()

    mapfile -t failed < <(systemctl list-units --failed --no-legend --plain 2>/dev/null | awk '{ print $1 }')

    if (( ${#failed[@]} == 0 )); then
        line "Units" "${GOOD}all running${RESET}"
    else
        line "Units" "${BAD}${#failed[@]} failed:${RESET} $(IFS=,; echo "${failed[*]}" | sed 's/,/, /g')"
    fi
}

# A line when a reboot is needed, with the reasons of hd-reboot-check.
show_reboot() {
    local reasons=()

    mapfile -t reasons < <(hd-reboot-check 2>/dev/null)

    if (( ${#reasons[@]} > 0 )); then
        line "Reboot" "${BAD}needed:${RESET} $(IFS=';'; echo "${reasons[*]}" | sed 's/;/; /g')"
    fi
}

show_logo
show_version
show_system
show_pools
show_arrays
show_units
show_reboot
echo
