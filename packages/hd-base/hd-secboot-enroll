#!/usr/bin/python3
"""Enrolls the Secure Boot keys in /etc/hyprdebian/secboot in the firmware.

The package hd-base installs this as /usr/sbin/hd-secboot-enroll.

    hd-secboot-enroll             add db and KEK to what the firmware has, then set PK
    hd-secboot-enroll --replace   replace db and KEK, then set PK
    hd-secboot-enroll --dry-run   show what would be done, change nothing

The firmware must be in setup mode: without a platform key, which is removed in its setup menu.
The keys are written with efi-updatevar from their signed updates (.auth): db and KEK first, PK
last, because setting PK ends setup mode. Run it as root.
"""

import argparse
import array
import fcntl
import os
import subprocess
import sys

KEY_DIR = "/etc/hyprdebian/secboot"
EFIVARS = "/sys/firmware/efi/efivars"
EFI_UPDATEVAR = "efi-updatevar"
GLOBAL_GUID = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
DB_GUID = "d719b2cb-3d3a-4596-a3bc-dad00e67656f"
# The variables in the order they are written, with their GUID. PK goes last: it ends setup mode.
VARIABLES = [("db", DB_GUID), ("KEK", GLOBAL_GUID), ("PK", GLOBAL_GUID)]

# From linux/fs.h. The kernel makes most efivarfs files immutable, so they cannot be removed by
# accident; efi-updatevar can only write them when that flag is cleared.
FS_IOC_GETFLAGS = 0x80086601
FS_IOC_SETFLAGS = 0x40086602
FS_IMMUTABLE_FL = 0x00000010


def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def var_path(name, guid):
    return os.path.join(EFIVARS, f"{name}-{guid}")


# The value of an EFI variable, without the 4 bytes of attributes in front, or None.
def read_var(name, guid):
    try:
        with open(var_path(name, guid), "rb") as f:
            return f.read()[4:]
    except FileNotFoundError:
        return None


def clear_immutable(path):
    with open(path, "rb") as f:
        flags = array.array("i", [0])
        fcntl.ioctl(f.fileno(), FS_IOC_GETFLAGS, flags, True)
        if flags[0] & FS_IMMUTABLE_FL:
            flags[0] &= ~FS_IMMUTABLE_FL
            fcntl.ioctl(f.fileno(), FS_IOC_SETFLAGS, flags)


def main():
    parser = argparse.ArgumentParser(
        description=f"Enroll the Secure Boot keys in {KEY_DIR} in the firmware, which must be "
        "in setup mode.")
    parser.add_argument("--replace", action="store_true",
                        help="replace the db and KEK entries the firmware has, such as those of "
                        "Microsoft, instead of adding to them")
    parser.add_argument("-n", "--dry-run", action="store_true",
                        help="show what would be done, change nothing")
    args = parser.parse_args()
    if os.geteuid() != 0:
        fail("This script must be run as root.")

    for name, _ in VARIABLES:
        if not os.path.isfile(os.path.join(KEY_DIR, f"{name}.auth")):
            fail(f"{os.path.join(KEY_DIR, name + '.auth')} does not exist. hd-base generates "
                 f"the keys when it is installed and {KEY_DIR} does not exist yet.")
    if not os.path.isdir(EFIVARS):
        fail(f"{EFIVARS} does not exist: the system was not booted with UEFI.")
    setup_mode = read_var("SetupMode", GLOBAL_GUID)
    if setup_mode is None:
        fail("The firmware does not report SetupMode; it may not support Secure Boot.")
    if setup_mode != b"\x01":
        fail("The firmware is not in setup mode. Remove the platform key (PK), or reset the "
             "Secure Boot keys to setup mode, in the setup menu of the firmware, then run this "
             "again.")

    for name, guid in VARIABLES:
        auth = os.path.join(KEY_DIR, f"{name}.auth")
        # There is only one platform key, so PK is always replaced.
        append = name != "PK" and not args.replace
        command = [EFI_UPDATEVAR] + (["-a"] if append else []) + ["-f", auth, name]
        action = "Adding to" if append else "Writing"
        if args.dry_run:
            print(f"Would run: {' '.join(command)}")
            continue
        print(f"{action} {name}...", flush=True)
        if os.path.exists(var_path(name, guid)):
            clear_immutable(var_path(name, guid))
        result = subprocess.run(command)
        if result.returncode != 0:
            fail(f"Writing {name} failed. The firmware may not let the system write its keys; "
                 f"enroll the .auth or .cer files in {KEY_DIR} from its setup menu instead.")

    if args.dry_run:
        return
    if read_var("SetupMode", GLOBAL_GUID) != b"\x00":
        fail("The keys were written, but the firmware is still in setup mode.")
    print("The keys are enrolled and the firmware has left setup mode. Sign the EFI files "
          "that are to boot with the db key, then turn Secure Boot on in the setup menu of the "
          "firmware.")


if __name__ == "__main__":
    main()
