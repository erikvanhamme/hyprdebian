#!/usr/bin/python3
"""postinst of hd-desktop: diverts /etc/greetd/config.toml of greetd, writes the greetd config of
HyprDebian in its place with hd-desktop-render, diverts /etc/plymouth/plymouthd.conf of plymouth
and puts the config of the boot splash in its place, compiles the dconf database of the dark theme,
renders the cards of the themes and selects the theme default when no theme is selected yet,
renders the boot splash in the theme of the system with hd-plymouth-render, copies /etc/skel to the home directory of the user, and writes the menu of the application launcher
with hd-launcher-cache. It also finishes the removal of the conffiles that hd-desktop no longer has.

greetd ships /etc/greetd/config.toml as a conffile. It is diverted to /etc/greetd/config.toml.greetd,
so dpkg keeps the one of greetd there, and hd-desktop-render writes the file that greetd reads,
on every installation and upgrade, and before every start of greetd. The postrm of a removal
removes it and puts the one of greetd back.

plymouth ships /etc/plymouth/plymouthd.conf as a conffile. It is diverted to
/etc/plymouth/plymouthd.conf.plymouth, so dpkg keeps the one of plymouth there, and the config of
the boot splash, which makes hyprdebian the theme of plymouth, is copied over it on every
installation and upgrade. The postrm of a removal removes it and puts the one of plymouth back. The
initramfs holds the theme: the package activates the trigger update-initramfs of initramfs-tools,
which rebuilds it once dpkg is done, with the theme that this config names. The hook hd-plymouth
renders the splash again for that; the postinst renders it too, so the splash of a shutdown, which
plymouthd shows from the root file system, has it at once. hd-theme --select runs without
rebuilding the initramfs here, as the trigger does that.

The theme files in the home directories are not written here: each user runs hd-theme --apply
for that.

greetd enables greetd.service on its own installation. When the installer runs, the user does not
exist yet; hd-desktop-render then writes a config that logs nobody in, and writes it again with
the user at the first boot, before greetd starts.

The user who is logged in to Hyprland, as hd-desktop-render --print-user finds them, gets the
files of /etc/skel that are missing from their home directory, among them the configs of the
desktop. Files that the user has are kept. This is done on the first installation only, or on an
upgrade from a version before SKEL_SINCE, which did not do it, so a file that the user removed
does not come back on later upgrades. It runs as the user, so the files belong to them. When the
installer runs, the user does not exist yet, and the installer copies /etc/skel itself.

Versions before TOOLKITS_SINCE had no settings for the Qt applications and the dialogs of
Hyprland. An upgrade from such a version gives that user the settings of qt5ct, qt6ct and
hyprtoolkit of /etc/skel, in TOOLKITS_SKEL, in the same way, and says that the config of Hyprland
of the user still names the platform theme gtk3, which is gone, and should name qt5ct, as the one
in /etc/skel.

The apt hook of hd-launcher-cache writes the menu in the caches of the system and of the users in
the group users after every run of dpkg by apt, but not when the package is installed with dpkg
alone, so the postinst writes them too. A menu that cannot be written does not fail the
installation.

Versions before DROPPED_SINCE also depended on the packages in DROPPED, which are now marked as
installed automatically and left for apt autoremove. An upgrade from such a version names them and
says to mark the ones that are still used as installed by hand first, such as git. The postinst
runs inside apt, which holds the lock, so it cannot do that itself.

The conffiles in OBSOLETE_CONFFILES are removed with dpkg-maintscript-helper rm_conffile, which the
preinst, the postinst and the postrm all run with their arguments. dpkg cannot remove their
directory at the unpack, while they are still there, so the postinst removes it when it is empty;
otherwise new users would get it from /etc/skel.
"""

import json
import os
import pwd
import shutil
import subprocess
import sys

GREETD_CONFIG = "/etc/greetd/config.toml"
GREETD_CONFIG_DIVERTED = "/etc/greetd/config.toml.greetd"
SKEL_DIR = "/etc/skel"
PLYMOUTH_CONFIG = "/etc/plymouth/plymouthd.conf"
PLYMOUTH_CONFIG_DIVERTED = "/etc/plymouth/plymouthd.conf.plymouth"
HD_PLYMOUTH_CONFIG = "/usr/share/hd-plymouth/plymouthd.conf"
CONFIG_FILE = "/etc/hyprdebian/config.json"
THEME_KEY = "hd-theme"
DEFAULT_THEME = "default"

# The conffiles that hd-desktop no longer has, each with the version that removed it, with ~ so that
# its prereleases count. Keep them the same as in the preinst and the postrm.
OBSOLETE_CONFFILES = [
    ("/etc/skel/.config/wofi/config", "0.10~"),
    ("/etc/skel/.config/wofi/style.css", "0.10~"),
    ("/etc/skel/.gitconfig", "1.27~"),
    ("/etc/skel/.config/nwg-look/config", "1.27~"),
    ("/etc/skel/.local/share/nwg-look/gsettings", "1.27~"),
]
# The directories of the obsolete conffiles, removed when they are empty, deepest first.
OBSOLETE_DIRS = ["/etc/skel/.config/wofi", "/etc/skel/.config/nwg-look",
                 "/etc/skel/.local/share/nwg-look", "/etc/skel/.local/share", "/etc/skel/.local"]

# The packages that versions before DROPPED_SINCE depended on, and no longer.
DROPPED = ["git", "git-delta", "meld", "nwg-look", "pulseaudio-utils", "qt5-gtk-platformtheme",
           "qt6-gtk-platformtheme", "libglib2.0-bin"]
DROPPED_SINCE = "1.27~"

# The first version of hd-desktop that copies /etc/skel to the home directory of the user.
SKEL_SINCE = "0.3"

# The first version of hd-desktop with the settings of the Qt applications and of hyprtoolkit, and
# their paths in /etc/skel.
TOOLKITS_SINCE = "1.28~"
TOOLKITS_SKEL = [".config/qt5ct", ".config/qt6ct", ".config/hypr/hyprtoolkit.conf"]


def divert(path, diverted):
    """Diverts a file of another package to another name, unless hd-desktop already did."""
    owner = subprocess.run(["dpkg-divert", "--listpackage", path], capture_output=True,
                           text=True, check=True).stdout.strip()
    if owner == "hd-desktop":
        return
    subprocess.run(["dpkg-divert", "--package", "hd-desktop", "--add", "--rename", "--divert",
                    diverted, path], check=True)


def older_than(version, than):
    """True if the package version is older than the other one."""
    return subprocess.run(["dpkg", "--compare-versions", version, "lt", than]).returncode == 0


def copy_skel(paths=None):
    """Copies the files of /etc/skel that the user does not have to their home directory: all of
    them, or those below the paths, relative to /etc/skel. Returns the home directory, or None
    when there is no user to copy to."""
    user = subprocess.run(["/usr/sbin/hd-desktop-render", "--print-user"], capture_output=True,
                          text=True, check=True).stdout.strip()
    if user == "":
        print(f"No user to copy {SKEL_DIR} to.")
        return None
    home = pwd.getpwnam(user).pw_dir
    if not os.path.isdir(home):
        print(f"The home directory {home} of {user} does not exist; not copying {SKEL_DIR}.")
        return None
    if paths is None:
        subprocess.run(["runuser", "-u", user, "--", "cp", "-a", "--update=none",
                        SKEL_DIR + "/.", home + "/"], check=True)
        print(f"Copied the files of {SKEL_DIR} that {user} did not have to {home}.")
        return home
    for path in paths:
        target = os.path.dirname(os.path.join(home, path))
        subprocess.run(["runuser", "-u", user, "--", "mkdir", "-p", target], check=True)
        subprocess.run(["runuser", "-u", user, "--", "cp", "-a", "--update=none",
                        os.path.join(SKEL_DIR, path), target + "/"], check=True)
    print(f"Copied the files of {', '.join(paths)} in {SKEL_DIR} that {user} did not have to "
          f"{home}.")
    return home


def theme_selected():
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            config = json.load(f)
    except (FileNotFoundError, ValueError):
        return False
    if not isinstance(config, dict) or not isinstance(config.get(THEME_KEY), dict):
        return False
    return "name" in config[THEME_KEY]


def remove_obsolete_conffiles():
    for conffile, since in OBSOLETE_CONFFILES:
        subprocess.run(["dpkg-maintscript-helper", "rm_conffile", conffile, since,
                        "hd-desktop", "--", *sys.argv[1:]], check=True)


def remove_obsolete_dirs():
    for directory in OBSOLETE_DIRS:
        if os.path.isdir(directory) and not os.listdir(directory):
            os.rmdir(directory)


def main():
    remove_obsolete_conffiles()

    # configure is the only action that installs the package; the abort-* actions undo a
    # failed upgrade or removal.
    if len(sys.argv) < 2 or sys.argv[1] != "configure":
        return

    # The version that was configured before, empty on the first installation.
    previous = sys.argv[2] if len(sys.argv) > 2 else ""

    remove_obsolete_dirs()

    divert(GREETD_CONFIG, GREETD_CONFIG_DIVERTED)
    subprocess.run(["/usr/sbin/hd-desktop-render"], check=True)
    divert(PLYMOUTH_CONFIG, PLYMOUTH_CONFIG_DIVERTED)
    shutil.copyfile(HD_PLYMOUTH_CONFIG, PLYMOUTH_CONFIG)
    print(f"Made hyprdebian the theme of plymouth in {PLYMOUTH_CONFIG}.")
    # The system database local of /etc/dconf/profile/user holds the dark theme of
    # /etc/dconf/db/local.d.
    subprocess.run(["dconf", "update"], check=True)
    subprocess.run(["/usr/bin/hd-theme", "--cards"], check=True)
    if not theme_selected():
        subprocess.run(["/usr/bin/hd-theme", "--select", DEFAULT_THEME, "--no-initramfs"],
                       check=True)
    subprocess.run(["/usr/sbin/hd-plymouth-render"], check=True)
    if previous == "" or older_than(previous, SKEL_SINCE):
        copy_skel()
    elif older_than(previous, TOOLKITS_SINCE):
        home = copy_skel(TOOLKITS_SKEL)
        if home is not None:
            print(f"Set QT_QPA_PLATFORMTHEME to qt5ct instead of gtk3 in "
                  f"{home}/.config/hypr/hyprland.lua, and remove QT_STYLE_OVERRIDE, as in "
                  f"{SKEL_DIR}/.config/hypr/hyprland.lua, so that the Qt applications get the dark "
                  "theme.")
    if previous != "" and older_than(previous, DROPPED_SINCE):
        print(f"hd-desktop no longer depends on {', '.join(DROPPED)}. apt autoremove removes "
              "them; mark the ones you use as installed by hand first, such as apt-mark manual "
              "git.")
    if subprocess.run(["/usr/bin/hd-launcher-cache", "--update-all"]).returncode != 0:
        print("Could not write the menu of the launcher.", file=sys.stderr)
    if not os.path.isdir("/run/systemd/system"):
        return
    subprocess.run(["systemctl", "daemon-reload"], check=True)


if __name__ == "__main__":
    main()
