#!/usr/bin/env bash
set -euo pipefail

# The menu of hd-menu: No, selected, and Yes, with a cross and a check mark
# of the Nerd Font. hd-menu prints the value of the option chosen, and exits
# with 1 when the menu is closed without a choice.
MENU='{"banner": "Reboot system?", "options": [{"label": "\uf00d  No", "value": "No", "default": true}, {"label": "\uf00c  Yes", "value": "Yes"}]}'

CONFIRM=$(echo "$MENU" | hd-menu)

if [[ "$CONFIRM" == "Yes" ]]; then
    hd-reboot
fi
