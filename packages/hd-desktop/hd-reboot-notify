#!/usr/bin/python3
"""Shows a notification that the system needs a reboot, with the reasons of hd-reboot-check.

The package hd-desktop installs this as /usr/libexec/hd-desktop/hd-reboot-notify, and
hd-reboot-notify.service runs it in the desktop session when /run/reboot-required exists. mako
may not be running yet at the start of the session, so the notification is tried again for a
while.
"""

import argparse
import subprocess
import sys
import time

ICON = "/usr/share/hd-desktop/icons/warning.svg"
TRIES = 10
WAIT = 3


def reasons():
    result = subprocess.run(["hd-reboot-check"], capture_output=True, text=True)
    return result.stdout.splitlines()


def notify(found):
    for _ in range(TRIES):
        result = subprocess.run(["notify-send", "--app-name=HyprDebian", f"--icon={ICON}",
                                 "--urgency=critical", "Reboot needed", "\n".join(found)],
                                capture_output=True, text=True)
        if result.returncode == 0:
            return
        time.sleep(WAIT)
    print(f"Could not show the notification: {result.stderr.strip()}", file=sys.stderr)


def main():
    argparse.ArgumentParser(
        description="Show a notification that the system needs a reboot.").parse_args()

    found = reasons()
    if found:
        notify(found)


if __name__ == "__main__":
    main()
