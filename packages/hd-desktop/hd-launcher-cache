#!/usr/bin/python3
"""Writes the menu of the application launcher of the HyprDebian desktop, the input of hd-menu,
and prints it for the launcher.

The package hd-desktop installs this as /usr/bin/hd-launcher-cache. Its apt hook,
/etc/apt/apt.conf.d/90hd-launcher, runs it as root with --update-all each time apt has run dpkg, so
the menus of the system and of the users follow the applications that are installed, upgraded and
removed.

    hd-launcher-cache                print the menu for hd-menu
    hd-launcher-cache --update       write the menu and its icons in the cache
    hd-launcher-cache --update-all   as root: write the cache of the system and of every user in
                                     the group users
    hd-launcher-cache --dry-run      print the menu that --update would write, write nothing

Who runs it decides which settings and which cache it uses. Root uses the configuration of the
system, /etc/hyprdebian/config.json, and the cache of the system, /var/cache/hd-launcher. Any other
user uses their own configuration, ~/.config/hyprdebian/config.json, for each key that it has, and
the configuration of the system for the others, and their own cache, ~/.cache/hd-launcher.
--update-all runs --update as root and then, with runuser, as each user whose primary or
supplementary group is users and whose home directory exists, so each cache belongs to its user and
is made from the settings of that user. A user whose cache cannot be written is reported, and the
others are still written.

Without arguments, it prints the menu in the cache of the user, else the one in the cache of the
system, else a menu with the single option "No cache" and a warning icon, which does nothing. The
key binding of the launcher in hyprland.lua pipes it into hd-menu.

The applications are the .desktop files in /usr/share/applications and its subdirectories, of the
type Application, that are not hidden, not left out for Hyprland by OnlyShowIn or NotShowIn, and
whose TryExec, when they have one, is installed. The key hd-launcher of the configuration leaves out
applications and adds items of its own:

    "hd-launcher": {
        "exclude": ["org.gnome.Meld.desktop", "debian-xterm"],
        "add": [
            {"name": "Btop", "command": ["kitty", "-e", "btop"], "icon": "utilities-system-monitor"}
        ]
    }

exclude is a list of desktop file IDs, such as "org.gnome.Settings.desktop"; the .desktop at the
end may be left out. add is a list of items, each with a name, the label, a command, a list of the
words of the command, run without a shell, and optionally an icon, the path of a PNG or SVG or the
name of an icon, looked up as the Icon of a .desktop file. Both are optional.

The menu is 40% of the width and the height of the output. Every application and every item added
is an option of it, with its Name or name as the label. The value is the command line that starts
it, which the launcher runs with sh -c: "uwsm app -- <ID>" for an application and
"uwsm app -- <command>" for an item added, quoted for the shell. The options are sorted on the
label, in ascending order, without regard to case. The icon of an application is looked up by its
Icon in the icon themes hicolor and Adwaita and in /usr/share/pixmaps, or taken from its path when it
is one. A PNG is used as it is; an SVG is rendered to a PNG of the icon_size of the hd-theme in
icons/ of the cache, only when the PNG there was not rendered from that SVG at that size. Icons of
applications that are gone are removed. The key hd-theme is looked up as the key hd-launcher.
"""

import argparse
import configparser
import grp
import json
import os
import pwd
import re
import shlex
import shutil
import subprocess
import sys

import cairo
import gi

gi.require_version("Rsvg", "2.0")
from gi.repository import GLib, Rsvg  # noqa: E402

SYSTEM_CONFIG = "/etc/hyprdebian/config.json"
USER_CONFIG = ".config/hyprdebian/config.json"
CONFIG_KEY = "hd-launcher"
THEME_KEY = "hd-theme"
APPLICATIONS = "/usr/share/applications"
SYSTEM_CACHE = "/var/cache/hd-launcher"
USER_CACHE = ".cache/hd-launcher"
MENU_FILE = "launcher.json"
# The users whose caches --update-all writes: the members of this group.
USERS_GROUP = "users"
COMMAND = "/usr/bin/hd-launcher-cache"
# The icon of the menu without a cache.
WARNING_ICON = "/usr/share/hd-desktop/icons/warning.svg"
ICON_THEMES = ["/usr/share/icons/hicolor", "/usr/share/icons/Adwaita"]
PIXMAPS = "/usr/share/pixmaps"
BANNER = "Applications"
# The size of the menu, as a percentage of the output.
WIDTH = "40%"
HEIGHT = "40%"

# The default of hd-menu when the theme has no icon_size.
ICON_SIZE = 64

# The desktop of OnlyShowIn and NotShowIn, as uwsm sets XDG_CURRENT_DESKTOP.
DESKTOP = "Hyprland"

# Starts an application or a command as a systemd user unit of its own.
UWSM_APP = ["uwsm", "app", "--"]

# The members of the key hd-launcher, and of an item of add.
SETTINGS = ["exclude", "add"]
ITEM_MEMBERS = ["name", "command", "icon"]


def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def warn(message):
    print(f"Warning: {message}", file=sys.stderr)


def is_root():
    return os.geteuid() == 0


def home():
    return pwd.getpwuid(os.getuid()).pw_dir


def config_files():
    """The configurations in which a key is looked up, first to last: for root the one of the
    system, for other users their own and then the one of the system."""
    if is_root():
        return [SYSTEM_CONFIG]
    return [os.path.join(home(), USER_CONFIG), SYSTEM_CONFIG]


def cache_dirs():
    """The caches in which the menu is looked up, first to last; the first is the one that
    --update writes."""
    if is_root():
        return [SYSTEM_CACHE]
    return [os.path.join(home(), USER_CACHE), SYSTEM_CACHE]


def load_config(path):
    if not os.path.exists(path):
        return {}
    try:
        with open(path, encoding="utf-8") as f:
            config = json.load(f)
    except (OSError, ValueError) as e:
        fail(f"Cannot read {path}: {e}")
    if not isinstance(config, dict):
        fail(f"{path} does not hold a JSON object.")
    return config


def lookup(key, default):
    """The value of a key in the first configuration that has it, and the path of that
    configuration; the default and None when none has it."""
    for path in config_files():
        config = load_config(path)
        if key in config:
            return config[key], path
    return default, None


def is_text(value):
    return isinstance(value, str) and value != ""


def check_item(item, where):
    """Fails when an item of add is not valid."""
    if not isinstance(item, dict):
        fail(f"{where} is not a JSON object.")
    unknown = [k for k in item if k not in ITEM_MEMBERS]
    if unknown:
        fail(f"{where} has unknown members {', '.join(unknown)}.")
    if not is_text(item.get("name")):
        fail(f"{where} has no name.")
    command = item.get("command")
    if not isinstance(command, list) or command == [] or not all(is_text(w) for w in command):
        fail(f"{where} has no command, a list of the words of the command.")
    if "icon" in item and not is_text(item["icon"]):
        fail(f"The icon of {where} is not a path or the name of an icon.")


def launcher_settings():
    """The desktop file IDs to leave out, with .desktop at the end, and the items to add."""
    settings, source = lookup(CONFIG_KEY, {})
    where = f"the key {CONFIG_KEY} of {source}"
    if not isinstance(settings, dict):
        fail(f"The key {CONFIG_KEY} of {source} is not a JSON object with exclude and add.")
    unknown = [k for k in settings if k not in SETTINGS]
    if unknown:
        fail(f"The key {CONFIG_KEY} of {source} has unknown members {', '.join(unknown)}.")
    excluded = settings.get("exclude", [])
    if not isinstance(excluded, list) or not all(is_text(e) for e in excluded):
        fail(f"The exclude of {where} is not a list of desktop file IDs.")
    added = settings.get("add", [])
    if not isinstance(added, list):
        fail(f"The add of {where} is not a list of items.")
    for number, item in enumerate(added, 1):
        check_item(item, f"Item {number} of the add of {where}")

    ids = set()
    for entry in excluded:
        if entry.endswith(".desktop"):
            ids.add(entry)
        else:
            ids.add(entry + ".desktop")
    return ids, added


def icon_size():
    theme, _ = lookup(THEME_KEY, None)
    if not isinstance(theme, dict):
        return ICON_SIZE
    size = theme.get("icon_size")
    if not isinstance(size, int) or isinstance(size, bool) or size <= 0:
        return ICON_SIZE
    return size


def desktop_files():
    """The desktop file IDs and paths of the .desktop files in APPLICATIONS. The ID of a file in a
    subdirectory is its path below APPLICATIONS with - for /."""
    files = []
    for root, _, names in os.walk(APPLICATIONS):
        for name in names:
            if not name.endswith(".desktop"):
                continue
            path = os.path.join(root, name)
            files.append((os.path.relpath(path, APPLICATIONS).replace("/", "-"), path))
    return files


def read_entry(path):
    """The keys of the group Desktop Entry of a .desktop file, or None when it cannot be read."""
    parser = configparser.ConfigParser(interpolation=None, strict=False,
                                       delimiters=("=",), comment_prefixes=("#",))
    # The keys are case sensitive.
    parser.optionxform = str
    try:
        with open(path, encoding="utf-8") as f:
            parser.read_file(f)
    except (OSError, UnicodeDecodeError, configparser.Error) as e:
        warn(f"Cannot read {path}: {e}")
        return None
    if not parser.has_section("Desktop Entry"):
        return None
    return parser["Desktop Entry"]


def is_true(entry, key):
    return entry.get(key, "false").strip() == "true"


def desktops(entry, key):
    return [d for d in entry.get(key, "").split(";") if d != ""]


def shown(entry):
    """True when the entry is an application that the launcher shows."""
    if entry.get("Type") != "Application":
        return False
    if entry.get("Name", "") == "" or entry.get("Exec", "") == "":
        return False
    if is_true(entry, "NoDisplay") or is_true(entry, "Hidden"):
        return False
    only = desktops(entry, "OnlyShowIn")
    if only and DESKTOP not in only:
        return False
    if DESKTOP in desktops(entry, "NotShowIn"):
        return False
    try_exec = entry.get("TryExec", "")
    if try_exec != "" and shutil.which(try_exec) is None:
        return False
    return True


def theme_icons(theme, name):
    """The PNG and SVG files of an icon in an icon theme, as (size, path), with size None for an
    SVG."""
    found = []
    try:
        size_dirs = os.listdir(theme)
    except FileNotFoundError:
        return found
    for size_dir in size_dirs:
        # Symbolic icons are monochrome, for small sizes only.
        if "symbolic" in size_dir:
            continue
        try:
            contexts = os.listdir(os.path.join(theme, size_dir))
        except NotADirectoryError:
            continue
        # Most icons of applications are in apps, but an Icon may name one of any context, such
        # as printer in devices.
        for context in contexts:
            directory = os.path.join(theme, size_dir, context)
            png = os.path.join(directory, name + ".png")
            svg = os.path.join(directory, name + ".svg")
            if os.path.isfile(png):
                size = size_dir.split("@")[0].split("x")[0]
                if size.isdigit():
                    found.append((int(size), png))
            if os.path.isfile(svg):
                found.append((None, svg))
    return found


def best_icon(icons, size):
    """The best of the icons of a theme for size: the smallest PNG at least that large, else an
    SVG, else the largest PNG."""
    pngs = sorted((s, p) for s, p in icons if s is not None)
    svgs = sorted(p for s, p in icons if s is None)
    larger = [p for s, p in pngs if s >= size]
    if larger:
        return larger[0]
    if svgs:
        return svgs[0]
    if pngs:
        return pngs[-1][1]
    return None


def find_icon(icon, size):
    """The PNG or SVG file of the Icon of an entry, or None."""
    if icon == "":
        return None
    if os.path.isabs(icon):
        if os.path.isfile(icon) and icon.endswith((".png", ".svg", ".svgz")):
            return icon
        return None
    for theme in ICON_THEMES:
        path = best_icon(theme_icons(theme, icon), size)
        if path is not None:
            return path
    for extension in (".png", ".svg"):
        path = os.path.join(PIXMAPS, icon + extension)
        if os.path.isfile(path):
            return path
    return None


def png_size(path):
    """The width and height of a PNG, or None when it cannot be read."""
    try:
        surface = cairo.ImageSurface.create_from_png(path)
    except (OSError, cairo.Error, MemoryError):
        return None
    return surface.get_width(), surface.get_height()


def up_to_date(svg, png, size):
    """True when the PNG was rendered from this SVG at size: render_svg gives the PNG the
    modification time of the SVG. dpkg gives files the time of the package, so a newer SVG can
    have an older time; only the same time counts."""
    if not os.path.exists(png):
        return False
    if os.stat(png).st_mtime_ns != os.stat(svg).st_mtime_ns:
        return False
    return png_size(png) == (size, size)


def render_svg(svg, png, size):
    """Renders an SVG into a PNG of size by size, fitted and centred; False when it fails."""
    try:
        handle = Rsvg.Handle.new_from_file(svg)
    except GLib.Error as e:
        warn(f"Cannot read {svg}: {e.message}")
        return False
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    context = cairo.Context(surface)
    viewport = Rsvg.Rectangle()
    viewport.x = 0
    viewport.y = 0
    viewport.width = size
    viewport.height = size
    try:
        handle.render_document(context, viewport)
    except GLib.Error as e:
        warn(f"Cannot render {svg}: {e.message}")
        return False
    tmp = png + ".tmp"
    surface.write_to_png(tmp)
    os.chmod(tmp, 0o644)
    mtime = os.stat(svg).st_mtime_ns
    os.utime(tmp, ns=(mtime, mtime))
    os.replace(tmp, png)
    return True


def menu_icon(name, source, size, icon_dir, dry_run):
    """The path of the icon that the menu shows for an option, or None. An SVG is rendered to
    <name>.png in icon_dir, unless dry_run."""
    if source is None:
        return None
    if source.endswith(".png"):
        return source
    png = os.path.join(icon_dir, name + ".png")
    if dry_run or up_to_date(source, png, size):
        return png
    if not render_svg(source, png, size):
        return None
    return png


def option(label, command, icon):
    """An option of the menu. Its value is the command line that starts the command with uwsm
    app."""
    result = {"label": label, "value": shlex.join(UWSM_APP + command)}
    if icon is not None:
        result["icon"] = icon
    return result


def added_icon_name(number, name):
    """The name of the rendered icon of an item of add: add-<number>-<name>, with - for anything
    but letters and digits, apart from the icons of the applications."""
    return f"add-{number}-" + re.sub(r"[^A-Za-z0-9]+", "-", name).strip("-").lower()


def build_menu(icon_dir, dry_run):
    """The menu of hd-menu, and the PNGs in icon_dir that it uses."""
    excluded, added = launcher_settings()
    size = icon_size()
    if not dry_run:
        os.makedirs(icon_dir, mode=0o755, exist_ok=True)

    options = []
    for desktop_id, path in desktop_files():
        if desktop_id in excluded:
            continue
        entry = read_entry(path)
        if entry is None or not shown(entry):
            continue
        icon = menu_icon(desktop_id[:-len(".desktop")], find_icon(entry.get("Icon", ""), size),
                         size, icon_dir, dry_run)
        options.append(option(entry["Name"], [desktop_id], icon))
    for number, item in enumerate(added, 1):
        source = find_icon(item.get("icon", ""), size)
        if "icon" in item and source is None:
            warn(f"There is no PNG or SVG icon {item['icon']} for {item['name']}.")
        icon = menu_icon(added_icon_name(number, item["name"]), source, size, icon_dir, dry_run)
        options.append(option(item["name"], item["command"], icon))
    options.sort(key=lambda o: (o["label"].casefold(), o["label"], o["value"]))
    used = {o["icon"] for o in options if o.get("icon", "").startswith(icon_dir + "/")}
    return {"banner": BANNER, "width": WIDTH, "height": HEIGHT, "options": options}, used


def remove_unused(icon_dir, used):
    """Removes the PNGs in icon_dir of applications that are gone or left out."""
    for name in os.listdir(icon_dir):
        path = os.path.join(icon_dir, name)
        if path not in used:
            os.remove(path)


def write_json(path, value):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(value, f, indent=4, ensure_ascii=False)
        f.write("\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def print_menu(menu):
    json.dump(menu, sys.stdout, indent=4, ensure_ascii=False)
    print()


def show():
    """Prints the menu of the first cache that has one, else the menu without a cache."""
    for cache in cache_dirs():
        try:
            with open(os.path.join(cache, MENU_FILE), encoding="utf-8") as f:
                text = f.read()
        except FileNotFoundError:
            continue
        except (OSError, UnicodeDecodeError) as e:
            warn(f"Cannot read {os.path.join(cache, MENU_FILE)}: {e}")
            continue
        sys.stdout.write(text)
        return
    # The launcher runs the value with sh -c; true does nothing.
    print_menu({"banner": BANNER, "options": [
        {"label": "No cache", "value": "true", "icon": WARNING_ICON}]})


def update(dry_run):
    """Writes the menu and its icons in the cache of whoever runs this, or prints it."""
    cache = cache_dirs()[0]
    icon_dir = os.path.join(cache, "icons")
    menu, used = build_menu(icon_dir, dry_run)
    if dry_run:
        print_menu(menu)
        return

    remove_unused(icon_dir, used)
    launcher = os.path.join(cache, MENU_FILE)
    write_json(launcher, menu)
    print(f"hd-launcher-cache: wrote {launcher} with {len(menu['options'])} applications.")


def group_users():
    """The users whose primary or supplementary group is USERS_GROUP, sorted, as pwd entries."""
    try:
        group = grp.getgrnam(USERS_GROUP)
    except KeyError:
        return []
    members = set(group.gr_mem)
    users = {}
    for user in pwd.getpwall():
        if user.pw_gid == group.gr_gid or user.pw_name in members:
            users[user.pw_name] = user
    return [users[name] for name in sorted(users)]


def update_all():
    """Writes the cache of the system, then that of every user in USERS_GROUP, as that user."""
    if not is_root():
        fail("hd-launcher-cache --update-all is run as root.")
    update(False)
    failed = []
    for user in group_users():
        if not os.path.isdir(user.pw_dir):
            warn(f"The home directory {user.pw_dir} of {user.pw_name} does not exist; its cache "
                 "is not written.")
            continue
        result = subprocess.run(["runuser", "-u", user.pw_name, "--", COMMAND, "--update"])
        if result.returncode != 0:
            failed.append(user.pw_name)
    if failed:
        fail(f"Could not write the cache of {', '.join(failed)}.")


def main():
    parser = argparse.ArgumentParser(
        description="Print the menu of the application launcher for hd-menu, from the cache of "
        f"the user or else of the system, or write it in the cache from the .desktop files in "
        f"{APPLICATIONS} and the key {CONFIG_KEY} of the configuration.")
    actions = parser.add_mutually_exclusive_group()
    actions.add_argument("-u", "--update", action="store_true",
                         help=f"write the menu and its icons in {cache_dirs()[0]}")
    actions.add_argument("-a", "--update-all", action="store_true",
                         help=f"as root: write the cache of the system and of every user in the "
                         f"group {USERS_GROUP}")
    actions.add_argument("-n", "--dry-run", action="store_true",
                         help="print the menu that --update would write, write nothing")
    args = parser.parse_args()

    if args.update_all:
        update_all()
    elif args.update or args.dry_run:
        update(args.dry_run)
    else:
        show()


if __name__ == "__main__":
    main()
