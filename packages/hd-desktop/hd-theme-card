#!/usr/bin/python3
"""Renders a HyprDebian theme into a card: a PNG that shows its colours, fonts, icons, geometry
and how a desktop looks in it.

The package hd-desktop installs this as /usr/bin/hd-theme-card. hd-theme renders the card of every
theme that it adds to /var/cache/hd-theme/cards/<name>.png with it.

    hd-theme-card <theme.json> <card.png>

The theme file is a theme of hd-theme, a JSON object with the members of the key hd-theme in
/etc/hyprdebian/config.json. It may also be that configuration itself, with its key hd-theme.
The name of the theme is its member name, else the file name without .json. The background of
the theme is taken from /usr/share/backgrounds/hyprdebian, the image that fits a screen of
1920x1080: the smallest of the family that covers it, else the largest.
"""

import argparse
import json
import math
import os
import re
import sys

import cairo
import gi

gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Pango, PangoCairo  # noqa: E402

BACKGROUNDS = "/usr/share/backgrounds/hyprdebian"
SCREEN = (1920, 1080)
WALL = None
DPI = 96

PAGE = "#f4f5f7"
INK = "#16181d"
MUTED = "#5b6270"
RULE = "#d5d8de"
CHROME = "JetBrainsMono NFM"
W, H = 1600, 3400
M = 64

T = {}


def pt(size):
    """Points to pixels at DPI."""
    return size * DPI / 72


def rgb(h, a=1.0):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)) + (a,)


def rrect(c, x, y, w, h, r):
    c.new_sub_path()
    c.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    c.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    c.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    c.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    c.close_path()


def text(c, x, y, s, px, color, font=None, align="left", width=None):
    lay = PangoCairo.create_layout(c)
    fd = Pango.FontDescription.from_string(font or CHROME)
    fd.set_absolute_size(px * Pango.SCALE)
    lay.set_font_description(fd)
    lay.set_text(s, -1)
    if width:
        lay.set_width(int(width * Pango.SCALE))
        lay.set_wrap(Pango.WrapMode.WORD)
    tw, th = lay.get_pixel_size()
    if align == "center":
        x -= tw / 2
    elif align == "right":
        x -= tw
    c.set_source_rgba(*rgb(color))
    c.move_to(x, y)
    PangoCairo.show_layout(c, lay)
    return tw, th


def ttext(c, x, y, s, size, **kw):
    """Text in the theme font, size in points, colour light."""
    return text(c, x, y, s, pt(T[f"font-size-{size}"]), kw.pop("color", T["light"]), font=T["font"], **kw)


def find_background(family, screen):
    """The image of family that best fits screen: the smallest that covers it, else the largest."""
    found = []
    for name in os.listdir(BACKGROUNDS):
        m = re.fullmatch(re.escape(family) + r"-(\d+)x(\d+)\.png", name)
        if m:
            found.append((int(m[1]), int(m[2]), os.path.join(BACKGROUNDS, name)))
    if not found:
        fail(f"There is no background {family} in {BACKGROUNDS}.")
    covering = [f for f in found if f[0] >= screen[0] and f[1] >= screen[1]]
    if covering:
        return min(covering, key=lambda f: f[0] * f[1])
    return max(found, key=lambda f: f[0] * f[1])


def wallpaper(c, x, y, w, h, r):
    img = cairo.ImageSurface.create_from_png(WALL)
    c.save()
    rrect(c, x, y, w, h, r)
    c.clip()
    s = max(w / img.get_width(), h / img.get_height())
    c.translate(x, y)
    c.scale(s, s)
    c.set_source_surface(img, 0, 0)
    c.paint()
    c.restore()


def themed_window(c, x, y, w, h, edge):
    b, r = T["border"], T["radius"]
    c.set_source_rgba(*rgb(T["dark"], T["opacity"]))
    rrect(c, x + b, y + b, w - 2 * b, h - 2 * b, r - b)
    c.fill()
    c.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
    rrect(c, x, y, w, h, r)
    rrect(c, x + b, y + b, w - 2 * b, h - 2 * b, r - b)
    c.set_source_rgba(*rgb(edge))
    c.fill()
    c.set_fill_rule(cairo.FILL_RULE_WINDING)


def section(c, y, title):
    text(c, M, y, title, 22, INK)
    c.set_source_rgba(*rgb(RULE))
    c.rectangle(M, y + 36, W - 2 * M, 1)
    c.fill()
    return y + 60


def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def load_theme(path):
    """The theme in the file, with its name."""
    try:
        with open(path, encoding="utf-8") as f:
            theme = json.load(f)
    except (OSError, ValueError) as e:
        fail(f"Cannot read {path}: {e}")
    if isinstance(theme, dict) and isinstance(theme.get("hd-theme"), dict):
        theme = theme["hd-theme"]
    if not isinstance(theme, dict):
        fail(f"{path} does not hold a JSON object.")
    missing = [k for k in ("font", "font-size-big", "font-size-normal", "font-size-small",
                           "highlight", "normal", "dark", "light", "border", "radius", "gap",
                           "opacity", "icon_size", "background") if k not in theme]
    if missing:
        fail(f"The theme in {path} misses {', '.join(missing)}.")
    if "name" not in theme:
        name = os.path.basename(path)
        if name.endswith(".json"):
            name = name[:-len(".json")]
        theme = {"name": name, **theme}
    return theme


def main():
    ap = argparse.ArgumentParser(description="Render a HyprDebian theme into a card, a PNG.")
    ap.add_argument("theme", help="the theme file, a JSON object, or a config.json with the key "
                    "hd-theme")
    ap.add_argument("output", help="the PNG to write")
    a = ap.parse_args()
    T.update(load_theme(a.theme))
    global WALL
    bw, bh, WALL = find_background(T["background"], SCREEN)

    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
    c = cairo.Context(surf)
    c.set_source_rgba(*rgb(PAGE))
    c.paint()

    b, r = T["border"], T["radius"]
    ir = r - b
    pad = 6
    sizes = [(k, T[f"font-size-{k}"]) for k in ("big", "normal", "small")]

    # Header
    text(c, M, 52, f"HyprDebian theme {T['name']}", 40, INK)
    text(c, M, 104, f'hd-theme · name "{T["name"]}" · {T["font"]} · '
         + " / ".join(f"{k} {v}pt" for k, v in sizes)
         + f' · border {b} · radius {r} · gap {T["gap"]} · opacity {T["opacity"]}'
         + f' · icon_size {T["icon_size"]} · background "{T["background"]}"', 16, MUTED, width=W - 2 * M)
    text(c, M, 154, f"Background for a {SCREEN[0]}x{SCREEN[1]} screen: {WALL} "
         "(smallest image of the family that covers the screen, else the largest)", 14, MUTED)

    # Colours
    y = section(c, 200, "Colours")
    roles = [
        ("dark", T["dark"], "Background of bars, menus and windows. Drawn at opacity."),
        ("normal", T["normal"], "Selected item background. Unfocused borders, dividers."),
        ("highlight", T["highlight"], "Focus only: outline of the focused window or menu. Never a fill behind text."),
        ("light", T["light"], "All text, also on normal."),
    ]
    sw = (W - 2 * M - 3 * 24) / 4
    for i, (key, hx, role) in enumerate(roles):
        x = M + i * (sw + 24)
        c.set_source_rgba(*rgb(hx))
        rrect(c, x, y, sw, 120, r)
        c.fill()
        if key == "light":
            c.set_source_rgba(*rgb(RULE))
            c.set_line_width(1)
            rrect(c, x + 0.5, y + 0.5, sw - 1, 119, r)
            c.stroke()
        text(c, x, y + 136, key, 20, INK)
        text(c, x + sw, y + 138, hx.upper(), 18, MUTED, align="right")
        text(c, x, y + 168, role, 15, MUTED, width=sw)
    y += 250

    # Opacity
    text(c, M, y, f"dark at opacity {T['opacity']} over the background. "
         "Opacity applies to the background only: text and borders stay opaque.", 16, MUTED)
    y += 30
    wallpaper(c, M, y, W - 2 * M, 120, r)
    half = (W - 2 * M) / 2
    for i, op in enumerate((1.0, T["opacity"])):
        c.set_source_rgba(*rgb(T["dark"], op))
        rrect(c, M + i * half + 24, y + 20, half - 48, 80, r)
        c.fill()
        ttext(c, M + i * half + 48, y + 38, f"{T['dark']} · opacity {op}", "normal")
    y += 160

    # Typography
    y = section(c, y, "Typography")
    text(c, M, y, f"{T['font']}, in light on dark. Sizes are in points; "
         f"pixels shown at {DPI} dpi (1 pt = 4/3 px). This card is drawn 1:1 at {DPI} dpi.", 16, MUTED)
    y += 34
    samples = {
        "big": ["HyprDebian  Locked", "The quick brown fox jumps over the lazy dog."],
        "normal": ["The quick brown fox jumps over the lazy dog.",
                   "ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz",
                   " firefox   files   terminal   settings   power"],
        "small": ["The quick brown fox jumps over the lazy dog.",
                  "0123456789  0Oo il1| {} [] () <> != -> => == ~ @ # $ % &"],
    }
    for k, v in sizes:
        lh = pt(v) * 1.45
        bh = 28 + 34 + len(samples[k]) * lh + 16
        wallpaper(c, M, y, W - 2 * M, bh, r)
        c.set_source_rgba(*rgb(T["dark"], T["opacity"]))
        rrect(c, M, y, W - 2 * M, bh, r)
        c.fill()
        text(c, M + 24, y + 18, f"font-size-{k}  {v}pt = {round(pt(v))}px", 15, T["highlight"])
        for i, s in enumerate(samples[k]):
            ttext(c, M + 24, y + 52 + i * lh, s, k)
        y += bh + 16
    y += 30

    # Icons
    y = section(c, y, "Icons")
    isz = T["icon_size"]
    text(c, M, y, f"icon_size {isz}px. Placeholders: Nerd Font glyphs in light, centred in an icon_size square.", 16, MUTED)
    y += 34
    bh = isz + 40
    wallpaper(c, M, y, W - 2 * M, bh, r)
    c.set_source_rgba(*rgb(T["dark"], T["opacity"]))
    rrect(c, M, y, W - 2 * M, bh, r)
    c.fill()
    icons = [("\uf269", "firefox"), ("\uf07b", "files"), ("\uf120", "terminal"), ("\uf013", "settings"), ("\uf011", "power")]
    for i, (ic, label) in enumerate(icons):
        ix = M + 24 + i * (isz + 200)
        c.set_source_rgba(*rgb(T["light"], 0.12))
        rrect(c, ix, y + 20, isz, isz, ir)
        c.fill()
        text(c, ix + isz / 2, y + 20 + isz * 0.15, ic, isz * 0.6, T["light"], font=T["font"], align="center")
        ttext(c, ix + isz + 14, y + 20 + (isz - pt(T["font-size-small"]) * 1.3) / 2, label, "small")
    y += bh + 46

    # Geometry
    y = section(c, y, "Geometry")
    gy = y
    z = 9
    ox, oy = M + 40, gy + 30
    gw, gh = 640, 400
    c.save()
    c.rectangle(M, gy, gw, gh)
    c.clip()
    c.set_source_rgba(*rgb("#ffffff"))
    c.rectangle(M, gy, gw, gh)
    c.fill()
    for i in range(0, gw, 16):
        for j in range(0, gh, 16):
            if (i // 16 + j // 16) % 2:
                c.set_source_rgba(*rgb("#e3e5ea"))
                c.rectangle(M + i, gy + j, 16, 16)
                c.fill()
    big = 2000
    c.set_source_rgba(*rgb(T["dark"], T["opacity"]))
    rrect(c, ox + b * z, oy + b * z, big, big, ir * z)
    c.fill()
    c.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
    rrect(c, ox, oy, big, big, r * z)
    rrect(c, ox + b * z, oy + b * z, big, big, ir * z)
    c.set_source_rgba(*rgb(T["highlight"]))
    c.fill()
    c.set_fill_rule(cairo.FILL_RULE_WINDING)
    sx, sy = ox + (b + pad) * z, oy + (b + pad) * z
    c.set_source_rgba(*rgb(T["normal"]))
    rrect(c, sx, sy, big, 34 * z, ir * z)
    c.fill()
    text(c, sx + 40, sy + 130, "files", 40, T["light"], font=T["font"])
    c.set_line_width(2)
    c.set_dash([6, 6])
    c.set_source_rgba(*rgb(INK))
    c.move_to(ox, oy + r * z)
    c.line_to(ox + r * z, oy + r * z)
    c.line_to(ox + r * z, oy)
    c.stroke()
    c.set_source_rgba(*rgb(T["light"]))
    c.move_to(sx, sy + ir * z)
    c.line_to(sx + ir * z, sy + ir * z)
    c.line_to(sx + ir * z, sy)
    c.stroke()
    c.set_dash([])
    text(c, ox + r * z + 10, oy + 6, f"radius {r}", 18, INK)
    text(c, sx + ir * z + 10, sy + ir * z - 26, f"inner radius {ir}", 18, T["light"])
    c.restore()
    text(c, M + 8, gy + gh + 4, f"Top-left corner of a menu, zoomed {z}×. Checker = transparent.", 14, MUTED)

    nx = M + gw + 50
    notes = [
        ("border", f"{b}px", "Window and menu outline. highlight when focused, normal otherwise."),
        ("radius", f"{r}px", "Outer corner of windows and menus. The border follows the curve; "
         "the corner outside it is transparent and antialiased."),
        ("inner radius", f"{ir}px", "radius − border. Anything drawn inside the border, like the selected row, "
         "uses this radius so it follows the outer curve."),
        ("padding", f"{pad}px", "Between the inner edge of the border and the rows, so the rounded selection is not clipped."),
        ("divider", "1px", "In normal, between a menu's banner and its rows."),
        ("gap", f"{T['gap']}px", "Between windows."),
    ]
    ny = gy
    for k, v, d in notes:
        text(c, nx, ny, k, 18, INK)
        text(c, nx + 160, ny, v, 18, T["highlight"])
        _, th = text(c, nx + 240, ny + 2, d, 15, MUTED, width=W - M - nx - 240)
        ny += max(th, 24) + 22
    y = gy + gh + 50

    # In use
    y = section(c, y, "In use")
    ex_h = 540
    wallpaper(c, M, y, W - 2 * M, ex_h, r)
    g = T["gap"]
    tx, ty, tw, th = M + 40, y + 40, 560, ex_h - 80
    top_h = (th - g) // 2
    themed_window(c, tx, ty, tw, top_h, T["normal"])
    themed_window(c, tx, ty + top_h + g, tw, th - top_h - g, T["normal"])
    ttext(c, tx + 24, ty + 20, "~ $ hd-config-update", "small")
    ttext(c, tx + 24, ty + 20 + pt(T["font-size-small"]) * 1.45, "~ $", "small")
    ttext(c, tx + 24, ty + top_h + g + 20, "~ $", "small")
    text(c, tx + 24, ty + top_h - 36, "unfocused windows: border normal", 14, T["light"])
    c.set_source_rgba(*rgb(T["highlight"]))
    c.set_line_width(2)
    c.move_to(tx + tw + 10, ty + top_h + g / 2)
    c.line_to(tx + tw + 34, ty + top_h + g / 2)
    c.stroke()
    text(c, tx + tw + 40, ty + top_h + g / 2 - 10, f"gap {g}", 14, T["highlight"])

    rows = [("", "firefox"), ("", "files"), ("", "terminal"), ("", "settings")]
    row_h = round(pt(T["font-size-normal"]) * 1.5)
    banner_h = round(pt(T["font-size-big"]) * 1.6)
    mx, my, mw = M + 700, y + 40, 460
    mh = b + pad + banner_h + 1 + pad + len(rows) * row_h + pad + b
    themed_window(c, mx, my, mw, mh, T["highlight"])
    ttext(c, mx + b + pad + 14, my + b + pad + (banner_h - pt(T["font-size-big"]) * 1.3) / 2, "Run", "big")
    c.set_source_rgba(*rgb(T["normal"]))
    c.rectangle(mx + b, my + b + pad + banner_h, mw - 2 * b, 1)
    c.fill()
    ry = my + b + pad + banner_h + 1 + pad
    for i, (ic, label) in enumerate(rows):
        if i == 1:
            c.set_source_rgba(*rgb(T["normal"]))
            rrect(c, mx + b + pad, ry, mw - 2 * (b + pad), row_h, ir)
            c.fill()
        ty_ = ry + (row_h - pt(T["font-size-normal"]) * 1.3) / 2
        ttext(c, mx + b + pad + 14, ty_, ic, "normal")
        ttext(c, mx + b + pad + 14 + pt(T["font-size-normal"]) * 1.6, ty_, label, "normal")
        ry += row_h
    text(c, mx, my + mh + 12, "focused menu: border highlight, banner big,", 14, T["light"])
    text(c, mx, my + mh + 32, f"rows normal, selected row normal with inner radius {ir}", 14, T["light"])

    px, py = M + 1210, y + 40
    pw, ph = 56, round(pt(T["font-size-small"]) * 1.7)
    for i in range(3):
        bx = px + i * (pw + 10)
        if i == 0:
            c.set_source_rgba(*rgb(T["normal"]))
            rrect(c, bx, py, pw, ph, ir)
            c.fill()
            c.set_source_rgba(*rgb(T["highlight"]))
            c.set_line_width(2)
            rrect(c, bx + 1, py + 1, pw - 2, ph - 2, ir)
            c.stroke()
        else:
            c.set_source_rgba(*rgb(T["dark"], T["opacity"]))
            rrect(c, bx, py, pw, ph, ir)
            c.fill()
        ttext(c, bx + pw / 2, py + (ph - pt(T["font-size-small"]) * 1.3) / 2, str(i + 1), "small", align="center")
    text(c, px, py + ph + 12, "workspaces: small,", 14, T["light"])
    text(c, px, py + ph + 32, "current normal + highlight", 14, T["light"])
    y += ex_h + 40

    # Config
    y = section(c, y, f"Configuration · the theme {T['name']}, "
                "as hd-theme in /etc/hyprdebian/config.json")
    js = json.dumps(T, indent=4)
    _, th = text(c, M, y, js, 15, INK)
    y += th + M

    crop = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, int(y))
    cc = cairo.Context(crop)
    cc.set_source_surface(surf, 0, 0)
    cc.paint()
    crop.write_to_png(a.output)


if __name__ == "__main__":
    main()
