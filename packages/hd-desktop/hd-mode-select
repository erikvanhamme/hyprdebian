#!/usr/bin/env bash

set -euo pipefail

# Prints the JSON of an hd-menu with the banner $1 and the lines of $2 as
# options, with the line $3 selected when it is one of them.
menu_json() {
    jq -Rn --arg banner "$1" --arg current "$3" \
        '{banner: $banner, options: [inputs | select(. != "") | {label: ., default: (. == $current)}]}' <<< "$2"
}

# 1. Fetch JSON info about active monitors
MONITORS_JSON=$(hyprctl monitors -j)

# Select target monitor
MONITOR_COUNT=$(echo "$MONITORS_JSON" | jq '. | length')

if [ "$MONITOR_COUNT" -eq 0 ]; then
    notify-send "Hyprland Monitor Selector" "No active monitors found."
    exit 1
elif [ "$MONITOR_COUNT" -eq 1 ]; then
    TARGET_MONITOR=$(echo "$MONITORS_JSON" | jq -r '.[0].name')
else
    MONITOR_NAMES=$(echo "$MONITORS_JSON" | jq -r '.[].name')
    FOCUSED_MONITOR=$(echo "$MONITORS_JSON" | jq -r '.[] | select(.focused) | .name')
    TARGET_MONITOR=$(menu_json "Select monitor" "$MONITOR_NAMES" "$FOCUSED_MONITOR" | hd-menu)
fi

[ -z "$TARGET_MONITOR" ] && exit 0

# 2. Extract available modes and the current mode for the selected monitor
AVAILABLE_MODES=$(echo "$MONITORS_JSON" | jq -r --arg mon "$TARGET_MONITOR" '
    .[] | select(.name == $mon) | .availableModes[]
' | sed -E 's/Hz$//' | sort -u)

if [ -z "$AVAILABLE_MODES" ]; then
    notify-send "Hyprland Monitor Selector" "Could not read modes for $TARGET_MONITOR"
    exit 1
fi

CURRENT_RES=$(echo "$MONITORS_JSON" | jq -r --arg mon "$TARGET_MONITOR" '.[] | select(.name == $mon) | "\(.width)x\(.height)"')
CURRENT_RATE=$(LC_NUMERIC=C printf '%.2f' "$(echo "$MONITORS_JSON" | jq -r --arg mon "$TARGET_MONITOR" '.[] | select(.name == $mon) | .refreshRate')")

# 3a. Select the resolution (e.g. "2560x1440")
RESOLUTIONS=$(echo "$AVAILABLE_MODES" | cut -d@ -f1 | sort -urV)
SELECTED_RES=$(menu_json "Resolution for $TARGET_MONITOR" "$RESOLUTIONS" "$CURRENT_RES" | hd-menu)

[ -z "$SELECTED_RES" ] && exit 0
echo "$RESOLUTIONS" | grep -Fxq "$SELECTED_RES" || exit 0

# 3b. Select the refresh rate supported at that resolution (e.g. "165.00Hz")
RATES=$(echo "$AVAILABLE_MODES" | awk -F@ -v res="$SELECTED_RES" '$1 == res { print $2 "Hz" }' | sort -urn)
SELECTED_RATE=$(menu_json "Refresh rate for $TARGET_MONITOR at $SELECTED_RES" "$RATES" "${CURRENT_RATE}Hz" | hd-menu)

[ -z "$SELECTED_RATE" ] && exit 0
echo "$RATES" | grep -Fxq "$SELECTED_RATE" || exit 0
SELECTED_RATE=${SELECTED_RATE%Hz}

# Nothing to do when the mode did not change
if [ "$SELECTED_RES" = "$CURRENT_RES" ] && [ "$SELECTED_RATE" = "$CURRENT_RATE" ]; then
    exit 0
fi

# Assemble the mode string (e.g. "2560x1440@165.00")
CLEAN_MODE="${SELECTED_RES}@${SELECTED_RATE}"

# 4. Read current position, scale and transform, so the mode change keeps them
POS_X=$(echo "$MONITORS_JSON" | jq -r --arg mon "$TARGET_MONITOR" '.[] | select(.name == $mon) | .x')
POS_Y=$(echo "$MONITORS_JSON" | jq -r --arg mon "$TARGET_MONITOR" '.[] | select(.name == $mon) | .y')
CURRENT_SCALE=$(echo "$MONITORS_JSON" | jq -r --arg mon "$TARGET_MONITOR" '.[] | select(.name == $mon) | .scale')
CURRENT_TRANSFORM=$(echo "$MONITORS_JSON" | jq -r --arg mon "$TARGET_MONITOR" '.[] | select(.name == $mon) | .transform')

# 5. Apply mode change using the Lua hl.monitor API via hyprctl eval
EVAL_CMD=$(printf 'hl.monitor({ output = "%s", mode = "%s", position = "%dx%d", scale = "%s", transform = %d })' \
    "$TARGET_MONITOR" "$CLEAN_MODE" "$POS_X" "$POS_Y" "$CURRENT_SCALE" "$CURRENT_TRANSFORM")

hyprctl eval "$EVAL_CMD"

notify-send "Display Updated" "${TARGET_MONITOR} set to ${CLEAN_MODE}"
