#!/usr/bin/env bash
set -euo pipefail

CURRENT_USER="$USER"

# Fetch unmounted physical block devices (excluding swap, optical drives, active mounts)
UNMOUNTED_DEVS=$(sudo lsblk -J -b -o NAME,PATH,FSTYPE,LABEL,UUID,MOUNTPOINTS,TYPE | jq -r '
    .blockdevices[]? | 
    recurse(.children[]?) | 
    select(.type == "part" or .type == "disk") | 
    select(.fstype != null and .fstype != "" and .fstype != "swap") | 
    select((.mountpoints | map(select(. != null)) | length) == 0) | 
    "\(.path)\t[\(.fstype)] \(.label // "No-Label") (\(.uuid // "No-UUID"))"
' 2>/dev/null || true)

# Fetch unmounted targets defined in /etc/fstab
UNMOUNTED_FSTAB=$(findmnt --fstab --real --noheadings -o SOURCE,TARGET | while read -r src tgt; do
    if ! findmnt --mountpoint "$tgt" >/dev/null 2>&1; then
        echo -e "${src}\t[fstab] -> ${tgt}"
    fi
done || true)

# Combine and deduplicate menu choices
COMBINED_LIST=$(echo -e "${UNMOUNTED_DEVS}\n${UNMOUNTED_FSTAB}" | sed '/^$/d' | sort -u)

if [[ -z "$COMBINED_LIST" ]]; then
    notify-send -a "Mount Menu" -u low "Mount Menu" "No unmounted block devices or fstab targets found."
    exit 0
fi

# Present options in hd-menu: each line is the device path/source string, a
# tab and its description. The label shows both; the value, which hd-menu
# prints, is the device.
MENU=$(jq -Rn --arg banner "Select device to mount" \
    '{banner: $banner, options: [inputs | select(. != "") | split("\t") | {label: "\(.[0])  \(.[1])", value: .[0]}]}' <<< "$COMBINED_LIST")
TARGET_DEV=$(echo "$MENU" | hd-menu)

if [[ -z "$TARGET_DEV" ]]; then
    exit 0
fi

# Execute mount helper with elevated privileges, and dispatch the outcome via mako.
# The result is tested in the if, so set -e does not end the script before a failure is shown.
if RESULT=$(sudo /usr/libexec/hd-desktop/hd-mount-helper mount "$TARGET_DEV" "$CURRENT_USER" 2>&1); then
    notify-send -a "Mount Menu" -u normal -i drive-harddisk "Mount Successful" "$RESULT"
else
    notify-send -a "Mount Menu" -u critical -i dialog-error "Mount Failed" "$RESULT"
fi
