#!/usr/bin/env bash
set -euo pipefail

CURRENT_USER="$USER"
STATE_FILE="/tmp/hd-mount_state_${CURRENT_USER}"

if [[ ! -f "$STATE_FILE" || ! -s "$STATE_FILE" ]]; then
    notify-send -a "Unmount Menu" -u low "Unmount Menu" "No active script-managed mounts found."
    exit 0
fi

# Build the lines of the menu from the active state tracking file: the device,
# a tab and where it is mounted
MENU_ITEMS=""
while IFS='|' read -r dev mp is_fstab; do
    if [[ -n "$dev" ]]; then
        if [[ "$is_fstab" -eq 1 ]]; then
            MENU_ITEMS+="${dev}\t[fstab] -> ${mp}\n"
        else
            MENU_ITEMS+="${dev}\tmounted on ${mp}\n"
        fi
    fi
done < "$STATE_FILE"

MENU_ITEMS=$(echo -e "$MENU_ITEMS" | sed '/^$/d')

if [[ -z "$MENU_ITEMS" ]]; then
    notify-send -a "Unmount Menu" -u low "Unmount Menu" "No active mounts recorded."
    exit 0
fi

# Present them in hd-menu. The label shows the whole line; the value, which
# hd-menu prints, is the device.
MENU=$(jq -Rn --arg banner "Select device to unmount" \
    '{banner: $banner, options: [inputs | select(. != "") | split("\t") | {label: "\(.[0])  \(.[1])", value: .[0]}]}' <<< "$MENU_ITEMS")
TARGET_DEV=$(echo "$MENU" | hd-menu)

if [[ -z "$TARGET_DEV" ]]; then
    exit 0
fi

# The result is tested in the if, so set -e does not end the script before a failure is shown.
if RESULT=$(sudo /usr/libexec/hd-desktop/hd-mount-helper unmount "$TARGET_DEV" "$CURRENT_USER" 2>&1); then
    notify-send -a "Unmount Menu" -u normal -i drive-harddisk "Unmount Successful" "$RESULT"
else
    notify-send -a "Unmount Menu" -u critical -i dialog-error "Unmount Failed" "$RESULT"
fi
