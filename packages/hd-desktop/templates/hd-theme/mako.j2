# The HyprDebian theme {{ name }}, written by hd-theme --apply from /etc/hyprdebian/config.json.
# Do not change this file: hd-theme --apply writes it again. Settings in the config of mako after
# the include take the place of these.
font={{ theme["font"] }} {{ theme["font-size-normal"] }}
text-color={{ theme["light"] }}
background-color={{ theme["dark"] }}{{ alpha }}
border-size={{ theme["border"] }}
border-color={{ theme["normal"] }}
border-radius={{ theme["radius"] }}
