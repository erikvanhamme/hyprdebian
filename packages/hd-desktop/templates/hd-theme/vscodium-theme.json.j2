// The HyprDebian theme {{ name }}, written by hd-theme --apply from /etc/hyprdebian/config.json.
// Do not change this file: hd-theme --apply writes it again. Colours in
// "workbench.colorCustomizations" of the settings of VSCodium take the place of these.
{% set dark = theme["dark"] %}
{% set light = theme["light"] %}
{% set normal = theme["normal"] %}
{% set highlight = theme["highlight"] %}
{
    "name": "HyprDebian",
    "type": "dark",
{% if vscodium_base %}
    // The colours of the syntax, and of what this file leaves out, are those of Dark+ of VSCodium.
    "include": "{{ vscodium_base }}",
{% endif %}
    "colors": {
        "foreground": "{{ light }}",
        "descriptionForeground": "{{ light }}b3",
        "icon.foreground": "{{ light }}",
        "focusBorder": "{{ highlight }}",
        "selection.background": "{{ normal }}",
        "widget.border": "{{ normal }}",
        "sash.hoverBorder": "{{ highlight }}",
        "textLink.foreground": "{{ highlight }}",
        "textLink.activeForeground": "{{ highlight }}",
        "progressBar.background": "{{ highlight }}",

        "button.background": "{{ normal }}",
        "button.foreground": "{{ light }}",
        "button.hoverBackground": "{{ highlight }}",
        "button.secondaryBackground": "{{ dark }}",
        "button.secondaryForeground": "{{ light }}",
        "button.secondaryHoverBackground": "{{ normal }}",
        "button.border": "{{ normal }}",
        "badge.background": "{{ highlight }}",
        "badge.foreground": "{{ dark }}",

        "input.background": "{{ dark }}",
        "input.foreground": "{{ light }}",
        "input.border": "{{ normal }}",
        "input.placeholderForeground": "{{ light }}80",
        "inputOption.activeBorder": "{{ highlight }}",
        "inputOption.activeBackground": "{{ normal }}80",
        "inputOption.activeForeground": "{{ light }}",
        "dropdown.background": "{{ dark }}",
        "dropdown.listBackground": "{{ dark }}",
        "dropdown.foreground": "{{ light }}",
        "dropdown.border": "{{ normal }}",
        "checkbox.background": "{{ dark }}",
        "checkbox.foreground": "{{ light }}",
        "checkbox.border": "{{ normal }}",

        "scrollbar.shadow": "#00000000",
        "scrollbarSlider.background": "{{ normal }}80",
        "scrollbarSlider.hoverBackground": "{{ normal }}b3",
        "scrollbarSlider.activeBackground": "{{ highlight }}b3",

        "list.activeSelectionBackground": "{{ normal }}",
        "list.activeSelectionForeground": "{{ light }}",
        "list.inactiveSelectionBackground": "{{ normal }}80",
        "list.inactiveSelectionForeground": "{{ light }}",
        "list.hoverBackground": "{{ normal }}4d",
        "list.hoverForeground": "{{ light }}",
        "list.focusOutline": "{{ highlight }}",
        "list.highlightForeground": "{{ highlight }}",
        "tree.indentGuidesStroke": "{{ normal }}",

        "titleBar.activeBackground": "{{ dark }}",
        "titleBar.activeForeground": "{{ light }}",
        "titleBar.inactiveBackground": "{{ dark }}",
        "titleBar.inactiveForeground": "{{ light }}80",
        "titleBar.border": "{{ normal }}",
        "commandCenter.background": "{{ dark }}",
        "commandCenter.foreground": "{{ light }}",
        "commandCenter.border": "{{ normal }}",
        "commandCenter.activeBackground": "{{ normal }}4d",
        "commandCenter.activeBorder": "{{ highlight }}",
        "menubar.selectionBackground": "{{ normal }}",
        "menubar.selectionForeground": "{{ light }}",
        "menu.background": "{{ dark }}",
        "menu.foreground": "{{ light }}",
        "menu.selectionBackground": "{{ normal }}",
        "menu.selectionForeground": "{{ light }}",
        "menu.separatorBackground": "{{ normal }}",
        "menu.border": "{{ normal }}",

        "activityBar.background": "{{ dark }}",
        "activityBar.foreground": "{{ light }}",
        "activityBar.inactiveForeground": "{{ light }}80",
        "activityBar.activeBorder": "{{ highlight }}",
        "activityBar.border": "{{ normal }}",
        "activityBarBadge.background": "{{ highlight }}",
        "activityBarBadge.foreground": "{{ dark }}",

        "sideBar.background": "{{ dark }}",
        "sideBar.foreground": "{{ light }}",
        "sideBar.border": "{{ normal }}",
        "sideBarTitle.foreground": "{{ light }}",
        "sideBarSectionHeader.background": "{{ dark }}",
        "sideBarSectionHeader.foreground": "{{ light }}",
        "sideBarSectionHeader.border": "{{ normal }}",

        "editorGroup.border": "{{ normal }}",
        "editorGroupHeader.tabsBackground": "{{ dark }}",
        "editorGroupHeader.noTabsBackground": "{{ dark }}",
        "tab.activeBackground": "{{ dark }}",
        "tab.activeForeground": "{{ light }}",
        "tab.activeBorderTop": "{{ highlight }}",
        "tab.inactiveBackground": "{{ dark }}",
        "tab.inactiveForeground": "{{ light }}80",
        "tab.unfocusedActiveBorderTop": "{{ normal }}",
        "tab.hoverBackground": "{{ normal }}4d",
        "tab.border": "{{ dark }}",
        "tab.lastPinnedBorder": "{{ normal }}",
        "breadcrumb.background": "{{ dark }}",
        "breadcrumb.foreground": "{{ light }}b3",
        "breadcrumb.focusForeground": "{{ light }}",
        "breadcrumb.activeSelectionForeground": "{{ highlight }}",

        "editor.background": "{{ dark }}",
        "editor.foreground": "{{ light }}",
        "editorCursor.foreground": "{{ highlight }}",
        "editor.lineHighlightBackground": "{{ normal }}26",
        "editor.lineHighlightBorder": "#00000000",
        "editor.selectionBackground": "{{ normal }}",
        "editor.inactiveSelectionBackground": "{{ normal }}80",
        "editor.selectionHighlightBackground": "{{ normal }}4d",
        "editor.wordHighlightBackground": "{{ normal }}4d",
        "editor.findMatchBackground": "{{ highlight }}66",
        "editor.findMatchBorder": "{{ highlight }}",
        "editor.findMatchHighlightBackground": "{{ normal }}80",
        "editorLineNumber.foreground": "{{ light }}66",
        "editorLineNumber.activeForeground": "{{ light }}",
        "editorIndentGuide.background1": "{{ normal }}66",
        "editorIndentGuide.activeBackground1": "{{ normal }}",
        "editorRuler.foreground": "{{ normal }}66",
        "editorWhitespace.foreground": "{{ light }}33",
        "editorBracketMatch.background": "{{ normal }}4d",
        "editorBracketMatch.border": "{{ highlight }}",
        "editorGutter.background": "{{ dark }}",
        "editorOverviewRuler.border": "{{ dark }}",
        "minimap.background": "{{ dark }}",
        "minimapSlider.background": "{{ normal }}4d",
        "minimapSlider.hoverBackground": "{{ normal }}80",
        "minimapSlider.activeBackground": "{{ normal }}b3",

        "editorWidget.background": "{{ dark }}",
        "editorWidget.foreground": "{{ light }}",
        "editorWidget.border": "{{ normal }}",
        "editorSuggestWidget.background": "{{ dark }}",
        "editorSuggestWidget.foreground": "{{ light }}",
        "editorSuggestWidget.border": "{{ normal }}",
        "editorSuggestWidget.selectedBackground": "{{ normal }}",
        "editorSuggestWidget.highlightForeground": "{{ highlight }}",
        "editorHoverWidget.background": "{{ dark }}",
        "editorHoverWidget.foreground": "{{ light }}",
        "editorHoverWidget.border": "{{ normal }}",
        "peekView.border": "{{ highlight }}",
        "peekViewTitle.background": "{{ dark }}",
        "peekViewEditor.background": "{{ dark }}",
        "peekViewResult.background": "{{ dark }}",
        "peekViewResult.selectionBackground": "{{ normal }}",

        "quickInput.background": "{{ dark }}",
        "quickInput.foreground": "{{ light }}",
        "quickInputList.focusBackground": "{{ normal }}",
        "quickInputList.focusForeground": "{{ light }}",
        "pickerGroup.foreground": "{{ highlight }}",
        "pickerGroup.border": "{{ normal }}",

        "panel.background": "{{ dark }}",
        "panel.border": "{{ normal }}",
        "panelTitle.activeForeground": "{{ light }}",
        "panelTitle.activeBorder": "{{ highlight }}",
        "panelTitle.inactiveForeground": "{{ light }}80",
        "terminal.background": "{{ dark }}",
        "terminal.foreground": "{{ light }}",
        "terminal.border": "{{ normal }}",
        "terminal.selectionBackground": "{{ normal }}",
        "terminal.inactiveSelectionBackground": "{{ normal }}80",
        "terminalCursor.foreground": "{{ highlight }}",

        "statusBar.background": "{{ dark }}",
        "statusBar.foreground": "{{ light }}",
        "statusBar.border": "{{ normal }}",
        "statusBar.noFolderBackground": "{{ dark }}",
        "statusBar.debuggingBackground": "{{ normal }}",
        "statusBar.debuggingForeground": "{{ light }}",
        "statusBarItem.hoverBackground": "{{ normal }}80",
        "statusBarItem.remoteBackground": "{{ normal }}",
        "statusBarItem.remoteForeground": "{{ light }}",

        "notifications.background": "{{ dark }}",
        "notifications.foreground": "{{ light }}",
        "notifications.border": "{{ normal }}",
        "notificationCenterHeader.background": "{{ dark }}",
        "notificationCenterHeader.foreground": "{{ light }}",
        "notificationToast.border": "{{ normal }}",
        "settings.headerForeground": "{{ light }}",
        "settings.modifiedItemIndicator": "{{ highlight }}",
        "welcomePage.tileBackground": "{{ dark }}",
        "welcomePage.tileBorder": "{{ normal }}"
    }
}
