#
#  The splash looks like the lock screen of hyprlock, as configured in
#  ~/.config/hypr/hyprlock.conf of hd-desktop, in the theme of the system:
#  its background, and for a password, such as the one of an encrypted ZFS
#  dataset, a rounded input field with the colour dark of the theme at its
#  opacity as the fill, an outline in highlight and dots in light. While the
#  password is checked the outline turns yellow, and when the same prompt
#  comes back, the password was wrong: the outline turns red and the field
#  says how many attempts failed. The field, with its fill, outline and
#  corners, is an image per state, which hd-plymouth-render draws.


#------------------------------- Constants -----------------------------------------
# The input field of hyprlock.conf: its size, and the relative dots_size
# and dots_spacing of hyprlock. The images of the field have this size.
FIELD.width = {{ field_width }};
FIELD.height = {{ field_height }};
DOTS_SIZE = 0.25;
DOTS_SPACING = 0.15;
# The space between the dots and the outline, relative to the height.
DOTS_MARGIN = 0.5;

# font_color of hyprlock.conf, light of the theme, for all text.
text_colour.red = {{ light.red }};
text_colour.green = {{ light.green }};
text_colour.blue = {{ light.blue }};

# The font of the theme, at font-size-normal in the field and
# font-size-small below it. The initramfs-tools hook hd-plymouth puts the
# files of the fonts in the initramfs.
FONT = {{ font | script_string }};
FONT_ITALIC = {{ font_italic | script_string }};
FONT_SMALL = {{ font_small | script_string }};

PLACEHOLDER_TEXT = "Enter Password";
FAIL_TEXT = "Wrong password";

# How long the field shows that the password is checked before it hides,
# in calls of the refresh function, which plymouth makes about 50 times a
# second.
CHECK_FRAMES = 100;


#------------------------------- Globals -------------------------------------------
# hidden, input (the field takes a password) or check (the password is
# being checked).
state = "hidden";
# The prompt of the last password question, whether that question ended,
# and how many times in a row it came back.
last_prompt = "";
prompt_ended = 0;
attempts = 0;
check_frames = 0;


#----------------------------- Text-image functions --------------------------------
fun ImageFromText (text, colour, font) {
    return Image.Text (text, colour.red, colour.green, colour.blue, 1, font);
}


#----------------------------- Screen setup ----------------------------------------
screen.x = Window.GetX ();
screen.y = Window.GetY ();
screen.width = Window.GetWidth ();
screen.height = Window.GetHeight ();

# dark of the theme, for where the background does not load.
Window.SetBackgroundTopColor ({{ dark.red }}, {{ dark.green }}, {{ dark.blue }});
Window.SetBackgroundBottomColor ({{ dark.red }}, {{ dark.green }}, {{ dark.blue }});

# The wallpaper, scaled to cover the screen and centered, so a screen
# with another aspect ratio crops it.
background.image = Image ("background.png");
if (background.image) {
    background.scale = Math.Max (screen.width / background.image.GetWidth (),
                                 screen.height / background.image.GetHeight ());
    background.image = background.image.Scale (Math.Int (background.image.GetWidth () * background.scale + 0.5),
                                               Math.Int (background.image.GetHeight () * background.scale + 0.5));
    background.sprite = Sprite (background.image);
    background.sprite.SetPosition (screen.x + Math.Int ((screen.width - background.image.GetWidth ()) / 2),
                                   screen.y + Math.Int ((screen.height - background.image.GetHeight ()) / 2),
                                   -100);
}


#----------------------------- Input field -----------------------------------------
# The field is centered, and narrower on a screen that is too small for it;
# its images are then scaled to that width.
field.width = Math.Min (FIELD.width, screen.width - 32);
field.height = FIELD.height;
field.x = screen.x + Math.Int ((screen.width - field.width) / 2);
field.y = screen.y + Math.Int ((screen.height - field.height) / 2);

# The field is one sprite, with an image per state: the fill and the
# rounded outline in outer_color of hyprlock.conf, and in check_color and
# fail_color, which hyprlock.conf leaves at the defaults of hyprlock.
fun FieldImage (filename) {
    local.image = Image (filename);
    if (local.image.GetWidth () != field.width)
        local.image = local.image.Scale (field.width, field.height);
    return local.image;
}

field_input = FieldImage ("field-input.png");
field_check = FieldImage ("field-check.png");
field_fail = FieldImage ("field-fail.png");

field.sprite = Sprite ();
field.sprite.SetPosition (field.x, field.y, 10);

fun SetField (image) {
    field.sprite.SetImage (image);
}

fun SetFieldOpacity (opacity) {
    field.sprite.SetOpacity (opacity);
}

# The dots, centered in the field, as many as fit between the margins.
dot.size = Math.Int (field.height * DOTS_SIZE);
dot.space = dot.size * DOTS_SPACING;
dot.image = Image ("dot.png").Scale (dot.size, dot.size);
dot.y = field.y + Math.Int ((field.height - dot.size) / 2);
dot.max = Math.Int ((field.width - 2 * field.height * DOTS_MARGIN + dot.space) / (dot.size + dot.space));

fun ShowDots (count) {
    local.count = Math.Min (count, dot.max);
    local.x = field.x + (field.width - (local.count * dot.size + (local.count - 1) * dot.space)) / 2;
    for (local.i = 0; global.dots[local.i] || local.i < local.count; local.i++) {
        if (!global.dots[local.i])
            global.dots[local.i] = Sprite (dot.image);
        global.dots[local.i].SetPosition (Math.Int (local.x + local.i * (dot.size + dot.space)), dot.y, 11);
        if (local.i < local.count)
            global.dots[local.i].SetOpacity (1);
        else
            global.dots[local.i].SetOpacity (0);
    }
}

# The text in the field: the placeholder, or the number of failed attempts.
field_text = Sprite ();
field_text.SetOpacity (0);

fun ShowFieldText (image) {
    field_text.SetImage (image);
    field_text.SetPosition (field.x + Math.Int ((field.width - image.GetWidth ()) / 2),
                            field.y + Math.Int ((field.height - image.GetHeight ()) / 2), 11);
    field_text.SetOpacity (1);
}

fun HideField () {
    SetFieldOpacity (0);
    ShowDots (0);
    field_text.SetOpacity (0);
}

SetField (field_input);
HideField ();


#----------------------------- Messages --------------------------------------------
# The messages of plymouth message, and the progress of systemd-fsckd,
# below the field.
message_text = Sprite ();
message_text.SetOpacity (0);
fsck_text = Sprite ();
fsck_text.SetOpacity (0);
first_line_height = ImageFromText ("AfpqtM", text_colour, FONT_SMALL).GetHeight ();

fun ShowLine (sprite, text, line) {
    if (!text || text == "") {
        sprite.SetOpacity (0);
        return;
    }
    local.image = ImageFromText (text, text_colour, FONT_SMALL);
    sprite.SetImage (local.image);
    sprite.SetPosition (screen.x + Math.Int ((screen.width - local.image.GetWidth ()) / 2),
                        field.y + field.height + Math.Int (field.height / 3) + line * first_line_height * 1.5, 11);
    sprite.SetOpacity (1);
}

# The callback function is called when a new message should be displayed.
fun message_callback (message) {
    ShowLine (message_text, message, 0);
}

Plymouth.SetMessageFunction (message_callback);


#------------------------------ String functions -----------------------------------
# This is the equivalent for strstr()
fun StringString (string, substring) {
    start = 0;
    while (String(string).CharAt (start)) {
        walk = 0;
        while (String(substring).CharAt (walk) == String(string).CharAt (start + walk) ) {
            walk++;
            if (!String(substring).CharAt (walk)) return start;
        }
        start++;
    }

    return NULL;
}

# it makes sense to use it only for
# numbers up to 100
fun StringToInteger (str) {
    int = -1;
    for (i=0; i<=100; i++) {
        if (i+"" == str) {
            int = i;
            break;
        }
    }
    return int;
}


#------------------------------ Update Status stuff --------------------------------
# systemd-fsckd passes fsckd:<number_devices>:<progress>:<l10n_string>
fun update_status_callback (status) {
    if (!status) return;

    string_it = 0;
    update_strings[string_it] = "";

    for (i=0; (String(status).CharAt(i) != ""); i++) {
        local.temp_char = String(status).CharAt(i);
        if (temp_char != ":")
            update_strings[string_it] += temp_char;
        else
            update_strings[++string_it] = "";
    }

    if (update_strings[0] == "fsckd") {
        number_devices = StringToInteger (update_strings[1]);

        if (number_devices > 0)
            ShowLine (fsck_text, update_strings[3], 1);
        else
            ShowLine (fsck_text, "", 1);
    }
}

Plymouth.SetUpdateStatusFunction (update_status_callback);


#------------------------------ Display Password stuff -----------------------------
# The callback function is called when the display should display a password
# dialogue, and again on every key press. First arg is the prompt string, the
# second is the number of bullets.
fun display_password_callback (prompt, bullets) {
    # A question that comes back with the same prompt after it ended means
    # that the password was wrong; the ZFS script of the initramfs asks up
    # to three times.
    if (global.prompt_ended) {
        if (prompt == global.last_prompt)
            global.attempts++;
        else
            global.attempts = 0;
        global.prompt_ended = 0;
    }
    else if (global.state == "hidden") {
        global.attempts = 0;
    }
    global.last_prompt = prompt;
    global.state = "input";

    # The prompt only tells the questions apart; the field does not show it.
    ShowDots (bullets);
    if (bullets > 0) {
        SetField (field_input);
        field_text.SetOpacity (0);
    }
    else if (global.attempts > 0) {
        SetField (field_fail);
        ShowFieldText (ImageFromText (FAIL_TEXT + " (" + global.attempts + ")", text_colour, FONT_ITALIC));
    }
    else {
        SetField (field_input);
        ShowFieldText (ImageFromText (PLACEHOLDER_TEXT, text_colour, FONT));
    }
    SetFieldOpacity (1);
}

Plymouth.SetDisplayPasswordFunction (display_password_callback);


#------------------------------ Display Normal stuff -------------------------------
# The callback function is called when the display should return to normal,
# which ends a password question. The field shows that the password is
# checked, until the refresh function hides it.
fun display_normal_callback () {
    if (global.state != "input")
        return;
    global.state = "check";
    global.prompt_ended = 1;
    global.check_frames = 0;
    SetField (field_check);
    field_text.SetOpacity (0);
}

Plymouth.SetDisplayNormalFunction (display_normal_callback);


#------------------------------ Refresh stuff --------------------------------------
# Calling Plymouth.SetRefreshFunction with a function will set that function to be
# called up to 50 times every second.
#
# NOTE: if a refresh function is not set, Plymouth doesn't seem to be able to update
#       the screen correctly
#
fun refresh_callback () {
    if (global.state != "check")
        return;
    global.check_frames++;
    if (global.check_frames >= CHECK_FRAMES) {
        global.state = "hidden";
        HideField ();
    }
}

Plymouth.SetRefreshFunction (refresh_callback);


#------------------------------ Quit -----------------------------------------------
fun quit_callback () {
}

Plymouth.SetQuitFunction (quit_callback);
