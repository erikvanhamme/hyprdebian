#!/usr/bin/python3
"""Adds, deletes, lists, selects and applies the themes of HyprDebian.

The package hd-desktop installs this as /usr/bin/hd-theme.

    hd-theme --list                 print the themes and show their cards in imv-wayland
    hd-theme --add <file> [--no-initramfs]
                                    add the theme in <file>, or replace the one with its name
    hd-theme --delete <name>        delete a theme; not the theme of the system
    hd-theme --select <name> [--no-initramfs] [--apply [--no-reload]]
                                    make <name> the theme of the system, or of the user, and with
                                    --apply apply it at once
    hd-theme --apply [--no-reload]  apply the selected theme to the desktop of the user
    hd-theme --cards                render the cards of all themes again

A theme is a JSON object in /etc/hyprdebian/themes/<name>.json; the file name is the name of the
theme. A selected theme is copied, with its name, to the key hd-theme of a configuration, with
hd-config-update. There are two kinds:

    the theme of the system   in /etc/hyprdebian/config.json, selected by root; the theme of the
                              users that have none of their own
    the theme of a user       in ~/.config/hyprdebian/config.json, selected by that user

Who runs hd-theme decides which one --select, --apply and --list work on: root the theme of the
system, any other user their own theme, or the theme of the system while they have none. hd-menu
and the other programs of the desktop look up the theme in the same way. A user goes back to the
theme of the system with hd-config-remove hd-theme. Selecting a theme does not change the
desktops: each user runs hd-theme --apply for their own desktop, or gives --apply with --select to
apply the theme they select.

The boot splash and the bootloader use the theme of the system. Selecting it as root, or replacing
it with --add, renders the splash again with hd-plymouth-render --update-initramfs, which rebuilds
the initramfs of all kernels when the splash changed; that takes a while. Then, when hd-bootloader
is installed, it writes the bootloader again with /usr/lib/hd-bootloader/update-esps, so the menu
of the graphical bootloader has the theme. --no-initramfs leaves both out; the next rebuild of the
initramfs, such as for a new kernel, then takes the new splash and bootloader.

--apply writes, from the jinja2 templates in /usr/share/hd-theme/templates, one theme file per
program, next to its own config in the home directory of the user:

    ~/.config/kitty/hd-theme.conf           included by kitty.conf
    ~/.config/hypr/hd-theme.lua             required by hyprland.lua
    ~/.config/hypr/hd-theme-hyprlock.conf   sourced by hyprlock.conf
    ~/.config/hypr/hd-theme-hyprpaper.conf  sourced by hyprpaper.conf
    ~/.config/mako/hd-theme                 included by the config of mako
    ~/.config/hypr/hd-theme-hyprtoolkit.conf
                                            sourced by hyprtoolkit.conf, for the dialogs of
                                            Hyprland
    ~/.config/qt5ct/colors/hd-theme.conf    the colour scheme of qt5ct.conf
    ~/.config/qt6ct/colors/hd-theme.conf    the colour scheme of qt6ct.conf
    ~/.config/gtk-3.0/hd-theme.css          imported by gtk.css of GTK 3
    ~/.config/gtk-4.0/hd-theme.css          imported by gtk.css of GTK 4
    ~/.vscode-oss/extensions/hyprdebian.hd-theme/
                                            the colour theme HyprDebian of VSCodium, selected
                                            in ~/.config/VSCodium/User/settings.json

It also sets the font of the GTK applications, of the interface, the documents and the monospaced
text, to the font of the theme in font-size-small, in the dconf database of the user, with dconf
write. dconf needs the session bus; without one, the font is left as it is.

The sizes in the theme files are those of the theme multiplied by the factor of the key hd-display
of /etc/hyprdebian/config.json, which /usr/lib/hd-desktop/hd_display.py works out: the font sizes
to a tenth of a point, border, radius, gap and icon_size to whole pixels. Without the key, the
factor is 1. The theme in the configuration keeps its own sizes.

The configs of the programs themselves are the user's and are never changed; the configs that
hd-desktop puts in /etc/skel use the theme files. A config that does not refer to its theme file
is reported. A theme file is only written when it changes, and only then is the program reloaded,
unless --no-reload is given: Hyprland with hyprctl, hyprpaper by a restart of its user service,
kitty with SIGUSR1 and mako with makoctl. hyprlock reads its config when it starts, and VSCodium
and hyprtoolkit watch their theme files. The GTK and Qt applications take their colours when they
start, and the GTK applications that run follow the font at once.

The colour theme of VSCodium is an extension of its own. VSCodium registers the extensions in
~/.vscode-oss/extensions/extensions.json; when that file is there, hd-theme adds the extension to
it, as VSCodium only finds new extensions by itself when it makes that file or while it runs. The
theme includes Dark+ of VSCodium, for the colours of the syntax, when VSCodium is installed in
/usr/share/codium.

Every theme has a card, a PNG rendered by hd-theme-card, in /var/cache/hd-theme/cards/<name>.png.
--list opens imv-wayland on that directory. --add, --delete and --cards are refused when not run
as root; --list, --select and --apply are run by any user.
"""

import argparse
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile

import jinja2

LIB_DIR = "/usr/lib/hd-desktop"
sys.dont_write_bytecode = True
sys.path.insert(0, LIB_DIR)
import hd_display

SYSTEM_CONFIG = "/etc/hyprdebian/config.json"
USER_CONFIG = ".config/hyprdebian/config.json"
CONFIG_KEY = "hd-theme"
THEME_DIR = "/etc/hyprdebian/themes"
CARD_DIR = "/var/cache/hd-theme/cards"
BACKGROUNDS = "/usr/share/backgrounds/hyprdebian"
TEMPLATE_DIR = "/usr/share/hd-theme/templates"
VSCODIUM_EXTENSIONS = ".vscode-oss/extensions"
VSCODIUM_REGISTRY = "extensions.json"
VSCODIUM_PUBLISHER = "hyprdebian"
VSCODIUM_NAME = "hd-theme"
VSCODIUM_VERSION = "1.0.0"
VSCODIUM_EXTENSION = f"{VSCODIUM_PUBLISHER}.{VSCODIUM_NAME}"
# The theme of VSCodium whose syntax colours the colour theme includes.
VSCODIUM_BASE = "/usr/share/codium/resources/app/extensions/theme-defaults/themes/dark_plus.json"
PLYMOUTH_RENDER = "/usr/sbin/hd-plymouth-render"
UPDATE_ESPS = "/usr/lib/hd-bootloader/update-esps"

VALID_NAME = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
COLOR = re.compile(r"^#[0-9a-fA-F]{6}$")

# The members of a theme, by kind.
FONT_SIZES = ["font-size-big", "font-size-normal", "font-size-small"]
COLORS = ["highlight", "normal", "dark", "light"]
SIZES = ["border", "radius", "gap", "icon_size"]
MEMBERS = ["font"] + FONT_SIZES + COLORS + SIZES + ["opacity", "background"]

# The theme files of --apply: the template, the theme file it makes and the config that uses it,
# both relative to the home directory, the text by which that config refers to the theme file, and
# what to reload when the theme file changes. A config of None is not checked.
TARGETS = [
    ("kitty.conf.j2", ".config/kitty/hd-theme.conf", ".config/kitty/kitty.conf",
     "include hd-theme.conf", "kitty"),
    ("hyprland.lua.j2", ".config/hypr/hd-theme.lua", ".config/hypr/hyprland.lua",
     '"hd-theme"', "hyprland"),
    ("hyprlock.conf.j2", ".config/hypr/hd-theme-hyprlock.conf", ".config/hypr/hyprlock.conf",
     "hd-theme-hyprlock.conf", None),
    ("hyprpaper.conf.j2", ".config/hypr/hd-theme-hyprpaper.conf", ".config/hypr/hyprpaper.conf",
     "hd-theme-hyprpaper.conf", "hyprpaper"),
    ("mako.j2", ".config/mako/hd-theme", ".config/mako/config", "~/.config/mako/hd-theme",
     "mako"),
    ("vscodium-package.json.j2", f"{VSCODIUM_EXTENSIONS}/{VSCODIUM_EXTENSION}/package.json",
     None, None, None),
    ("vscodium-theme.json.j2", f"{VSCODIUM_EXTENSIONS}/{VSCODIUM_EXTENSION}/hd-theme.json",
     ".config/VSCodium/User/settings.json", '"HyprDebian"', None),
    ("hyprtoolkit.conf.j2", ".config/hypr/hd-theme-hyprtoolkit.conf",
     ".config/hypr/hyprtoolkit.conf", "hd-theme-hyprtoolkit.conf", None),
    ("qtct-colors.conf.j2", ".config/qt5ct/colors/hd-theme.conf", ".config/qt5ct/qt5ct.conf",
     "colors/hd-theme.conf", None),
    ("qtct-colors.conf.j2", ".config/qt6ct/colors/hd-theme.conf", ".config/qt6ct/qt6ct.conf",
     "colors/hd-theme.conf", None),
    ("gtk3.css.j2", ".config/gtk-3.0/hd-theme.css", ".config/gtk-3.0/gtk.css", "hd-theme.css",
     None),
    ("gtk4.css.j2", ".config/gtk-4.0/hd-theme.css", ".config/gtk-4.0/gtk.css", "hd-theme.css",
     None),
]

# The keys of the dconf database that hold the font of the GTK applications, of the interface, the
# documents and the monospaced text.
GTK_FONT_KEYS = ["/org/gnome/desktop/interface/font-name",
                 "/org/gnome/desktop/interface/document-font-name",
                 "/org/gnome/desktop/interface/monospace-font-name"]


def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def warn(message):
    print(f"Warning: {message}", file=sys.stderr)


def is_root():
    return os.geteuid() == 0


def need_root(action):
    if not is_root():
        fail(f"hd-theme {action} is run as root.")


def own_config():
    """The configuration that hd-config-update writes for whoever runs hd-theme: that of the
    system for root, that of the user for other users."""
    if is_root():
        return SYSTEM_CONFIG
    return os.path.join(pwd.getpwuid(os.getuid()).pw_dir, USER_CONFIG)


def config_files():
    """The configurations in which the theme is looked up, first to last."""
    if is_root():
        return [SYSTEM_CONFIG]
    return [own_config(), SYSTEM_CONFIG]


def is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def check_name(name):
    if not VALID_NAME.match(name):
        fail(f"{name!r} is not a valid theme name: use lower case letters, digits, - and _, "
             "starting with a letter or digit.")


def theme_path(name):
    return os.path.join(THEME_DIR, name + ".json")


def card_path(name):
    return os.path.join(CARD_DIR, name + ".png")


def theme_names():
    try:
        files = os.listdir(THEME_DIR)
    except FileNotFoundError:
        return []
    return sorted(f[:-len(".json")] for f in files
                  if f.endswith(".json") and VALID_NAME.match(f[:-len(".json")]))


def has_background(family):
    try:
        names = os.listdir(BACKGROUNDS)
    except FileNotFoundError:
        return False
    return any(re.fullmatch(re.escape(family) + r"-\d+x\d+\.png", n) for n in names)


def check_theme(theme, source):
    """The theme without its name, or a failure that tells what is wrong with it."""
    if not isinstance(theme, dict):
        fail(f"{source} does not hold a JSON object.")
    theme = {k: v for k, v in theme.items() if k != "name"}
    errors = []
    missing = [k for k in MEMBERS if k not in theme]
    if missing:
        errors.append(f"it misses {', '.join(missing)}")
    unknown = [k for k in theme if k not in MEMBERS]
    if unknown:
        errors.append(f"it has unknown members {', '.join(unknown)}")
    if "font" in theme and (not isinstance(theme["font"], str) or theme["font"] == ""):
        errors.append("font is not a font name")
    for key in FONT_SIZES:
        if key in theme and (not is_number(theme[key]) or theme[key] <= 0):
            errors.append(f"{key} is not a size in points above 0")
    for key in COLORS:
        if key in theme and (not isinstance(theme[key], str) or not COLOR.match(theme[key])):
            errors.append(f"{key} is not a #rrggbb colour")
    for key in SIZES:
        if key in theme and (not isinstance(theme[key], int) or isinstance(theme[key], bool)
                             or theme[key] < 0):
            errors.append(f"{key} is not a whole number of pixels")
    if theme.get("icon_size") == 0:
        errors.append("icon_size is 0")
    if (isinstance(theme.get("radius"), int) and isinstance(theme.get("border"), int)
            and theme["radius"] < theme["border"]):
        errors.append("radius is smaller than border")
    if "opacity" in theme and (not is_number(theme["opacity"])
                               or not 0 <= theme["opacity"] <= 1):
        errors.append("opacity is not a number from 0 to 1")
    if "background" in theme:
        if not isinstance(theme["background"], str) or theme["background"] == "":
            errors.append("background is not the name of a background")
        elif not has_background(theme["background"]):
            errors.append(f"there is no background {theme['background']} in {BACKGROUNDS}")
    if errors:
        fail(f"The theme in {source} is not valid: " + "; ".join(errors) + ".")
    # In the order of MEMBERS, so that every theme file looks the same.
    return {k: theme[k] for k in MEMBERS}


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError) as e:
        fail(f"Cannot read {path}: {e}")


def load_theme(name):
    path = theme_path(name)
    if not os.path.exists(path):
        fail(f"There is no theme {name}; hd-theme --list shows the themes.")
    return check_theme(read_json(path), path)


def config_theme(path):
    """The theme in the key hd-theme of a configuration, or None when the configuration or the key
    is not there."""
    if not os.path.exists(path):
        return None
    config = read_json(path)
    if not isinstance(config, dict) or not isinstance(config.get(CONFIG_KEY), dict):
        return None
    return config[CONFIG_KEY]


def selected_theme():
    """The selected theme: the first that config_files() has."""
    for path in config_files():
        theme = config_theme(path)
        if theme is not None:
            return theme
    fail(f"{' and '.join(config_files())} have no theme in the key {CONFIG_KEY}; select one with "
         "hd-theme --select.")


def theme_name(theme):
    """The name of a selected theme, or None."""
    if theme is None:
        return None
    name = theme.get("name")
    if not isinstance(name, str):
        return None
    return name


def selected_name():
    """The name of the selected theme, or None."""
    for path in config_files():
        theme = config_theme(path)
        if theme is not None:
            return theme_name(theme)
    return None


def system_name():
    """The name of the theme of the system, or None."""
    return theme_name(config_theme(SYSTEM_CONFIG))


def write_json(path, value):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(value, f, indent=4, ensure_ascii=False)
        f.write("\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def render_card(theme_file, card):
    """Renders the card of a theme file to card; False when hd-theme-card fails."""
    os.makedirs(os.path.dirname(card), mode=0o755, exist_ok=True)
    tmp = card + ".tmp"
    result = subprocess.run(["hd-theme-card", theme_file, tmp])
    if result.returncode != 0:
        if os.path.exists(tmp):
            os.remove(tmp)
        return False
    os.chmod(tmp, 0o644)
    os.replace(tmp, card)
    return True


def select(name, initramfs, applying):
    """Copies the theme to the configuration of whoever runs hd-theme, with hd-config-update,
    which picks the same configuration as own_config(). For the theme of the system, it also
    renders the boot splash, and with initramfs rebuilds the initramfs when the splash changed and
    writes the bootloader again, when hd-bootloader is installed. applying leaves out the hint to
    run hd-theme --apply, as the caller applies the theme next."""
    theme = load_theme(name)
    result = subprocess.run(["hd-config-update", CONFIG_KEY],
                            input=json.dumps({"name": name, **theme}), text=True)
    if result.returncode != 0:
        fail(f"Could not write the theme to {own_config()}.")
    if is_root():
        print(f"Selected the theme {name} for the system. Users that have no theme of their own "
              "get it when they run hd-theme --apply.")
        command = [PLYMOUTH_RENDER]
        if initramfs:
            command.append("--update-initramfs")
        if subprocess.run(command).returncode != 0:
            fail("Could not render the boot splash in the theme.")
        if initramfs and os.path.exists(UPDATE_ESPS):
            if subprocess.run([UPDATE_ESPS]).returncode != 0:
                fail(f"Could not write the bootloader in the theme; run {UPDATE_ESPS} again.")
    elif applying:
        print(f"Selected the theme {name} for you.")
    else:
        print(f"Selected the theme {name} for you. Run hd-theme --apply to apply it to your "
              "desktop.")


def run(command):
    """The output of a command, or None when it fails or does not exist."""
    try:
        result = subprocess.run(command, capture_output=True, text=True)
    except OSError:
        return None
    if result.returncode != 0:
        return None
    return result.stdout


def hyprland_instances():
    """The signatures of the Hyprland instances of the user."""
    if "XDG_RUNTIME_DIR" not in os.environ:
        return []
    output = run(["hyprctl", "-j", "instances"])
    if output is None:
        return []
    try:
        return [i["instance"] for i in json.loads(output)]
    except (ValueError, KeyError, TypeError):
        return []


def screen_size(instances):
    """The size that a background must cover: the largest width and height of the monitors of
    Hyprland, or None when Hyprland does not run."""
    width = height = 0
    for instance in instances:
        output = run(["hyprctl", "-i", instance, "-j", "monitors"])
        if output is None:
            continue
        try:
            for monitor in json.loads(output):
                width = max(width, monitor["width"])
                height = max(height, monitor["height"])
        except (ValueError, KeyError, TypeError):
            continue
    if width == 0 or height == 0:
        return None
    return width, height


def find_background(family, screen):
    """The image of the family that best fits the screen: the smallest that covers it, else the
    largest. Without a screen, the largest."""
    found = []
    try:
        names = os.listdir(BACKGROUNDS)
    except OSError:
        names = []
    for name in names:
        match = re.fullmatch(re.escape(family) + r"-(\d+)x(\d+)\.png", name)
        if match:
            found.append((int(match[1]), int(match[2]), os.path.join(BACKGROUNDS, name)))
    if not found:
        warn(f"There is no background {family} in {BACKGROUNDS}.")
        return ""
    if screen is not None:
        covering = [f for f in found if f[0] >= screen[0] and f[1] >= screen[1]]
        if covering:
            return min(covering, key=lambda f: f[0] * f[1])[2]
    return max(found, key=lambda f: f[0] * f[1])[2]


def hex_digits(color):
    """#rrggbb as rrggbb."""
    return color.lstrip("#")


def rgb_values(color):
    """#rrggbb as r, g, b in decimal."""
    return ", ".join(str(int(color[i:i + 2], 16)) for i in (1, 3, 5))


def argb(color):
    """#rrggbb as #ffrrggbb, opaque, as qt5ct and qt6ct take it."""
    return "#ff" + hex_digits(color)


def mix(color, other, amount):
    """#rrggbb moved amount, from 0 to 1, of the way to the colour other."""
    channels = []
    for i in (1, 3, 5):
        a = int(color[i:i + 2], 16)
        b = int(other[i:i + 2], 16)
        channels.append(round(a + (b - a) * amount))
    return "#" + "".join(f"{c:02x}" for c in channels)


def gvariant_string(text):
    """text as a string of GVariant, as dconf write takes it."""
    return "'" + text.replace("\\", "\\\\").replace("'", "\\'") + "'"


def set_gtk_font(theme):
    """Sets the font of the GTK applications in the dconf database of the user, when it is not that
    font yet. dconf needs the session bus."""
    if "DBUS_SESSION_BUS_ADDRESS" not in os.environ:
        print("No session bus: the font of the GTK applications is left as it is.")
        return
    value = gvariant_string(f"{theme['font']} {theme['font-size-small']}")
    for key in GTK_FONT_KEYS:
        current = run(["dconf", "read", key])
        if current is not None and current.strip() == value:
            continue
        if run(["dconf", "write", key, value]) is None:
            warn(f"Could not set {key} with dconf.")
        else:
            print(f"Set {key} to {value}.")


def read_file(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (FileNotFoundError, UnicodeDecodeError):
        return None


def write_file(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def reload(program, instances, uid):
    if program == "hyprland":
        for instance in instances:
            if run(["hyprctl", "-i", instance, "reload"]) is None:
                warn(f"Could not reload the Hyprland instance {instance}.")
    elif program == "hyprpaper":
        if "DBUS_SESSION_BUS_ADDRESS" in os.environ:
            if run(["systemctl", "--user", "try-restart", "hyprpaper.service"]) is None:
                warn("Could not restart hyprpaper.service.")
    elif program == "kitty":
        # pkill exits with 1 when no kitty runs.
        subprocess.run(["pkill", "-USR1", "-U", str(uid), "-x", "kitty"])
    elif program == "mako":
        if run(["pgrep", "-U", str(uid), "-x", "mako"]) is not None:
            if run(["makoctl", "reload"]) is None:
                warn("Could not reload mako.")


def vscodium_base(home):
    """The path of VSCODIUM_BASE relative to the extension of the colour theme of VSCodium, as its
    include takes it, or None when VSCodium is not installed there."""
    if not os.path.exists(VSCODIUM_BASE):
        return None
    return os.path.relpath(VSCODIUM_BASE, os.path.join(home, VSCODIUM_EXTENSIONS,
                                                        VSCODIUM_EXTENSION))


def register_vscodium_extension(home):
    """Adds the extension of the colour theme to the registry of the extensions of VSCodium, when
    the registry is there and does not have it yet. Without a registry, VSCodium registers all
    extensions in the directory when it makes one."""
    extensions = os.path.join(home, VSCODIUM_EXTENSIONS)
    registry = os.path.join(extensions, VSCODIUM_REGISTRY)
    text = read_file(registry)
    if text is None:
        return
    try:
        entries = json.loads(text.strip() or "[]")
    except ValueError as e:
        warn(f"Cannot read {registry}: {e}; VSCodium may not find its HyprDebian theme.")
        return
    if not isinstance(entries, list):
        warn(f"{registry} does not hold a list; VSCodium may not find its HyprDebian theme.")
        return
    for entry in entries:
        identifier = entry.get("identifier") if isinstance(entry, dict) else None
        if (isinstance(identifier, dict)
                and str(identifier.get("id", "")).lower() == VSCODIUM_EXTENSION):
            return
    location = os.path.join(extensions, VSCODIUM_EXTENSION)
    entries.append({
        "identifier": {"id": VSCODIUM_EXTENSION},
        "version": VSCODIUM_VERSION,
        "location": {"$mid": 1, "path": location, "scheme": "file"},
        "relativeLocation": VSCODIUM_EXTENSION,
    })
    write_file(registry, json.dumps(entries))
    print(f"Added the HyprDebian theme to {registry}.")


def scaled(theme, factor):
    """The theme with its sizes multiplied by factor. A size that is missing or not a number is
    left as it is, for the templates to report."""
    theme = dict(theme)
    for key in FONT_SIZES:
        if is_number(theme.get(key)):
            theme[key] = hd_display.font_size(theme[key], factor)
    for key in SIZES:
        if is_number(theme.get(key)):
            theme[key] = hd_display.pixels(theme[key], factor)
    return theme


def apply(reload_programs):
    """Writes the theme files of the desktop programs in the home directory of the user, from the
    selected theme scaled for the monitor, and reloads the programs whose theme file changed."""
    uid = os.getuid()
    home = pwd.getpwuid(uid).pw_dir
    factor = hd_display.factor()
    theme = scaled(selected_theme(), factor)
    if factor != 1:
        print(f"Scaled the sizes of the theme by {factor} for the monitor.")
    instances = hyprland_instances()

    templates = jinja2.Environment(loader=jinja2.FileSystemLoader(TEMPLATE_DIR),
                                   undefined=jinja2.StrictUndefined, keep_trailing_newline=True,
                                   trim_blocks=True, lstrip_blocks=True)
    templates.filters["hex"] = hex_digits
    templates.filters["rgb"] = rgb_values
    templates.filters["argb"] = argb
    templates.filters["mix"] = mix
    values = {
        "theme": theme,
        "name": theme.get("name", "unnamed"),
        "background": find_background(theme["background"], screen_size(instances)),
        "inner_radius": max(theme["radius"] - theme["border"], 0),
        # Hyprland puts gaps_in around every window, so two windows are twice as far apart.
        "gaps_in": theme["gap"] // 2,
        "alpha": f"{round(theme['opacity'] * 255):02x}",
        "vscodium_publisher": VSCODIUM_PUBLISHER,
        "vscodium_name": VSCODIUM_NAME,
        "vscodium_version": VSCODIUM_VERSION,
        "vscodium_base": vscodium_base(home),
    }

    # A running VSCodium registers a new directory in its extensions as soon as it appears, so a new
    # extension of the colour theme is written under a name that VSCodium skips, with a dot in
    # front, and renamed when it is whole.
    extension = os.path.join(home, VSCODIUM_EXTENSIONS, VSCODIUM_EXTENSION)
    staging = None
    if not os.path.isdir(extension):
        staging = os.path.join(home, VSCODIUM_EXTENSIONS, "." + VSCODIUM_EXTENSION)
        shutil.rmtree(staging, ignore_errors=True)

    changed = set()
    for template, target, config, reference, program in TARGETS:
        try:
            text = templates.get_template(template).render(values)
        except jinja2.TemplateError as e:
            fail(f"Cannot render {template}: {e}")
        path = os.path.join(home, target)
        if read_file(path) != text:
            if staging is not None and os.path.dirname(path) == extension:
                write_file(os.path.join(staging, os.path.basename(path)), text)
            else:
                write_file(path, text)
            print(f"Wrote {path}.")
            if program is not None:
                changed.add(program)
        if config is not None:
            uses = read_file(os.path.join(home, config))
            if uses is not None and reference not in uses:
                print(f"Note: {os.path.join(home, config)} does not use {path}.")
    if staging is not None:
        os.rename(staging, extension)
    register_vscodium_extension(home)
    set_gtk_font(theme)

    if reload_programs:
        for program in sorted(changed):
            reload(program, instances, uid)


def list_themes():
    names = theme_names()
    if not names:
        print(f"There are no themes in {THEME_DIR}.")
        return
    selected = selected_name()
    system = system_name()
    for name in names:
        mark = "*" if name == selected else " "
        note = ""
        # Users see which theme is that of the system; for root it is the selected one.
        if not is_root() and name == system:
            note += "  (theme of the system)"
        if not os.path.exists(card_path(name)):
            note += "  (no card; sudo hd-theme --cards)"
        print(f"{mark} {name}{note}")
    cards = [card_path(n) for n in names if os.path.exists(card_path(n))]
    if not cards:
        return
    if "WAYLAND_DISPLAY" not in os.environ:
        print(f"No display to show the cards on; they are in {CARD_DIR}.")
        return
    first = card_path(selected) if card_path(selected or "") in cards else cards[0]
    # imv-wayland, the imv of the package imv for Wayland, opens a directory as the images in it,
    # starting with the selected card.
    try:
        os.execvp("imv-wayland", ["imv-wayland", "-n", first, CARD_DIR])
    except OSError as e:
        fail(f"Cannot run imv-wayland: {e}")


def add(path, initramfs):
    name = os.path.basename(path)
    if not name.endswith(".json"):
        fail(f"{path} is not a .json file; its name is the name of the theme.")
    name = name[:-len(".json")]
    check_name(name)
    theme = check_theme(read_json(path), path)
    replacing = os.path.exists(theme_path(name))

    # The card is rendered before the theme is added, so a theme that cannot be rendered is not
    # added.
    os.makedirs(THEME_DIR, mode=0o755, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        staged = os.path.join(tmp, name + ".json")
        write_json(staged, theme)
        if not render_card(staged, card_path(name)):
            fail(f"Could not render the card of {name}; the theme is not added.")
    write_json(theme_path(name), theme)
    if replacing:
        print(f"Replaced the theme {name}.")
    else:
        print(f"Added the theme {name}.")
    # Users that selected it keep their copy until they select it again.
    if name == system_name():
        select(name, initramfs, False)


def delete(name):
    check_name(name)
    if not os.path.exists(theme_path(name)):
        fail(f"There is no theme {name}.")
    # Users that selected it keep their copy in their own configuration.
    if name == system_name():
        fail(f"{name} is the theme of the system; select another one first.")
    os.remove(theme_path(name))
    if os.path.exists(card_path(name)):
        os.remove(card_path(name))
    print(f"Deleted the theme {name}.")


def render_cards():
    failed = []
    for name in theme_names():
        path = theme_path(name)
        if render_card(path, card_path(name)):
            print(f"Rendered the card of {name}.")
        else:
            failed.append(name)
    # Cards of themes that are gone.
    if os.path.isdir(CARD_DIR):
        for card in os.listdir(CARD_DIR):
            if card.endswith(".png") and card[:-len(".png")] not in theme_names():
                os.remove(os.path.join(CARD_DIR, card))
    if failed:
        fail(f"Could not render the cards of {', '.join(failed)}.")


def main():
    parser = argparse.ArgumentParser(
        description=f"Add, delete, list, select and apply the themes of HyprDebian in {THEME_DIR}.")
    actions = parser.add_mutually_exclusive_group()
    actions.add_argument("--list", action="store_true",
                         help="print the themes, * before the selected one, and show their "
                         "cards in imv-wayland")
    actions.add_argument("--add", metavar="FILE",
                         help="add the theme in FILE, named after the file without .json, or "
                         "replace the theme of that name")
    actions.add_argument("--delete", metavar="NAME", help="delete a theme")
    actions.add_argument("--select", metavar="NAME",
                         help="make NAME the theme of the system when run as root, else the "
                         "theme of the user")
    actions.add_argument("--cards", action="store_true",
                         help="render the cards of all themes again")
    # --apply is not in the group, as it also goes with --select, which applies the theme it
    # selects.
    parser.add_argument("--apply", action="store_true",
                        help="apply the selected theme to the desktop of the user; with "
                        "--select, after selecting it")
    parser.add_argument("--no-reload", action="store_true",
                        help="with --apply: write the theme files, reload nothing")
    parser.add_argument("--no-initramfs", action="store_true",
                        help="with --select or --add as root: render the boot splash, but do "
                        "not rebuild the initramfs")
    args = parser.parse_args()
    if args.apply:
        if args.list or args.add is not None or args.delete is not None or args.cards:
            parser.error("--apply goes alone or with --select")
    elif not (args.list or args.add is not None or args.delete is not None
              or args.select is not None or args.cards):
        parser.error("one of the arguments --list --add --delete --select --apply --cards is "
                     "required")
    if args.no_reload and not args.apply:
        parser.error("--no-reload goes with --apply")
    if args.no_initramfs and args.select is None and args.add is None:
        parser.error("--no-initramfs goes with --select or --add")

    if args.list:
        list_themes()
        return
    if args.select is not None:
        check_name(args.select)
        select(args.select, not args.no_initramfs, args.apply)
    if args.apply:
        apply(not args.no_reload)
        return
    if args.cards:
        need_root("--cards")
        render_cards()
    elif args.add is not None:
        need_root("--add")
        add(args.add, not args.no_initramfs)
    elif args.delete is not None:
        need_root("--delete")
        delete(args.delete)


if __name__ == "__main__":
    main()
