#!/usr/bin/env bash
# postrm of hd-backup: a removal masks hd-backup-vms.timer, whose unit file is gone, so that it
# keeps its enabled state for a reinstall. A purge also forgets that state and removes the list of
# VMs to back up in /etc/hyprdebian/config.json. The backups themselves stay.
set -euo pipefail

CONFIG_KEY="hd-backup"
UNIT="hd-backup-vms.timer"

case "${1:-}" in
    remove | purge) ;;
    *) exit 0 ;;
esac

if [[ -d /run/systemd/system ]]; then
    systemctl --system daemon-reload || true
fi

if [[ "$1" == "remove" ]]; then
    deb-systemd-helper mask "${UNIT}" > /dev/null || true
    exit 0
fi

deb-systemd-helper purge "${UNIT}" > /dev/null || true
deb-systemd-helper unmask "${UNIT}" > /dev/null || true

# hd-base may already be removed, see hd-config(7).
if [[ -x /usr/sbin/hd-config-remove ]]; then
    hd-config-remove "${CONFIG_KEY}"
fi
