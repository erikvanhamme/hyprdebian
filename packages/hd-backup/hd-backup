        number INTEGER PRIMARY KEY,
        path TEXT NOT NULL,
        sha1 TEXT NOT NULL,
        mtime INTEGER NOT NULL,
        size INTEGER NOT NULL,
        on_disk INTEGER NOT NULL
    );

    CREATE TABLE symlinks(
        number INTEGER PRIMARY KEY,
        path TEXT NOT NULL,
        target TEXT NOT NULL,
        on_disk INTEGER NOT NULL
    );

    CREATE TABLE filesets(
        number INTEGER PRIMARY KEY,
        name TEXT NOT NULL
    );

    CREATE TABLE file_fileset_links(
        file_number INTEGER NOT NULL,
        fileset_number INTEGER NOT NULL
    );

    CREATE TABLE symlink_fileset_links(
        symlink_number INTEGER NOT NULL,
        fileset_number INTEGER NOT NULL
    );

    CREATE TABLE backups(
        number INTEGER PRIMARY KEY,
        fileset_number INTEGER NOT NULL,
        name TEXT NOT NULL
    );

    CREATE TABLE paths(
        number INTEGER PRIMARY KEY,
        fileset_number INTEGER NOT NULL,
        path TEXT NOT NULL
    );

    CREATE TABLE carrier(
        number INTEGER PRIMARY KEY,
        backup_number INTEGER NOT NULL,
        label TEXT NOT NULL,
        full INTEGER NOT NULL,
        idx INTEGER NOT NULL
    );

    CREATE TABLE tarballs(
        number INTEGER PRIMARY KEY,
        carrier_number INTEGER NOT NULL,
        idx INTEGER NOT NULL,
        size INTEGER NOT NULL,
        files INTEGER NOT NULL,
        symlinks INTEGER NOT NULL,
        overhead INTEGER NOT NULL,
        written INTEGER NOT NULL
    );

    CREATE TABLE version(
        version INTEGER NOT NULL
    );

    CREATE TABLE file_tarball_links(
        file_number INTEGER NOT NULL,
        tarball_number INTEGER NOT NULL
    );

    CREATE TABLE symlink_tarball_links(
        symlink_number INTEGER NOT NULL,
        tarball_number INTEGER NOT NULL
    );
'''


def create_db(db, version):
    db.executescript(SCHEMA)
    db.execute('INSERT INTO version(version) VALUES(?)', (version,))
    db.commit()


def open_db(path):
    # Opens the database, and creates it when it is new. Rows can be read by column name.
    db = sqlite3.connect(path)
    db.row_factory = sqlite3.Row

    has_version = get_first_value(db, '''
        SELECT COUNT(*)
        FROM sqlite_master
        WHERE type='table' AND name='version'
    ''')

    if has_version == 0:
        create_db(db, DB_VERSION)
        printc('New database created.', Fore.YELLOW)
    elif get_first_value(db, 'SELECT version FROM version') != DB_VERSION:
        db.close()
        fail('Incompatible database version')

    return db


def get_first_value(db, query, params=(), default=None):
    result = db.execute(query, params).fetchone()
    if result is None:
        return default
    else:
        return result[0]


def get_first_row(db, query, params=()):
    return db.execute(query, params).fetchone()


def find_fileset(db, name):
    # The number of the fileset, or None.
    return get_first_value(db, 'SELECT number FROM filesets WHERE name=?', (name,))


def find_backup(db, name):
    # The number and fileset number of the backup, or None.
    return get_first_row(db, 'SELECT number, fileset_number FROM backups WHERE name=?', (name,))


def find_carrier(db, label):
    # The number of the carrier, or None.
    return get_first_value(db, 'SELECT number FROM carrier WHERE label=?', (label,))


def backup_items_sql(kind):
    # A subquery for the numbers of the records of a kind that are in a tarball of a backup. The backup number is its
    # parameter.
    return f'''
        SELECT {kind.tarball_links}.{kind.number}
        FROM {kind.tarball_links}
            JOIN tarballs ON tarballs.number={kind.tarball_links}.tarball_number
            JOIN carrier ON carrier.number=tarballs.carrier_number
        WHERE carrier.backup_number=?
    '''


def items_not_in_backup(db, kind, columns, fileset_number, backup_number):
    # The records of a fileset that are on disk, but not in a tarball of the backup yet, sorted by path.
    return db.execute(f'''
        SELECT {columns}
        FROM {kind.table}
            JOIN {kind.fileset_links} ON {kind.fileset_links}.{kind.number}={kind.table}.number
        WHERE {kind.fileset_links}.fileset_number=?
        AND {kind.table}.on_disk=1
        AND {kind.table}.number NOT IN ({backup_items_sql(kind)})
        ORDER BY {kind.table}.path ASC
    ''', (fileset_number, backup_number)).fetchall()

#----------------------------------------------------------------------------------------------------------------------
# Scanning filesets
#----------------------------------------------------------------------------------------------------------------------

# What a scan needs to know about an item on disk. Only one of is_symlink and unsupported_type is set.
Attributes = namedtuple('Attributes', 'is_symlink target size mtime possible_hardlink unsupported_type')


def get_attributes(path):
    status = os.lstat(path)
    if stat.S_ISLNK(status.st_mode):
        return Attributes(True, os.readlink(path), None, None, None, None)
    elif stat.S_ISDIR(status.st_mode):
        return Attributes(False, None, 0, int(status.st_mtime), None, None)
    elif stat.S_ISREG(status.st_mode):
        return Attributes(False, None, status.st_size, int(status.st_mtime), status.st_nlink > 1, None)
    elif stat.S_ISFIFO(status.st_mode):
        return Attributes(None, None, None, None, None, 'FIFO')
    elif stat.S_ISSOCK(status.st_mode):
        return Attributes(None, None, None, None, None, 'socket')
    else:
        return Attributes(None, None, None, None, None, 'device file')


def load_records(db, path, fileset_number):
    # The records of all items under a path, by kind and by path, and the numbers of the records that are linked to
    # the fileset. A scan matches most items on disk against these, without a query for every item.
    records = {FILE: {}, SYMLINK: {}}

    for row in db.execute('SELECT number, path, size, mtime, on_disk FROM files WHERE path LIKE ?', (path + '%',)):
        records[FILE].setdefault(row['path'], []).append(dict(row))

    for row in db.execute('SELECT number, path, target, on_disk FROM symlinks WHERE path LIKE ?', (path + '%',)):
        records[SYMLINK].setdefault(row['path'], []).append(dict(row))

    linked = {}
    for kind in KINDS:
        rows = db.execute(f'SELECT {kind.number} FROM {kind.fileset_links} WHERE fileset_number=?', (fileset_number,))
        linked[kind] = {row[0] for row in rows}

    return records, linked


def find_match(records, path, attributes):
    # The number of the record that describes the item on disk as it is now: a symlink with the same target, or a
    # file with the same size and mtime. None when there is none.
    for record in records[kind_of(attributes.is_symlink)].get(path, []):
        if attributes.is_symlink:
            if record['target'] == attributes.target:
                return record['number']
        else:
            if record['size'] == attributes.size and record['mtime'] == attributes.mtime:
                return record['number']

    return None


def find_unwritten_record(db, kind, path):
    # A record of the path that is in no tarball. It holds a state of the item that was never written, so it can be
    # updated to the state on disk, instead of adding a record.
    return get_first_value(db, f'''
        SELECT number
        FROM {kind.table}
            LEFT JOIN {kind.tarball_links} ON {kind.number}=number
        WHERE path=? AND tarball_number IS NULL
    ''', (path,))


def add_record(db, kind, path, attributes):
    if kind is SYMLINK:
        cursor = db.execute('INSERT INTO symlinks(path, target, on_disk) VALUES(?, ?, 1)', (path, attributes.target))
    else:
        cursor = db.execute('INSERT INTO files(path, sha1, mtime, size, on_disk) VALUES(?, ?, ?, ?, 1)',
                            (path, file_sha1(path), attributes.mtime, attributes.size))

    printc(f'      Added {kind.name} {path} to database.', Fore.BLUE)

    return cursor.lastrowid


def update_record(db, kind, number, path, attributes):
    if kind is SYMLINK:
        db.execute('UPDATE symlinks SET target=?, on_disk=1 WHERE number=?', (attributes.target, number))
    else:
        db.execute('UPDATE files SET sha1=?, mtime=?, size=?, on_disk=1 WHERE number=?',
                   (file_sha1(path), attributes.mtime, attributes.size, number))

    printc(f'      Updated {kind.name} {path} in database.', Fore.BLUE)


def mark_on_disk(db, kind, number):
    db.execute(f'UPDATE {kind.table} SET on_disk=1 WHERE number=?', (number,))


def mark_other_records_off_disk(db, kind, number, path, records):
    # Only one record of a path is on disk: the one that describes the item found on disk now. Older versions of a
    # file, and records of the other kind (a file that was replaced by a symlink, or the other way around), are not.
    for other_kind in KINDS:
        for record in records[other_kind].get(path, []):
            if other_kind is kind and record['number'] == number:
                continue

            if record['on_disk'] != 0:
                db.execute(f'UPDATE {other_kind.table} SET on_disk=0 WHERE number=?', (record['number'],))
                record['on_disk'] = 0


def link_to_fileset(db, kind, number, path, fileset_number, fileset_name):
    db.execute(f'INSERT INTO {kind.fileset_links}({kind.number}, fileset_number) VALUES(?, ?)',
               (number, fileset_number))

    printc(f'      Added {kind.name} {path} to fileset {fileset_name}.', Fore.BLUE)


def scan_item(db, path, fileset_number, fileset_name, records, linked):
    attributes = get_attributes(path)

    if attributes.possible_hardlink:
        printc(f'        WARNING: Found possible hardlink {path}.', Fore.RED)

    if attributes.unsupported_type is not None:
        printc(f'        WARNING: Found {attributes.unsupported_type} {path}. It is not backed up.', Fore.RED)
        return

    kind = kind_of(attributes.is_symlink)

    number = find_match(records, path, attributes)
    if number is None:
        number = find_unwritten_record(db, kind, path)
        if number is None:
            number = add_record(db, kind, path, attributes)
        else:
            update_record(db, kind, number, path, attributes)
    else:
        mark_on_disk(db, kind, number)

    mark_other_records_off_disk(db, kind, number, path, records)

    if number not in linked[kind]:
        link_to_fileset(db, kind, number, path, fileset_number, fileset_name)
        linked[kind].add(number)


def scan_path(db, path, fileset_number, fileset_name, excludes):
    printc(f'    Scanning file system path {path}.', Fore.MAGENTA)

    records, linked = load_records(db, path, fileset_number)

    def walk_error(e):
        error(f'        WARNING: Could not read directory {e.filename}: {e.strerror}. Its contents are not backed up.')

    count = 0
    for root, dirs, files in os.walk(path, onerror=walk_error):
        # Do not descend into excluded directories.
        included_dirs = []
        for dirname in dirs:
            dir_path = os.path.join(root, dirname)
            if is_excluded(dir_path, excludes):
                printc(f"      Directory {dir_path} is excluded.", Fore.CYAN)
            else:
                included_dirs.append(dirname)
        dirs[:] = included_dirs

        for name in files + dirs:
            item_path = os.path.join(root, name)
            if is_excluded(item_path, excludes):
                printc(f"      File {item_path} is excluded.", Fore.CYAN)
                continue

            try:
                scan_item(db, item_path, fileset_number, fileset_name, records, linked)
            except OSError as e:
                error(f'        WARNING: Could not read {item_path}: {e.strerror}. It is not backed up.')
                continue
            except UnicodeEncodeError:
                printable_path = os.fsencode(item_path).decode(errors='replace')
                error(f'        WARNING: The name of {printable_path} is not valid UTF-8. It is not backed up.')
                continue

            count += 1
            if count >= 100:
                db.commit()
                count = 0

    db.commit()

    printc(f'    File system path {path} scanned.', Fore.GREEN)


def item_exists(kind, path):
    if kind is SYMLINK:
        return os.path.islink(path)
    else:
        return not os.path.islink(path) and (os.path.isfile(path) or os.path.isdir(path))


def remove_missing_items(db, kind, fileset_number, fileset_name):
    # Items of the fileset that are gone from disk. An item that is in no tarball of a backup of the fileset leaves
    # the fileset. An item that is in no tarball at all leaves the database. The others stay, marked as not on disk,
    # so a write can put them in its delete list.
    printc(f'    Updating database for removed {kind.name}s.', Fore.MAGENTA)

    items = db.execute(f'''
        SELECT number, path, on_disk
        FROM {kind.table}
            JOIN {kind.fileset_links} ON {kind.fileset_links}.{kind.number}={kind.table}.number
        WHERE fileset_number=?
    ''', (fileset_number,)).fetchall()

    for number, path, on_disk in items:
        if item_exists(kind, path):
            continue

        in_fileset_tarballs = get_first_value(db, f'''
            SELECT COUNT(*)
            FROM {kind.tarball_links}
                JOIN tarballs ON tarballs.number={kind.tarball_links}.tarball_number
                JOIN carrier ON carrier.number=tarballs.carrier_number
                JOIN backups ON backups.number=carrier.backup_number
            WHERE {kind.tarball_links}.{kind.number}=? AND backups.fileset_number=?
        ''', (number, fileset_number))

        if in_fileset_tarballs == 0:
            db.execute(f'DELETE FROM {kind.fileset_links} WHERE {kind.number}=? AND fileset_number=?',
                       (number, fileset_number))

            printc(f'      Removed {kind.name} {path} from fileset {fileset_name}.', Fore.BLUE)

        in_tarballs = get_first_value(db, f'SELECT COUNT(*) FROM {kind.tarball_links} WHERE {kind.number}=?',
                                      (number,))

        if in_tarballs == 0:
            # Also remove the links of other filesets, so they do not point to a removed item.
            db.execute(f'DELETE FROM {kind.fileset_links} WHERE {kind.number}=?', (number,))
            db.execute(f'DELETE FROM {kind.table} WHERE number=?', (number,))

            printc(f'      Removed {kind.name} {path} from database.', Fore.BLUE)
        elif on_disk != 0:
            db.execute(f'UPDATE {kind.table} SET on_disk=0 WHERE number=?', (number,))

            printc(f'      Marked {kind.name} {path} as not on disk.', Fore.BLUE)

    db.commit()

    printc('    Database updated.', Fore.GREEN)


def update_fileset_path(db, fileset_number, fileset_name, path, excludes):
    printc(f'  Updating path {path} in file set {fileset_name}.', Fore.MAGENTA)

    relevant_excludes = []
    for exclude in excludes:
        if exclude.startswith(path):
            relevant_excludes.append(exclude)

    if is_excluded(path, relevant_excludes):
        printc(f'    File system path {path} is excluded.', Fore.CYAN)
    else:
        scan_path(db, path, fileset_number, fileset_name, relevant_excludes)

    for kind in KINDS:
        remove_missing_items(db, kind, fileset_number, fileset_name)

    printc(f'  Fileset path {path} updated for file set {fileset_name}.', Fore.GREEN)

