def manifest(db, carrier_label):
    carrier = get_first_row(db, '''
        SELECT carrier.number, carrier.label, carrier.full, carrier.idx, backups.name AS backup_name
        FROM carrier
            LEFT JOIN backups ON backups.number=carrier.backup_number
        WHERE label=?
    ''', (carrier_label,))

    if carrier is None:
        fail(f"carrier with label {carrier_label} is not in the database.")

    tarballs = db.execute('''
        SELECT number, idx, size, files, symlinks, overhead, written
        FROM tarballs
        WHERE carrier_number=?
        ORDER BY idx ASC
    ''', (carrier['number'],)).fetchall()

    count = len(tarballs)
    printc(f"Begin carrier {carrier['label']} manifest:", Fore.BLUE)
    printc(f"    carrier has index {carrier['idx']} in backup set {carrier['backup_name']}.", Fore.BLUE)
    printc(f"    carrier is {'not ' if carrier['full'] == 0 else ''}full.", Fore.BLUE)
    printc(f"    There {'is' if count == 1 else 'are'} {count} tarball{'s' if count != 1 else ''} on the carrier.",
           Fore.BLUE)

    total_size = 0
    for tarball in tarballs:
        printc(f"Tarball {tarball['idx']} written at {datetime.datetime.fromtimestamp(tarball['written'])} contains "
               f"{tarball['files']} files and {tarball['symlinks']} symlinks.", Fore.MAGENTA)
        printc(f"Tarball has a total size of {tarball['size']} bytes with an observed overhead of "
               f"{tarball['overhead']} bytes.", Fore.MAGENTA)
        printc("File list:", Fore.MAGENTA)

        files = db.execute('''
            SELECT path, size, sha1
            FROM files
                JOIN file_tarball_links ON file_tarball_links.file_number=files.number
            WHERE tarball_number=?
            ORDER BY path ASC
        ''', (tarball['number'],))

        for path, size, sha1 in files:
            # Directories are stored as files without a hash.
            file_type = ' [Directory]' if sha1 == '' else ''
            printc(f'    {path}{file_type} ({size} bytes)', Fore.CYAN)

        symlinks = db.execute('''
            SELECT path
            FROM symlinks
                JOIN symlink_tarball_links ON symlink_tarball_links.symlink_number=symlinks.number
            WHERE tarball_number=?
            ORDER BY path ASC
        ''', (tarball['number'],))

        for row in symlinks:
            printc(f"    {row['path']} [Symlink] (0 bytes)", Fore.CYAN)

        total_size += tarball['size']

    printc(f'Total data size on carrier is {total_size} bytes.', Fore.BLUE)
    printc(f"End carrier {carrier['label']} manifest.", Fore.BLUE)


def remove_carrier(db, carrier_labels):
    # Removes carriers with their tarballs from the database. The files on the carriers are not touched.
    for label in carrier_labels:
        carrier_number = find_carrier(db, label)
        if carrier_number is None:
            error(f'carrier with label {label} is not in the database.')
            continue

        tarballs = db.execute('SELECT number FROM tarballs WHERE carrier_number=?', (carrier_number,)).fetchall()
        for tarball in tarballs:
            for kind in KINDS:
                db.execute(f'DELETE FROM {kind.tarball_links} WHERE tarball_number=?', (tarball['number'],))
            db.execute('DELETE FROM tarballs WHERE number=?', (tarball['number'],))

        db.execute('DELETE FROM carrier WHERE number=?', (carrier_number,))
        db.commit()

        printc(f'carrier with label {label} has been deleted from database.', Fore.BLUE)


def remove_backups(db, backup_names):
    # Removes backups with their carriers and tarballs from the database. The fileset stays.
    for backup_name in backup_names:
        backup = find_backup(db, backup_name)
        if backup is None:
            error(f'Backup with name {backup_name} is not in the database.')
            continue

        labels = db.execute('SELECT label FROM carrier WHERE backup_number=?', (backup['number'],)).fetchall()
        remove_carrier(db, [row['label'] for row in labels])

        db.execute('DELETE FROM backups WHERE number=?', (backup['number'],))
        db.commit()

        printc(f'Backup with name {backup_name} has been deleted from database.', Fore.BLUE)

