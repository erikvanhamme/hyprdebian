# tar writes records of 8192 blocks of 512 bytes: 4 MiB. On tape, every record is one block of the drive.
TAR_BLOCKING_FACTOR = 8192
TAPE_BLOCK_SIZE = TAR_BLOCKING_FACTOR * 512

