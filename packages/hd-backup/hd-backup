# The delete list in every tarball. {paths} is replaced by the paths, one per line.
DELETELIST_TEMPLATE = '''#!/usr/bin/python

# Removes what was deleted after it was backed up. The paths are relative to the parent of the
# directory of this script, which is the directory the backup was restored into.

import os

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

paths = [
{paths}]

for path in paths:
    full_path = root + path
    try:
        if os.path.isdir(full_path) and not os.path.islink(full_path):
            os.rmdir(full_path)
        elif os.path.lexists(full_path):
            os.remove(full_path)
    except OSError as e:
        print(f'Could not remove {{full_path}}: {{e.strerror}}')
'''

# An item to write: its record number, its path, the size of its contents and the bytes it takes in the tarball.
WriteItem = namedtuple('WriteItem', 'number path size tar_size')

# How tar, or the tape pipeline, ended.
TarResult = namedtuple('TarResult', 'bytes_written full changed failed')


def write_prepare(db, backup_name, target):
    # The backup, its fileset, the carrier to write to and the index of the new tarball on it.
    if not os.path.exists(target):
        fail(f'The target {target} does not exist.')

    backup = find_backup(db, backup_name)
    if backup is None:
        fail(f'There is no backup with name {backup_name} in the database.')

    carrier_number = get_first_value(db, '''
        SELECT number
        FROM carrier
        WHERE backup_number=? AND full=0
        ORDER BY label ASC
    ''', (backup['number'],))

    if carrier_number is None:
        fail(f'There are no carrier available in backup set {backup_name}.')

    last_index = get_first_value(db, 'SELECT MAX(idx) FROM tarballs WHERE carrier_number=?', (carrier_number,))
    if last_index is None:
        tarball_index = 0
    else:
        tarball_index = last_index + 1

    return backup['number'], backup['fileset_number'], carrier_number, tarball_index


def write_create_deletelist(db, fileset_number, backup_number):
    # A path is deleted when none of its records is on disk. Only the paths of the fileset that are in a tarball of
    # this backup are listed, because only those are restored from it.
    deleted_paths = set()
    for kind in KINDS:
        rows = db.execute(f'''
            SELECT {kind.table}.path
            FROM {kind.table}
                JOIN {kind.fileset_links} ON {kind.fileset_links}.{kind.number}={kind.table}.number
            WHERE {kind.fileset_links}.fileset_number=?
            AND {kind.table}.on_disk=0
            AND {kind.table}.path NOT IN (
                SELECT path FROM files WHERE on_disk=1
                UNION
                SELECT path FROM symlinks WHERE on_disk=1
            )
            AND {kind.table}.number IN ({backup_items_sql(kind)})
        ''', (fileset_number, backup_number))

        for row in rows:
            deleted_paths.add(row['path'])

    # In reverse order, the contents of a directory come before the directory itself.
    path_lines = ''.join(f'    {path!r},\n' for path in sorted(deleted_paths, reverse=True))

    # Every write has a delete list of its own. The name starts with the time, so the delete lists of a restore sort
    # in the order they were written. It is always in /tmp: the delete list finds the restore directory as the parent
    # of the directory it is in.
    descriptor, deletelist_name = tempfile.mkstemp(prefix=f"deletes_{time.strftime('%Y-%m-%d_%H:%M:%S')}_",
                                                   suffix='.py', dir='/tmp')
    with os.fdopen(descriptor, 'w') as deletelist:
        deletelist.write(DELETELIST_TEMPLATE.format(paths=path_lines))

    os.chmod(deletelist_name, 0o755)

    return deletelist_name, os.path.getsize(deletelist_name)


def lstat_or_none(path):
    try:
        return os.lstat(path)
    except FileNotFoundError:
        return None


def write_create_filelist(db, fileset_number, backup_number, deletelist_name):
    # The items to write: the files and symlinks of the fileset that are not in a tarball of this backup yet. They are
    # listed in the file list for tar, after the delete list.
    files_to_write = []
    for number, path, size in items_not_in_backup(db, FILE, 'files.number, files.path, files.size',
                                                  fileset_number, backup_number):
        status = lstat_or_none(path)
        if status is None or stat.S_ISLNK(status.st_mode):
            fail('There are files labeled as on disk that do not exist. Update the fileset first.')

        # tar writes the size the file has when it reads it. When the file grew since the fileset was updated, the
        # size on disk is used to work out what fits on a full carrier.
        if stat.S_ISREG(status.st_mode):
            size = max(size, status.st_size)

        files_to_write.append(WriteItem(number, path, size, tar_item_size(path, status, size)))

    symlinks_to_write = []
    for number, path in items_not_in_backup(db, SYMLINK, 'symlinks.number, symlinks.path',
                                            fileset_number, backup_number):
        status = lstat_or_none(path)
        if status is None or not stat.S_ISLNK(status.st_mode):
            fail('There are symlinks labeled as on disk that do not exist. Update the fileset first.')

        # tar writes the target the symlink has now.
        symlinks_to_write.append(WriteItem(number, path, 0, tar_item_size(path, status, 0, os.readlink(path))))

    # tar writes the items in this order. The names are separated by null characters, so that any character can be in
    # a name, and are relative to /. Every write has a file list of its own, removed after the write.
    names = [deletelist_name] + [item.path for item in symlinks_to_write] + [item.path for item in files_to_write]
    descriptor, filelist_name = tempfile.mkstemp(prefix='hd-backup-filelist-', suffix='.txt')
    with os.fdopen(descriptor, 'w') as filelist:
        for name in names:
            filelist.write(f'{name.lstrip('/')}\0')

    return filelist_name, symlinks_to_write, files_to_write


def run_mt(target, args, description):
    result = subprocess.run(['mt-st', '-f', target] + args, capture_output=True, text=True)
    if result.returncode != 0:
        fail(f'Could not {description}: mt-st error: {result.stderr}')


def write_begin_tape(target, tarball_index):
    run_mt(target, ['setblk', str(TAPE_BLOCK_SIZE)], 'set blocksize')
    run_mt(target, ['compression', '1'], 'enable compression')

    printc(f'Started tape activity at {datetime.datetime.now().isoformat()}.', Fore.MAGENTA)

    # Skip the tarballs that are on the tape already. Every tarball is one file on the tape.
    if tarball_index > 0:
        run_mt(target, ['fsf', str(tarball_index)], 'advance tape to correct file record')


def write_finalize_tape(target):
    # Wait 5 seconds to assure all buffers are emptied.
    time.sleep(5)

    result = subprocess.run(['mt-st', '-f', target, 'rewind'], capture_output=True, text=True)
    if result.returncode != 0:
        error(f'Could not rewind tape: mt-st error: {result.stderr}')

    printc(f'Finished tape activity at {datetime.datetime.now().isoformat()}.', Fore.MAGENTA)


def parse_tar_output(lines, returncode):
    bytes_written = 0
    full = False
    problems = []
    changed = []
    broken_pipes = []

    for line in lines:
        if 'Total bytes written' in line:
            match = re.search(r"[0-9]+", line)
            if match:
                bytes_written = int(match.group())
        elif 'No space left on device' in line:
            full = True
        elif re.search(r'Wrote only [0-9]+ of [0-9]+ bytes', line):
            # A file system that runs full takes part of a record, and only refuses the next write. tar stops at the
            # short write, without a "No space left on device".
            full = True
        elif 'Broken pipe' in line:
            broken_pipes.append(line)
        elif 'file changed as we read it' in line:
            changed.append(line)
        elif 'Error is not recoverable' in line or 'Exiting with failure status' in line:
            # The closing words of tar after an error. The error itself is on another line.
            pass
        elif line.strip() != '':
            problems.append(line)

    if full:
        # When the carrier runs full, the programs in the tape pipeline stop on a broken pipe, and all of them exit
        # with a failure status.
        failed = len(problems) > 0
    elif len(changed) > 0:
        # tar exits with status 1 when a file changed while it was read. The file is in the tarball, so that is a
        # warning.
        failed = len(problems) > 0 or len(broken_pipes) > 0 or returncode not in (0, 1)
    else:
        failed = len(problems) > 0 or len(broken_pipes) > 0 or returncode != 0

    return TarResult(bytes_written, full, changed, failed)


def write_tar(filelist_name, target, tarball_index, is_tape):
    tar = (f'tar --no-recursion --hard-dereference -H pax -b {TAR_BLOCKING_FACTOR} --null --verbatim-files-from '
           f'-C / -T {shlex.quote(filelist_name)}')
    mbuffer_log_name = None
    if is_tape:
        # Every write has an mbuffer log of its own. It is removed after a write that worked.
        descriptor, mbuffer_log_name = tempfile.mkstemp(prefix='hd-backup-mbuffer-', suffix='.log')
        os.close(descriptor)

        # blockwrite reports the bytes that are on the tape. The totals of tar would also count what is still in the
        # buffer of mbuffer when the tape runs full.
        command = (f'{tar} -cf - '
                   f'| mbuffer -m 8G -P 50 -q -l {shlex.quote(mbuffer_log_name)} '
                   f'| blockwrite {shlex.quote(target)}')
    else:
        filename = f'{target}/backup-{tarball_index}.tar'
        command = f'{tar} -cf {shlex.quote(filename)} --totals'

    # With pipefail, a failure anywhere in the tape pipeline shows in the exit status.
    process = subprocess.run(['bash', '-o', 'pipefail', '-c', command], capture_output=True, text=True)
    lines = process.stdout.split('\n') + process.stderr.split('\n')

    result = parse_tar_output(lines, process.returncode)

    # On a hard drive, the size of the tarball is what is on the carrier. The totals of tar leave out a record that
    # was only written in part when the drive ran full.
    if not is_tape and os.path.exists(filename):
        result = result._replace(bytes_written=os.path.getsize(filename))

    if result.failed:
        for line in lines:
            printc(line, Fore.RED)
        if mbuffer_log_name is not None:
            printc(f'The log of mbuffer is in {mbuffer_log_name}.', Fore.RED)
        fail(f'Writing the tarball failed (exit status {process.returncode}). The database is not changed.')

    if mbuffer_log_name is not None:
        os.remove(mbuffer_log_name)

    for line in lines:
        if 'Total bytes written' in line:
            printc(line, Fore.GREEN)
        elif result.full and ('No space left on device' in line or 'Wrote only' in line):
            # Why the carrier counts as full.
            printc(line, Fore.YELLOW)

    for line in result.changed:
        printc(f'WARNING: {line}', Fore.YELLOW)

    printc(f'bw = {result.bytes_written} f = {result.full}', Fore.CYAN)

    return result.bytes_written, result.full


def write_determine_written(bytes_written, full, symlinks_to_write, files_to_write, deletelist_tar_size):
    if full:
        # An item is on the carrier when it ends within the bytes that were written. tar writes the items in the order
        # of the file list: the delete list, the symlinks, then the files.
        symlinks_written = []
        files_written = []
        position = deletelist_tar_size

        for item in symlinks_to_write:
            position += item.tar_size
            if position > bytes_written:
                break
            symlinks_written.append(item)

        if len(symlinks_written) == len(symlinks_to_write):
            for item in files_to_write:
                position += item.tar_size
                if position > bytes_written:
                    break
                files_written.append(item)
    else:
        symlinks_written = symlinks_to_write
        files_written = files_to_write

    total_size = sum(item.size for item in files_written)

    overhead = bytes_written - total_size

    printc(f'overhead = {overhead}, total size = {total_size}', Fore.CYAN)

    if overhead < 0:
        printc("BUG: Negative overhead detected. This should not happen.", Fore.RED)

    return symlinks_written, files_written, overhead, total_size


def write_update_db(db, carrier_number, tarball_index, total_size, overhead, symlinks_written, files_written, full):
    cursor = db.execute('''
        INSERT INTO tarballs(carrier_number, idx, size, files, symlinks, overhead, written)
        VALUES(?, ?, ?, ?, ?, ?, ?)
    ''', (carrier_number, tarball_index, total_size, len(files_written), len(symlinks_written), overhead,
          int(time.time())))

    tarball_number = cursor.lastrowid

    for kind, items in ((SYMLINK, symlinks_written), (FILE, files_written)):
        for item in items:
            db.execute(f'INSERT INTO {kind.tarball_links}({kind.number}, tarball_number) VALUES(?, ?)',
                       (item.number, tarball_number))

    if full:
        db.execute('UPDATE carrier SET full=1 WHERE number=?', (carrier_number,))

    db.commit()


def write_target(db, backup_name, target, is_tape):
    printc(f'Started write at {datetime.datetime.now().isoformat()}.', Fore.MAGENTA)

    backup_number, fileset_number, carrier_number, tarball_index = write_prepare(db, backup_name, target)

    # The delete list and the file list are only needed while tar runs. They are removed in any case.
    temp_files = []
    try:
        deletelist_name, deletelist_size = write_create_deletelist(db, fileset_number, backup_number)
        temp_files.append(deletelist_name)
        deletelist_tar_size = tar_item_size(deletelist_name, os.lstat(deletelist_name), deletelist_size)

        filelist_name, symlinks_to_write, files_to_write = write_create_filelist(db, fileset_number, backup_number,
                                                                                 deletelist_name)
        temp_files.append(filelist_name)

        # On tape, set the blocksize and compression and skip to the end of the last tarball first, and rewind the
        # tape afterwards, also when the write failed.
        if is_tape:
            write_begin_tape(target, tarball_index)
            try:
                bytes_written, full = write_tar(filelist_name, target, tarball_index, is_tape)
            finally:
                write_finalize_tape(target)
        else:
            bytes_written, full = write_tar(filelist_name, target, tarball_index, is_tape)
    finally:
        for name in temp_files:
            os.remove(name)

    symlinks_written, files_written, overhead, total_size = write_determine_written(
        bytes_written, full, symlinks_to_write, files_to_write, deletelist_tar_size)

    write_update_db(db, carrier_number, tarball_index, total_size, overhead, symlinks_written, files_written, full)

    printc(f'Finished write at {datetime.datetime.now().isoformat()}.', Fore.MAGENTA)
    printc(f'Tarball written. {len(symlinks_written)} symlinks and {len(files_written)} files backed up.', Fore.GREEN)

