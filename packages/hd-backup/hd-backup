# Set when a command reported an error but went on, so the tool exits with a failure status at the end.
had_errors = False


def printc(text, color):
    print(f'{color}{text}')


def error(text):
    global had_errors
    had_errors = True
    printc(text, Fore.RED)


def fail(text):
    printc(text, Fore.RED)
    sys.exit(1)


def print_table(rows):
    print(tabulate.tabulate(rows, headers="keys", tablefmt="github"))


def format_time(timestamp):
    return time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(timestamp))


def file_sha1(path):
    # The SHA-1 of a regular file, or '' for anything else, like a directory.
    if not os.path.isfile(path):
        return ''

    digest = hashlib.sha1()
    with open(path, 'rb') as file:
        while True:
            block = file.read(4096)
            if not block:
                break
            digest.update(block)
    return digest.hexdigest()


def is_excluded(path, excludes):
    for exclude in excludes:
        if path.startswith(exclude):
            return True
    return False


def tar_blocks(size):
    # Size rounded up to whole 512 byte tar blocks.
    return (size + 511) // 512 * 512


# Limits of the ustar header. A value over its limit goes in a record of the pax extended header.
USTAR_NAME_SIZE = 100
USTAR_MAX_SIZE = 0o77777777777
USTAR_MAX_ID = 0o7777777
USTAR_OWNER_NAME_SIZE = 32


def pax_record_size(key, value_size):
    # A pax record is "<length> <key>=<value>\n". The length counts the whole record, its own digits too.
    rest = len(key) + value_size + 3
    digits = 1
    while len(str(rest + digits)) != digits:
        digits += 1
    return rest + digits


def pax_time_size(key, time_ns):
    # tar writes a time as seconds with up to 9 decimals, without trailing zeros. atime and ctime can change between
    # this estimate and the moment tar reads them, so the longest form is counted: all 9 decimals.
    seconds = len(str(abs(time_ns) // 1000000000))
    if time_ns < 0:
        seconds += 1
    return pax_record_size(key, seconds + 1 + 9)


def owner_name_size(name):
    # The size of a pax record for a user or group name, when it does not fit in the ustar header.
    if name is None or (len(name) < USTAR_OWNER_NAME_SIZE and name.isascii()):
        return 0
    return pax_record_size('uname', len(name.encode()))


@functools.cache
def user_name(uid):
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return None


@functools.cache
def group_name(gid):
    try:
        return grp.getgrgid(gid).gr_name
    except KeyError:
        return None


def pax_data_size(path, status, size, target=''):
    # The data of the pax extended header that tar writes for an item, with the options of write_tar. tar always
    # writes atime and ctime, and mtime when it is not a whole second; it is counted always. The other records are
    # only there when a value does not fit in the ustar header.
    data = pax_time_size('mtime', status.st_mtime_ns)
    data += pax_time_size('atime', status.st_atime_ns)
    data += pax_time_size('ctime', status.st_ctime_ns)

    # The name in the tarball is relative to /. A directory has a / at the end.
    name = path.lstrip('/')
    if stat.S_ISDIR(status.st_mode):
        name += '/'
    if len(name.encode()) > USTAR_NAME_SIZE or not name.isascii():
        data += pax_record_size('path', len(name.encode()))

    if len(target.encode()) > USTAR_NAME_SIZE or not target.isascii():
        data += pax_record_size('linkpath', len(target.encode()))

    if size > USTAR_MAX_SIZE:
        data += pax_record_size('size', len(str(size)))

    if status.st_uid > USTAR_MAX_ID:
        data += pax_record_size('uid', len(str(status.st_uid)))
    if status.st_gid > USTAR_MAX_ID:
        data += pax_record_size('gid', len(str(status.st_gid)))

    data += owner_name_size(user_name(status.st_uid))
    data += owner_name_size(group_name(status.st_gid))

    return data


def tar_item_size(path, status, size, target=''):
    # The bytes tar writes for an item: the extended header (a header block and its data), the ustar header block and
    # the contents. status is the lstat of the item, size the size of its contents, target the target of a symlink.
    return 512 + tar_blocks(pax_data_size(path, status, size, target)) + 512 + tar_blocks(size)

