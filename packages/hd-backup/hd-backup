class Kind:
    # Files (directories included) and symlinks are kept in tables of the same shape: a table of records, a table that
    # links them to filesets and a table that links them to tarballs.
    def __init__(self, name):
        self.name = name                                # file or symlink
        self.table = f'{name}s'                         # files or symlinks
        self.number = f'{name}_number'                  # The column with the record number in the link tables.
        self.fileset_links = f'{name}_fileset_links'
        self.tarball_links = f'{name}_tarball_links'


FILE = Kind('file')
SYMLINK = Kind('symlink')
KINDS = (FILE, SYMLINK)


def kind_of(is_symlink):
    if is_symlink:
        return SYMLINK
    else:
        return FILE


SCHEMA = '''
