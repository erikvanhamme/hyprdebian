def add_fileset(db, fileset_name, paths):
    for path in paths:
        if not os.path.isdir(path.removeprefix('^')):
            fail(f"Given path {path} is not an existing directory.")

    if find_fileset(db, fileset_name) is not None:
        fail(f"Fileset with name {fileset_name} is already in the database.")

    db.execute('INSERT INTO filesets(name) VALUES(?)', (fileset_name,))
    db.commit()

    printc(f'Fileset with name {fileset_name} added.', Fore.GREEN)

    add_paths(db, fileset_name, paths)


def add_paths(db, fileset_name, paths):
    fileset_number = find_fileset(db, fileset_name)
    if fileset_number is None:
        fail(f'Fileset with name {fileset_name} is not in the database.')

    for path in paths:
        if not os.path.isdir(path.removeprefix('^')):
            fail(f'Given path {path} is not an existing directory.')

    # Paths are stored absolute. An exclusion keeps its ^ in front.
    for path in paths:
        absolute_path = os.path.abspath(path.removeprefix('^'))
        if path.startswith('^'):
            absolute_path = '^' + absolute_path

        db.execute('INSERT INTO paths(fileset_number, path) VALUES(?, ?)', (fileset_number, absolute_path))
        db.commit()

        printc(f'Path {path} ({absolute_path}) added to fileset {fileset_name}.', Fore.GREEN)

    update_filesets(db, [fileset_name])


def update_filesets(db, fileset_names):
    for fileset_name in fileset_names:
        fileset_number = find_fileset(db, fileset_name)
        if fileset_number is None:
            error(f'Fileset with name {fileset_name} is not in the database.')
            continue

        printc(f"Updating fileset {fileset_name}.", Fore.MAGENTA)

        scan = []
        excludes = []
        for row in db.execute('SELECT path FROM paths WHERE fileset_number=?', (fileset_number,)).fetchall():
            if row['path'].startswith('^'):
                excludes.append(row['path'].removeprefix('^'))
            else:
                scan.append(row['path'])

        for path in scan:
            update_fileset_path(db, fileset_number, fileset_name, path, excludes)

        printc(f"Fileset {fileset_name} updated.", Fore.GREEN)


def add_backup(db, backup_name, fileset_name):
    fileset_number = find_fileset(db, fileset_name)
    if fileset_number is None:
        fail(f"Fileset with name {fileset_name} is not in the database.")

    if find_backup(db, backup_name) is not None:
        fail(f"Backup with name {backup_name} is already in the database.")

    db.execute('INSERT INTO backups(name, fileset_number) VALUES(?, ?)', (backup_name, fileset_number))
    db.commit()

    printc('Backup added.', Fore.GREEN)


def rename_backup(db, old_name, new_name):
    backup = find_backup(db, old_name)
    if backup is None:
        fail(f'Backup with name {old_name} is not in the database.')

    if find_backup(db, new_name) is not None:
        fail(f'Backup with name {new_name} is already in the database.')

    db.execute('UPDATE backups SET name=? WHERE number=?', (new_name, backup['number']))
    db.commit()

    printc('Backup name updated.', Fore.GREEN)


def add_carrier(db, backup_name, carrier_labels):
    backup = find_backup(db, backup_name)
    if backup is None:
        fail(f"Backup with name {backup_name} is not in the database.")

    # Carriers are numbered in the order they are added.
    last_index = get_first_value(db, 'SELECT MAX(idx) FROM carrier WHERE backup_number=?', (backup['number'],))
    if last_index is None:
        carrier_index = 0
    else:
        carrier_index = last_index + 1

    added = 0
    for label in carrier_labels:
        if find_carrier(db, label) is not None:
            error(f"carrier with label {label} is already in the database.")
            continue

        db.execute('INSERT INTO carrier(backup_number, label, full, idx) VALUES(?, ?, 0, ?)',
                   (backup['number'], label, carrier_index))
        db.commit()

        carrier_index += 1
        added += 1

    printc(f"Added {added} carrier to backup set {backup_name}.", Fore.GREEN)


def write(db, backup_name, mountpoint):
    write_target(db, backup_name, mountpoint, False)


def write_tape(db, backup_name, device):
    write_target(db, backup_name, device, True)


def wildcard_regex(pattern):
    # Only * is a wildcard, the rest of the pattern is matched literally.
    return '.*'.join(re.escape(part) for part in pattern.split('*'))


def print_backup_summary(db, backup):
    number, fileset_number, name = backup

    printc(f"Backup set {name}:", Fore.BLUE)

    fileset_sizes = db.execute('''
        SELECT size
        FROM files
            JOIN file_fileset_links ON file_fileset_links.file_number=files.number
        WHERE fileset_number=? AND on_disk=1
    ''', (fileset_number,)).fetchall()

    files_not_written = items_not_in_backup(db, FILE, 'files.size', fileset_number, number)
    if len(files_not_written) == 0:
        printc("  Status: All files of the fileset are on carrier in the backup set.", Fore.GREEN)
    else:
        unwritten_size = sum(row['size'] for row in files_not_written)
        printc(f"  Status: There are {len(files_not_written)} files not on carrier in the backup set for a size "
               f"of {unwritten_size} bytes.", Fore.RED)

    symlinks_not_written = len(items_not_in_backup(db, SYMLINK, 'symlinks.number', fileset_number, number))
    if symlinks_not_written == 0:
        printc("  Status: All symlinks of the fileset are on carrier in the backup set.", Fore.GREEN)
    else:
        printc(f"  Status: There are {symlinks_not_written} symlinks not on carrier in the backup set.", Fore.RED)

    fileset_name = get_first_value(db, 'SELECT name FROM filesets WHERE number=?', (fileset_number,))
    fileset_size = sum(row['size'] for row in fileset_sizes)
    printc(f"  Fileset {fileset_name} stores {len(fileset_sizes)} files for a total size of {fileset_size} bytes:",
           Fore.CYAN)

    for row in db.execute('SELECT path FROM paths WHERE fileset_number=?', (fileset_number,)):
        printc(f"    Path {row['path']}", Fore.CYAN)

    carriers = db.execute('SELECT number, label, full, idx FROM carrier WHERE backup_number=? ORDER BY idx ASC',
                          (number,)).fetchall()

    for carrier_number, label, full, index in carriers:
        printc(f"  carrier {index} labeled {label} [{'FULL' if full == 1 else 'NOT FULL'}]:", Fore.MAGENTA)

        tarballs = db.execute('''
            SELECT idx, size, files, symlinks, overhead, written
            FROM tarballs
            WHERE carrier_number=?
            ORDER BY idx ASC
        ''', (carrier_number,))

        for tarball_index, size, files, symlinks, overhead, written in tarballs:
            printc(f"    Tarball {tarball_index} stores {files} files and {symlinks} symlinks in {size} bytes with "
                   f"{overhead} bytes of overhead. (Written {format_time(written)})", Fore.YELLOW)


def summary(db, backup_names):
    # Without names, all backups. A name can contain * as a wildcard.
    patterns = [wildcard_regex(name) for name in backup_names]

    backups = db.execute('SELECT number, fileset_number, name FROM backups ORDER BY name ASC').fetchall()
    for backup in backups:
        if len(patterns) == 0 or any(re.fullmatch(pattern, backup['name']) for pattern in patterns):
            print_backup_summary(db, backup)


