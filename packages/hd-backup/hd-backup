def generate_usage_text(commands):
    lines = [f"{sys.argv[0]} command <args...>\n\nCommands:"]
    for command in commands:
        line = f"  {command.name}"
        for argument in command.arguments:
            if argument.nargs is None:
                line += f" {argument.name}"
            else:
                line += f" <{argument.name}...>"
        line += f"\n    - {command.help}"
        lines.append(line)
    return "\n".join(lines)


def build_parser(commands):
    parser = argparse.ArgumentParser(description="Backup Management CLI", usage=generate_usage_text(commands))
    subparsers = parser.add_subparsers(dest="command", required=True)

    for command in commands:
        subparser = subparsers.add_parser(command.name, help=command.help)
        for argument in command.arguments:
            subparser.add_argument(argument.name, help=argument.help, nargs=argument.nargs)
        subparser.set_defaults(command_info=command)

    return parser


def main():
    colorama.init(autoreset=True)

    printc(f"Backuptool [tool V{TOOL_VERSION}, database V{DB_VERSION}]", Fore.CYAN)
    printc("  Copyright 2018-2026 Erik Van Hamme (erik.vanhamme@gmail.com)", Fore.CYAN)

    args = build_parser(COMMANDS).parse_args()
    command = args.command_info

    db_path = os.path.expanduser(DB_PATH)
    os.makedirs(os.path.dirname(db_path), exist_ok=True)

    db = None
    try:
        db = open_db(db_path)
        command.function(db, *[getattr(args, argument.name) for argument in command.arguments])
    except sqlite3.Error as e:
        fail(f"SQL exception: {e}")
    finally:
        if db is not None:
            db.close()

    # A command that reported an error, but went on with the rest of its work, still fails.
    if had_errors:
        sys.exit(1)


if __name__ == '__main__':
    main()
