#!/usr/bin/env bash
# postinst of hd-agent: stores the default settings in the key hd-agent of
# /etc/hyprdebian/config.json when there are none, generates the token of this system when there
# is none, and enables and starts hd-agent.timer.
#
# hd-agent replaces hd-report, which the owner switches the systems from by hand. When hd-report
# was installed before, it takes over what hd-report leaves behind on its removal: the token, so
# the dashboard keeps accepting the reports, the key hd-report of the settings, and the enabled
# state of hd-report.timer.
set -euo pipefail

CONFIG_FILE="/etc/hyprdebian/config.json"
CONFIG_KEY="hd-agent"
DEFAULTS_FILE="/usr/share/hd-agent/defaults.json"
TOKEN_DIR="/etc/hyprdebian/hd-agent"
TOKEN_FILE="${TOKEN_DIR}/token"
UNIT="hd-agent.timer"
OLD_CONFIG_KEY="hd-report"
OLD_TOKEN_DIR="/etc/hyprdebian/hd-report"
OLD_TOKEN_FILE="${OLD_TOKEN_DIR}/token"
OLD_UNIT="hd-report.timer"

# configure is the only action that installs the package; the abort-* actions undo a failed
# upgrade or removal.
if [[ "${1:-}" != "configure" ]]; then
    exit 0
fi

has_settings() {
    python3 - "${CONFIG_FILE}" "$1" <<'PYTHON'
import json, os, sys
config_file, config_key = sys.argv[1:]
config = json.load(open(config_file)) if os.path.exists(config_file) else {}
sys.exit(0 if isinstance(config, dict) and config_key in config else 1)
PYTHON
}

print_settings() {
    python3 - "${CONFIG_FILE}" "$1" <<'PYTHON'
import json, sys
config_file, config_key = sys.argv[1:]
print(json.dumps(json.load(open(config_file))[config_key]))
PYTHON
}

if has_settings "${CONFIG_KEY}"; then
    echo "Keeping the agent settings in ${CONFIG_FILE}."
elif has_settings "${OLD_CONFIG_KEY}"; then
    echo "Moving the settings of hd-report to the key ${CONFIG_KEY} in ${CONFIG_FILE}."
    print_settings "${OLD_CONFIG_KEY}" | hd-config-update "${CONFIG_KEY}"
    hd-config-remove "${OLD_CONFIG_KEY}"
else
    echo "Storing the default agent settings in ${CONFIG_FILE}."
    hd-config-update "${CONFIG_KEY}" < "${DEFAULTS_FILE}"
fi

# The dashboard only accepts the first token it sees for a host name, so an existing token is
# never replaced; a purge keeps it too. The token of hd-report is the one the dashboard knows.
install -d -m 0700 "${TOKEN_DIR}"
if [[ -s "${TOKEN_FILE}" ]]; then
    echo "Keeping the token in ${TOKEN_FILE}."
elif [[ -s "${OLD_TOKEN_FILE}" ]]; then
    echo "Moving the token of hd-report to ${TOKEN_FILE}..."
    mv "${OLD_TOKEN_FILE}" "${TOKEN_FILE}"
    rmdir --ignore-fail-on-non-empty "${OLD_TOKEN_DIR}"
else
    echo "Generating the token in ${TOKEN_FILE}..."
    (umask 077 && python3 -c 'import secrets; print(secrets.token_hex(32))' > "${TOKEN_FILE}")
fi
chmod 0600 "${TOKEN_FILE}"

# The same steps as the ones debhelper adds for a timer: the timer is enabled on the first
# installation, by its preset, and keeps the enabled state the admin gave it over upgrades and
# removals. The unmask undoes the mask of a removal, see the postrm.
#
# On the first installation over hd-report, whose removal masked hd-report.timer and kept its
# state, the timer is enabled only when hd-report.timer was. The state of hd-report.timer is
# purged then, as its unit file is gone with hd-report.
deb-systemd-helper unmask "${UNIT}" > /dev/null || true
old_unit_disabled=0
if [[ -z "${2:-}" ]] && deb-systemd-helper --quiet debian-installed "${OLD_UNIT}"; then
    if ! deb-systemd-helper --quiet was-enabled "${OLD_UNIT}"; then
        old_unit_disabled=1
    fi
    echo "Taking over the enabled state of ${OLD_UNIT}."
    deb-systemd-helper purge "${OLD_UNIT}" > /dev/null || true
    deb-systemd-helper unmask "${OLD_UNIT}" > /dev/null || true
fi
if [[ "${old_unit_disabled}" == 0 ]] && deb-systemd-helper --quiet was-enabled "${UNIT}"; then
    deb-systemd-helper enable "${UNIT}" > /dev/null || true
else
    deb-systemd-helper update-state "${UNIT}" > /dev/null || true
fi

if [[ -z "${DPKG_ROOT:-}" && -d /run/systemd/system ]]; then
    systemctl --system daemon-reload
    deb-systemd-invoke restart "${UNIT}"
fi
