#!/usr/bin/env bash
# prerm of hd-agent: stops hd-agent.timer and a report that is being sent when the package is
# removed.
set -euo pipefail

if [[ "${1:-}" != "remove" ]]; then
    exit 0
fi

if [[ -z "${DPKG_ROOT:-}" && -d /run/systemd/system ]]; then
    deb-systemd-invoke stop hd-agent.timer hd-agent.service > /dev/null || true
fi
