#!/usr/bin/python3
"""postinst of hd-secboot: generates the Secure Boot keys in /etc/hyprdebian/secboot when they are
not there yet. Existing keys are never replaced, so an upgrade or a reinstall keeps keys that may
already be enrolled in the firmware.

The keys are the platform key (PK), the key exchange key (KEK) and the signature database key
(db), all with the same owner GUID (GUID.txt). Each has its private key (.key), its certificate
as PEM (.crt) for sbsign and as DER (.cer) for the key menus of firmware setups, an EFI signature
list (.esl) and a signed update (.auth) for efi-updatevar or KeyTool: PK signs its own and that
of KEK, KEK signs that of db. EFI files are signed with the db key. RSA 2048 is the key size that
the UEFI spec requires every firmware to support.
"""

import os
import shutil
import socket
import subprocess
import sys
import uuid

KEY_DIR = "/etc/hyprdebian/secboot"
TMP_DIR = KEY_DIR + ".tmp"
NAMES = ["PK", "KEK", "db"]
# Each key is signed by the one named here: PK by itself, KEK by PK, db by KEK.
SIGNER = {"PK": "PK", "KEK": "PK", "db": "KEK"}
DAYS = 3650


def run(*command):
    subprocess.run(command, check=True)


def hostname():
    try:
        with open("/etc/hostname", encoding="utf-8") as f:
            name = f.read().strip()
    except OSError:
        name = ""
    if name == "":
        name = socket.gethostname()
    return name


def generate(tmp):
    guid = str(uuid.uuid4())
    with open(os.path.join(tmp, "GUID.txt"), "w", encoding="utf-8") as f:
        f.write(guid + "\n")

    host = hostname()
    for name in NAMES:
        path = os.path.join(tmp, name)
        run("openssl", "req", "-new", "-x509", "-newkey", "rsa:2048", "-nodes", "-sha256",
            "-days", str(DAYS), "-subj", f"/CN=HyprDebian {host} Secure Boot {name}/",
            "-keyout", f"{path}.key", "-out", f"{path}.crt")
        run("openssl", "x509", "-in", f"{path}.crt", "-outform", "DER", "-out", f"{path}.cer")
        run("cert-to-efi-sig-list", "-g", guid, f"{path}.crt", f"{path}.esl")

    for name in NAMES:
        path = os.path.join(tmp, name)
        signer = os.path.join(tmp, SIGNER[name])
        run("sign-efi-sig-list", "-g", guid, "-k", f"{signer}.key", "-c", f"{signer}.crt",
            name, f"{path}.esl", f"{path}.auth")


def main():
    # configure is the only action that installs the package; the abort-* actions undo a
    # failed upgrade or removal.
    if len(sys.argv) < 2 or sys.argv[1] != "configure":
        return

    if os.path.exists(KEY_DIR):
        print(f"Keeping the Secure Boot keys in {KEY_DIR}.")
        return

    # The keys are made in a directory of their own that only root can enter, and moved into
    # place when they are all there, so a failure never leaves half a set of keys behind.
    print(f"Generating the Secure Boot keys in {KEY_DIR}...", flush=True)
    shutil.rmtree(TMP_DIR, ignore_errors=True)
    os.makedirs(os.path.dirname(KEY_DIR), mode=0o755, exist_ok=True)
    os.mkdir(TMP_DIR, mode=0o700)
    old_umask = os.umask(0o077)
    try:
        generate(TMP_DIR)
    except (OSError, subprocess.CalledProcessError) as e:
        shutil.rmtree(TMP_DIR, ignore_errors=True)
        print(f"Error: Cannot generate the Secure Boot keys: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        os.umask(old_umask)
    for name in os.listdir(TMP_DIR):
        os.chmod(os.path.join(TMP_DIR, name), 0o600)
    os.rename(TMP_DIR, KEY_DIR)


if __name__ == "__main__":
    main()
