-- The HyprDebian theme {{ name }}, written by hd-theme --apply from /etc/hyprdebian/config.json.
-- Do not change this file: hd-theme --apply writes it again. hyprland.lua requires it; settings
-- after that take the place of these.
hl.config({
    general = {
        -- Every window gets gaps_in around it, so windows are {{ theme["gap"] }} apart.
        gaps_in  = {{ gaps_in }},
        gaps_out = {{ theme["gap"] }},

        border_size = {{ theme["border"] }},

        col = {
            active_border   = "rgba({{ theme["highlight"] | hex }}ff)",
            inactive_border = "rgba({{ theme["normal"] | hex }}ff)",
        },
    },

    decoration = {
        rounding = {{ theme["radius"] }},
    },
})
