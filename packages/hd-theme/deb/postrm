#!/bin/sh
# postrm of hd-theme: a removal removes the cards of the themes in /var/cache/hd-theme. A purge
# also removes the key hd-theme from /etc/hyprdebian/config.json. The themes that were added stay
# in /etc/hyprdebian/themes, and the theme files stay in the home directories. Written for sh, as
# python3 may be gone by then.
set -e

case "$1" in
    remove | purge) ;;
    *) exit 0 ;;
esac

rm -rf /var/cache/hd-theme

if [ "$1" = "purge" ] && [ -x /usr/sbin/hd-config-remove ]; then
    hd-config-remove hd-theme
fi
