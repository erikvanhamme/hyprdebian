#!/usr/bin/python3
"""postinst of hd-theme: renders the cards of the themes, and selects the theme default when no
theme is selected yet.

It does not write the theme files in the home directories: each user runs hd-theme --apply for
that.
"""

import json
import subprocess
import sys

CONFIG_FILE = "/etc/hyprdebian/config.json"
CONFIG_KEY = "hd-theme"
DEFAULT_THEME = "default"


def theme_selected():
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            config = json.load(f)
    except (FileNotFoundError, ValueError):
        return False
    if not isinstance(config, dict) or not isinstance(config.get(CONFIG_KEY), dict):
        return False
    return "name" in config[CONFIG_KEY]


def main():
    if len(sys.argv) < 2 or sys.argv[1] != "configure":
        return
    subprocess.run(["hd-theme", "--cards"], check=True)
    if not theme_selected():
        subprocess.run(["hd-theme", "--select", DEFAULT_THEME], check=True)


if __name__ == "__main__":
    main()
