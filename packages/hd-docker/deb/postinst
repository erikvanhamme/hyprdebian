#!/usr/bin/python3
"""postinst of hd-docker: puts the Docker rules of /usr/share/hd-docker/docker-ufw.rules in
/etc/ufw/after.rules, reloads ufw when they changed and it is active, and on the first
installation restarts Docker, so it takes the addresses of /etc/docker/daemon.json.

ufw keeps /etc/ufw/after.rules up to date with ucf, so the file belongs to ufw and hd-docker does
not ship it. The rules go in a block between the lines "# BEGIN DOCKER UFW FIX" and
"# END DOCKER UFW FIX", at the end of the file. The postinst replaces that block on every
installation and upgrade and keeps the rest of the file; the postrm of a removal takes it out.

docker.io starts Docker before hd-docker is configured, with the default addresses. The restart
happens on the first installation only: later ones would stop the containers that run.
"""

import os
import subprocess
import sys
import tempfile

AFTER_RULES = "/etc/ufw/after.rules"
DOCKER_RULES = "/usr/share/hd-docker/docker-ufw.rules"
BEGIN = "# BEGIN DOCKER UFW FIX"
END = "# END DOCKER UFW FIX"


def without_block(lines):
    """The lines without the Docker block, and without the empty lines before it."""
    kept = []
    inside = False
    for line in lines:
        if line.strip() == BEGIN:
            inside = True
            while kept and kept[-1].strip() == "":
                kept.pop()
            continue
        if inside:
            if line.strip() == END:
                inside = False
            continue
        kept.append(line)
    return kept


def write(path, text):
    """Replaces the file in one step, with the mode of the old one."""
    mode = os.stat(path).st_mode & 0o7777
    fd, temp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".hd-docker.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(temp, mode)
    os.replace(temp, path)


def update_after_rules():
    """Puts the Docker block at the end of after.rules. True if the file changed."""
    with open(AFTER_RULES) as f:
        old = f.read()
    with open(DOCKER_RULES) as f:
        block = f.read()
    kept = "".join(without_block(old.splitlines(keepends=True)))
    if kept != "" and not kept.endswith("\n"):
        kept += "\n"
    new = kept + "\n" + block
    if new == old:
        return False
    write(AFTER_RULES, new)
    print(f"Wrote the Docker rules in {AFTER_RULES}.")
    return True


def ufw_active():
    status = subprocess.run(["ufw", "status"], capture_output=True, text=True).stdout
    return status.startswith("Status: active")


def main():
    # configure is the only action that installs the package; the abort-* actions undo a
    # failed upgrade or removal.
    if len(sys.argv) < 2 or sys.argv[1] != "configure":
        return

    # The version that was configured before, empty on the first installation.
    previous = sys.argv[2] if len(sys.argv) > 2 else ""

    if update_after_rules():
        if ufw_active():
            subprocess.run(["ufw", "reload"], check=True)
    if not os.path.isdir("/run/systemd/system"):
        return
    if previous == "":
        subprocess.run(["systemctl", "try-restart", "docker.service"], check=True)


if __name__ == "__main__":
    main()
