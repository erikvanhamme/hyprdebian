#!/usr/bin/env bash
# postinst of the hyprdebian-bootloader-<frontend> packages: writes the
# bootloader, assets.efi and the UKIs to every ESP when the package is
# installed or upgraded, so that the ESPs hold the bootloader of this package
# without waiting for the next kernel.
#
# As in the kernel hooks, a missing or unreadable ESP fails update-esps.sh,
# and with it the installation: the package stays unconfigured until the ESP
# is back and "dpkg --configure -a" runs this again.
set -euo pipefail

HELPER=/usr/lib/hyprdebian/bootloader/update-esps.sh

# configure is the only action that installs the package; the abort-*
# actions undo a failed upgrade or removal and leave the ESPs alone.
if [[ "${1:-}" != "configure" ]]; then
    exit 0
fi

exec "${HELPER}"
